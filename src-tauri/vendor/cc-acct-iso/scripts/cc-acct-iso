#!/usr/bin/env bash
# cc-acct-iso —— Claude Code 多账号「并发隔离 + 实时共享」通用管线
#   隔离:每个账号一个 CLAUDE_CONFIG_DIR,各自 .credentials.json/.claude.json → 可同时跑不互踢
#   共享:skills/projects(memory+history)/settings/plugins… 全部 symlink 回同一共享库 → 实时同步
# 参数化,无硬编码;动文件的命令默认 dry-run,--apply 才落盘,自动备份 + 可 rollback。
# 绝不读取/回显/传输凭据内容,只搬/链/stat。
set -euo pipefail
umask 077   # 我们创建的一切(账号目录/备份/manifest/种下的配置)默认只有本人可读

SELF="${0##*/}"
# 解析软链:装到 ~/.local/bin 后 cc-acct-iso 是软链回 scripts/;不解析会按软链所在目录
# (~/.local/bin)找 lib.sh 而失败。readlink -f 对非软链也返回真实路径,故一律安全。
_SELF_PATH="$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
_LIBDIR="$(cd -- "$(dirname -- "$_SELF_PATH")" && pwd)"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib.sh
. "$_LIBDIR/lib.sh"

APPLY=0

usage() {
  cat <<EOF
${_c_bold}cc-acct-iso${_c_reset} —— Claude Code 多账号:并发隔离 + 实时共享

用法:$SELF <命令> [参数] [--apply]

命令
  init <默认账号名> [--default-in-place]   初始化:共享库变纯共享,默认账号迁进 ACCTS_DIR
  add <名> [--from-credentials <文件>]     新增账号(建 config-dir + 共享 symlink)
          [--seed-claude-json <目录|文件>] 种一份 .claude.json(剥掉 oauthAccount)
          [--email <邮箱>] [--default]
  rm <名> [--force]                        删账号(只删其 config-dir,不动共享库)
  list [--json]                            列账号(邮箱现读自各自 .claude.json)
  which [<config-dir>]                     某 config-dir / 当前 \$CLAUDE_CONFIG_DIR 属于哪个账号
  verify [<名>...] [--no-probe]            自检:结构 + 隔离 + 共享(不登录;会写一个自动清理的探针)
  sync                                     幂等补链/修断链/修权限/刷新 manifest 邮箱
                                           (隔离项若还是软链 → 私有化,不再删)
  isolate <项名>                           把某共享项变成每账号私有实体(共享库那份留作模板)
  rollback [<备份时间戳>|latest]           从备份还原(同样 dry-run 默认)
  run <名> [-- <启动器参数>]               用该账号起 claude(唯一登录入口)
  shellinit                                打印可 source 的 rc 片段(export + <名>cc 函数)
  config                                   打印当前生效配置
  help                                     本帮助

选项
  --apply              真正落盘(不加 = dry-run 只打印计划);可放命令前或命令后
  --shared-store <p>   覆盖 SHARED_STORE
  --accts-dir <p>      覆盖 ACCTS_DIR
  --launcher <cmd>     覆盖 LAUNCHER

配置文件:\${CC_ACCT_ISO_CONFIG:-~/.cc-acct-iso/config}(sourceable KEY=VAL;CLI 选项优先)
manifest(契约 v1):\$ACCTS_DIR/accounts.json —— 本工具写,cc-monitor 读。
EOF
}

# ---------- 通用工具 ----------
to_abs() {
  local p="$1"
  case "$p" in
    /*) ;;
    ~/*) p="$HOME/${p#\~/}" ;;
    *)  p="$PWD/$p" ;;
  esac
  path_sanitize "$p"
}

need_manifest() {
  [ -f "$MANIFEST" ] || die "未初始化(找不到 $MANIFEST)。先跑:$SELF init <默认账号名>"
}

# 账号的 config-dir 是「后续写入目标」,必须落在受控范围内才允许动它
acct_dir_ok() {
  is_under "$1" "$ACCTS_DIR" && return 0
  [ "$1" = "$SHARED_STORE" ] && return 0      # in-place 模式
  return 1
}

plan_links_for() {  # 为某 config-dir 计划全部共享项 symlink(仅计划新建)
  local cfgdir="$1" item n=0
  while IFS= read -r -d '' item; do
    plan_add LINK "$SHARED_STORE/$item" "$cfgdir/$item"
    n=$((n + 1))
  done < <(share_items)
  [ "$n" -gt 0 ] || warn "共享库 $SHARED_STORE 里没有任何可共享的顶层项 —— 该账号将只有隔离项,没有共享。"
}

# ---------- init ----------
cmd_init() {
  local name="" inplace=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --default-in-place) inplace=1; shift ;;
      --apply) APPLY=1; shift ;;
      -h|--help) usage; return 0 ;;
      -*) die "init:未知选项 $1" ;;
      *) [ -z "$name" ] || die "init:多余参数 $1"; name="$1"; shift ;;
    esac
  done
  [ -n "$name" ] || die "用法:$SELF init <默认账号名> [--default-in-place] [--apply]"
  name_check "$name"
  cfg_finalize
  [ -f "$MANIFEST" ] && die "已初始化:$MANIFEST(加账号用 $SELF add)"

  local cfgdir item src email
  plan_init
  MF=()
  plan_add MKDIR "$ACCTS_DIR"

  if [ "$inplace" = 1 ]; then
    cfgdir="$SHARED_STORE"
    warn "--default-in-place(旧 V1 模式):默认账号 config-dir = 共享库本身。"
    warn "  .claude.json 会分裂:裸起读 $LEGACY_HOME_DIR/.claude.json,带 CLAUDE_CONFIG_DIR=$SHARED_STORE 起读 $SHARED_STORE/.claude.json。"
    warn "  cc-monitor 的按会话切号不支持该模式。除非你清楚为何要它,否则请用默认(V2)。"
  else
    cfgdir="$ACCTS_DIR/$name"
    { [ -e "$cfgdir" ] || [ -L "$cfgdir" ]; } && die "目标已存在:$cfgdir"
    plan_add MKDIR "$cfgdir"
    for item in ${ISOLATE_ARR[@]+"${ISOLATE_ARR[@]}"}; do
      src="$(isolate_src "$item")"
      [ -n "$src" ] || continue
      # 隔离项若本身是 symlink(旧的「swap 一个软链」式切号方案),搬过来会让两个账号
      # 指向同一个真实凭据 → 隔离直接失效。必须让用户先解链。
      [ -L "$src" ] && die "隔离项是 symlink,拒绝迁移:$src → $(readlink "$src")
  这多半来自旧的软链式切号方案。请先解链再重来:
    cp --remove-destination \"\$(readlink -f '$src')\" '$src'"
      plan_add MOVE "$src" "$cfgdir/$item"
    done
    plan_links_for "$cfgdir"
    # Z06:从**声明**派生 —— 凡类别为 `secret` 的项迁进来都要 600。
    # 此前只 chmod 了 `.credentials.json`,`.claude.json`(同样含 oauthAccount)搬进来后
    # 保持原模式 ⇒ 与 `--seed-claude-json` 那条路(它确实 chmod 600 了)不一致,
    # 也让 sync 的权限修复第一次跑时必然产生一次改动(不收敛)。收成一处声明后自洽。
    local _sec
    for _sec in $(ni_secrets); do
      plan_add CHMOD 600 "$cfgdir/$_sec"
    done
  fi

  src="$(isolate_src .claude.json)"
  email="$(claude_json_email "$src")"
  mf_add "$name" "$email" "$cfgdir" true
  manifest_render >"$STAGE/manifest.json"
  plan_add MANIFEST

  info "${_c_bold}init${_c_reset}  共享库=$SHARED_STORE  账号库=$ACCTS_DIR  默认账号=$name${email:+ ($email)}"
  plan_commit
  if [ "$APPLY" = 1 ] && [ "$inplace" != 1 ]; then
    info ""
    info "下一步:"
    info "  1) 自检:            $SELF verify"
    info "  2) 装 rc 片段(裸 claude 需要):$SELF shellinit   ${_c_dim}# 打印给你,自己贴进 ~/.bashrc${_c_reset}"
    info "  3) 加第二个账号:    $SELF add <名> [--from-credentials <旧快照>] --apply"
    info "  4) 起:              $SELF run $name"
  fi
}

# ---------- add ----------
cmd_add() {
  local name="" fromcred="" seed="" email="" makedef=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --from-credentials) fromcred="${2-}"; [ -n "$fromcred" ] || die "--from-credentials 需要文件路径"; shift 2 ;;
      --seed-claude-json) seed="${2-}"; [ -n "$seed" ] || die "--seed-claude-json 需要路径"; shift 2 ;;
      --email) email="${2-}"; [ -n "$email" ] || die "--email 需要邮箱"; shift 2 ;;
      --default) makedef=1; shift ;;
      --apply) APPLY=1; shift ;;
      -h|--help) usage; return 0 ;;
      -*) die "add:未知选项 $1" ;;
      *) [ -z "$name" ] || die "add:多余参数 $1"; name="$1"; shift ;;
    esac
  done
  [ -n "$name" ] || die "用法:$SELF add <名> [--from-credentials <文件>] [--seed-claude-json <目录|文件>] [--email <邮箱>] [--default] [--apply]"
  name_check "$name"
  [ -n "$email" ] && email_check "$email"
  cfg_finalize
  need_manifest
  lock_acquire            # 读-改-写 manifest:先上锁再读,否则并发 add 会互相覆盖
  manifest_load
  # Z01:"0" 是**保留名**。它是合成项(「不设 CLAUDE_CONFIG_DIR」这个状态),不是注册项;
  # 允许注册同名会让 manifest 里出现两个 name="0",按名字查账号就有两个答案。
  [ "$name" = "$ACCOUNT_ZERO_NAME" ] && die "'$ACCOUNT_ZERO_NAME' 是保留名:它代表「不设 CLAUDE_CONFIG_DIR」\
这个状态本身(凭据在 $SHARED_STORE),恒在列、无需注册。换个名字"
  mf_index "$name" >/dev/null && die "账号已存在:$name"

  local cfgdir="$ACCTS_DIR/$name"
  { [ -e "$cfgdir" ] || [ -L "$cfgdir" ]; } && die "目录已存在:$cfgdir(先 $SELF rm $name 或换个名字)"

  plan_init
  plan_add MKDIR "$cfgdir"
  plan_links_for "$cfgdir"
  # Z08:**此前 add 完全不碰 ISOLATE_SET** ⇒ 新账号对每个隔离项既没有软链(share_items 跳过它)
  # 也没有实体 ⇒ 拿不到该文件。凡共享库里有那一份(它是模板)就复制成本账号私有实体。
  # `.credentials.json` / `.claude.json` 刻意**不**在这里种:身份必须由 `--from-credentials` /
  # `--seed-claude-json` 显式给,或由用户登录产生 —— 绝不从别人那儿悄悄复制一份身份过来。
  local _iso
  for _iso in ${ISOLATE_ARR[@]+"${ISOLATE_ARR[@]}"}; do
    case "$_iso" in .credentials.json|.claude.json) continue ;; esac
    if [ -e "$SHARED_STORE/$_iso" ] || [ -L "$SHARED_STORE/$_iso" ]; then
      plan_add ISOLATE "$SHARED_STORE/$_iso" "$cfgdir/$_iso"
    fi
  done

  if [ -n "$fromcred" ]; then
    fromcred="$(to_abs "$fromcred")"
    [ -L "$fromcred" ] && die "凭据源是 symlink,拒绝导入(会与别的账号共用同一份真实凭据):$fromcred"
    [ -f "$fromcred" ] || die "凭据文件不存在或不是普通文件:$fromcred"
    [ -s "$fromcred" ] || die "凭据文件为空:$fromcred"
    plan_add COPY "$fromcred" "$cfgdir/.credentials.json"
    plan_add CHMOD 600 "$cfgdir/.credentials.json"
  fi
  if [ -n "$seed" ]; then
    seed="$(to_abs "$seed")"
    [ -d "$seed" ] && seed="$seed/.claude.json"
    [ -f "$seed" ] || die "种子 .claude.json 不存在:$seed"
    have jq || die "--seed-claude-json 需要 jq(用于剥掉 oauthAccount)"
    plan_add SEED "$seed" "$cfgdir/.claude.json"
    plan_add CHMOD 600 "$cfgdir/.claude.json"
    warn "--seed-claude-json 只剥掉 oauthAccount;源文件里 mcpServers 的环境变量(可能含 API key)会一并复制过去。"
  fi

  mf_add "$name" "$email" "$cfgdir" false
  [ "$makedef" = 1 ] && mf_set_default "$name"
  manifest_render >"$STAGE/manifest.json"
  plan_add MANIFEST

  info "${_c_bold}add${_c_reset}  账号=$name  config-dir=$cfgdir${email:+  邮箱=$email}"
  [ -n "$fromcred" ] || info "${_c_dim}  (未给 --from-credentials:该账号尚未登录,之后跑 '$SELF run $name' 在里面 /login)${_c_reset}"
  plan_commit
}

# ---------- rm ----------
cmd_rm() {
  local name="" force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=1; shift ;;
      --apply) APPLY=1; shift ;;
      -h|--help) usage; return 0 ;;
      -*) die "rm:未知选项 $1" ;;
      *) [ -z "$name" ] || die "rm:多余参数 $1"; name="$1"; shift ;;
    esac
  done
  [ -n "$name" ] || die "用法:$SELF rm <名> [--force] [--apply]"
  cfg_finalize; need_manifest; lock_acquire; manifest_load
  local idx cfgdir isdef
  [ "$name" = "$ACCOUNT_ZERO_NAME" ] && die "账号 0 删不掉:它不是注册项,是「不设 CLAUDE_CONFIG_DIR」\
这个状态。要让它从列表消失,就把 $SHARED_STORE 里的凭据迁走(见 '$SELF isolate')"
  idx="$(mf_index "$name")" || die "没有这个账号:$name"
  cfgdir="$(mf_field "$idx" 3)"; isdef="$(mf_field "$idx" 4)"
  [ "$isdef" = "true" ] && [ "$force" != 1 ] && die "$name 是默认账号;确定要删就加 --force"
  is_under "$cfgdir" "$ACCTS_DIR" || die "拒绝删除 ACCTS_DIR 之外的 config-dir:$cfgdir(in-place 模式的默认账号不能这样删)"

  plan_init
  { [ -e "$cfgdir" ] || [ -L "$cfgdir" ]; } && plan_add RM "$cfgdir"
  mf_del "$name"
  # 删掉默认号后必须补选一个,否则 manifest 里没有 default:shellinit 不再产出
  # export CLAUDE_CONFIG_DIR、cc-monitor 的「默认账号」也会取空。
  local newdef=""
  if [ "$isdef" = "true" ] && [ "${#MF[@]}" -gt 0 ]; then
    newdef="$(mf_field 0 1)"; mf_set_default "$newdef"
  fi
  manifest_render >"$STAGE/manifest.json"
  plan_add MANIFEST
  info "${_c_bold}rm${_c_reset}  账号=$name  config-dir=$cfgdir  ${_c_dim}(共享库不受影响)${_c_reset}"
  [ -n "$newdef" ] && info "  ${_c_ylw}默认账号已改为:$newdef${_c_reset}"
  info "  ${_c_dim}注意:该账号的凭据副本会留在备份目录里(rollback 用);要彻底抹掉请自行删 \$ACCTS_DIR/.backup-*/${_c_reset}"
  plan_commit
}

# ---------- list ----------
cmd_list() {
  local as_json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) as_json=1; shift ;;
      -h|--help) usage; return 0 ;;
      *) die "list:未知参数 $1" ;;
    esac
  done
  cfg_finalize; need_manifest; manifest_load
  local rec n e c d live mark state logged exists first=1
  if [ "$as_json" = 1 ]; then
    # 给 cc-monitor / daemon 的稳定进程级接口:比 manifest 多「实时邮箱 + 登录态」
    printf '{\n  "version": 1,\n'
    printf '  "sharedStore": "%s",\n  "acctsDir": "%s",\n' "$(json_esc "$SHARED_STORE")" "$(json_esc "$ACCTS_DIR")"
    printf '  "accounts": ['
    for rec in ${MF[@]+"${MF[@]}"}; do
      IFS="$MF_SEP" read -r n e c d <<<"$rec"
      live="$(claude_json_email "$c")"; [ -n "$live" ] || live="$e"
      exists=false; [ -d "$c" ] && exists=true
      logged=false; [ -f "$c/.credentials.json" ] && logged=true
      if [ "$first" = 1 ]; then printf '\n'; else printf ',\n'; fi
      first=0
      printf '    { "name": "%s", "email": "%s", "configDir": "%s", "isDefault": %s, "mode": "%s", "exists": %s, "loggedIn": %s }' \
        "$(json_esc "$n")" "$(json_esc "$live")" "$(json_esc "$c")" "$d" "$(acct_mode "$c")" "$exists" "$logged"
    done
    # Z01:账号 0 **追加在末尾**(既有下标不变)。**configDir 键省略** ⇒ 消费侧「缺它」= 不注入。
    if [ "$first" = 1 ]; then printf '\n'; else printf ',\n'; fi
    acct_zero_json 1
    printf '\n  ]\n}\n'
    return 0
  fi
  printf '%-14s %-34s %-8s %s\n' "账号" "邮箱" "状态" "config-dir"
  # Z01:账号 0 —— config-dir 那列写「(不设)」,那正是它的定义
  local z0e z0s
  z0e="$(acct_zero_email)"; [ -n "$z0e" ] || z0e="-"
  if [ "$(acct_zero_logged)" = true ]; then z0s="已登录"; else z0s="未登录"; fi
  printf '%-14s %-34s %-8s %s\n' "$ACCOUNT_ZERO_NAME" "$z0e" "$z0s" "(不设 CLAUDE_CONFIG_DIR)"
  [ "${#MF[@]}" -gt 0 ] || { info "(除账号 0 外还没有别的账号;用 $SELF add <名> 新增)"; return 0; }
  for rec in "${MF[@]}"; do
    IFS="$MF_SEP" read -r n e c d <<<"$rec"
    live="$(claude_json_email "$c")"
    [ -n "$live" ] || live="$e"
    [ -n "$live" ] || live="-"
    if [ ! -d "$c" ]; then state="缺目录"
    elif [ -f "$c/.credentials.json" ]; then state="已登录"
    else state="未登录"; fi
    if [ "$d" = "true" ]; then mark="*"; else mark=" "; fi
    printf '%s%-13s %-34s %-8s %s\n' "$mark" "$n" "$live" "$state" "$c"
  done
  info ""
  info "${_c_dim}* = 默认账号 · 共享库 $SHARED_STORE · manifest $MANIFEST${_c_reset}"
}

# ---------- which ----------
cmd_which() {
  cfg_finalize; need_manifest; manifest_load
  local target="${1-}"
  if [ -z "$target" ]; then
    target="${CLAUDE_CONFIG_DIR-}"
    if [ -z "$target" ]; then
      # Z01:这个状态现在**有名字**了 —— 它就是账号 0。它是个正常账号,不是错误 ⇒ **rc=0**。
      # (旧文案说「全迁之后裸起是没有凭据的」—— 那句不成立:凭据可以就在共享库里,
      #  那正是账号 0 已登录的样子。改成如实报它的登录态。)
      printf '%s\n' "$ACCOUNT_ZERO_NAME"
      if acct_zero_logged; then
        info "未设 CLAUDE_CONFIG_DIR ⇒ 账号 0(已登录;凭据在 $SHARED_STORE,.claude.json 在 $LEGACY_HOME_DIR)"
      else
        info "未设 CLAUDE_CONFIG_DIR ⇒ 账号 0(未登录);用 '$SELF run <名>' 起别的账号,或直接 /login"
      fi
      return 0
    fi
  fi
  target="$(to_abs "$target")"
  local rec n c d
  for rec in ${MF[@]+"${MF[@]}"}; do
    IFS="$MF_SEP" read -r n _ c d <<<"$rec"
    if [ "$c" = "$target" ]; then
      printf '%s%s\n' "$n" "$([ "$d" = true ] && printf ' (默认)' || true)"
      # Z04:它是**已登记的 in-place 账号**——逃生口,可用,但别把它当账号 0。
      [ "$target" = "$SHARED_STORE" ] && warn "这是 in-place(V1) 账号,**不是账号 0**:\
它的 .claude.json 写在共享库、账号 0 的写在 $LEGACY_HOME_DIR ⇒ 两套状态。详情跑 '$SELF verify'"
      return 0
    fi
  done
  # Z04:**最危险的那种**——手工把 CLAUDE_CONFIG_DIR 设成共享库,以为这样就是「账号 0」。
  # 它谁都不是:manifest 里没有这个 config-dir,而 claude 会把 .claude.json 写进共享库
  # (账号 0 的那份在 $LEGACY_HOME_DIR)⇒ 状态分裂,且分裂出来的那份没有任何账号认领。
  if [ "$target" = "$SHARED_STORE" ]; then
    warn "CLAUDE_CONFIG_DIR 显式指向共享库($SHARED_STORE),但 manifest 里没有这个账号。\
**这不是账号 0** —— 账号 0 是「**什么都不设**」(用 '$SELF run $ACCOUNT_ZERO_NAME',或 shellinit 生成的 ${ACCOUNT_ZERO_NAME}cc)。\
照这样起 claude 会把 .claude.json 写进共享库而不是 $LEGACY_HOME_DIR ⇒ 同一个人两套状态"
    return 1
  fi
  info "(未登记的 config-dir:$target)"
  return 1
}

# ---------- verify ----------
V_FAIL=0; V_WARN=0
vfail() { bad "$*"; V_FAIL=$((V_FAIL + 1)); }
vwarn() { printf '  %s!%s %s\n' "$_c_ylw" "$_c_reset" "$*"; V_WARN=$((V_WARN + 1)); }

cmd_verify() {
  local probe=1 names=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-probe) probe=0; shift ;;
      --apply) shift ;;  # verify 不改配置,容忍误传
      -h|--help) usage; return 0 ;;
      -*) die "verify:未知选项 $1" ;;
      *) names+=("$1"); shift ;;
    esac
  done
  cfg_finalize; need_manifest; manifest_load
  [ "${#MF[@]}" -gt 0 ] || die "manifest 里没有账号"
  local x
  for x in ${names[@]+"${names[@]}"}; do
    mf_index "$x" >/dev/null || die "没有这个账号:$x(用 $SELF list 看)"
  done

  local rec n e c d isolated_any=0 inplace_any=0
  info "${_c_bold}== 全局 ==${_c_reset}"
  for rec in "${MF[@]}"; do
    IFS="$MF_SEP" read -r n _ c _ <<<"$rec"
    if [ "$c" = "$SHARED_STORE" ]; then inplace_any=1; else isolated_any=1; fi
  done
  # Z04:in-place 账号的 config-dir **就是**共享库 ⇒ 它的 .claude.json 是 <共享库>/.claude.json,
  # 而账号 0(裸起)读的是 $LEGACY_HOME_DIR/.claude.json。**两份同时存在 = 状态真的分裂了**:
  # 设了 CLAUDE_CONFIG_DIR 起 claude 读前者、裸起读后者 ⇒ 同一个人两套 projects 信任 /
  # oauthAccount / numStartups。
  #
  # 此前这里只有一句泛泛的「该模式下会分裂」——**它不查有没有真分裂**。更糟的是下面
  # 「隔离项 .claude.json 是本账号私有实体」那条会把共享库那份报成**绿灯**(对 in-place 账号
  # 而言它确实是私有实体)⇒ **真分裂今天完全不可见**。这就是 Z04 要补的那条腿。
  #
  # **档位 vwarn 不是 vfail**:in-place 是工具自己给的逃生口(`init` 那里就 warn 过),用它的人
  # 可能明知代价;判致命会让在野所有 in-place 用户的 verify 突然红(风险不对称)。
  if [ "$inplace_any" = 1 ]; then
    local _cj_s="$SHARED_STORE/.claude.json" _cj_h="$LEGACY_HOME_DIR/.claude.json"
    if [ "$_cj_s" != "$_cj_h" ] && [ -e "$_cj_s" ] && [ -e "$_cj_h" ]; then
      vwarn "存在 in-place 账号,而且 **.claude.json 已经真的分裂了**:$_cj_s($(stat -c %s -- "$_cj_s" 2>/dev/null || echo ?) 字节)\
 与 $_cj_h($(stat -c %s -- "$_cj_h" 2>/dev/null || echo ?) 字节)同时存在。设了 CLAUDE_CONFIG_DIR 起 claude 读前者、\
裸起读后者 ⇒ 同一个人两套 projects 信任/oauthAccount/numStartups。\
**凭据却是同一份**($SHARED_STORE/.credentials.json)⇒ 一个登录身份、两套本机状态。\
换句话说 in-place 账号与账号 0 在这个库里是同一个登录、不同的状态文件。这是 in-place(V1) 的代价;要收敛请迁到 V2"
    else
      vwarn "存在 in-place 账号(config-dir == 共享库):该模式下 .claude.json 会分裂,cc-monitor 不支持。\
(现在**还没**分裂 —— 但只要有人裸起一次 claude 就会)"
    fi
  fi
  # 只要还有一个隔离账号,「共享库不该有账号态」就仍然成立(混合模式下也必须查)
  if [ "$isolated_any" = 1 ]; then
    # Z01:**共享库里的 secret = 账号 0 的身份,是一种状态而不是违规。**
    #
    # ★ 订正 Z07 的一句事实错误(commit e6674d3):那条检查的说辞写的是
    #   「它会被自动 symlink 给每个账号 = 静默串号」——**错的**。`share_items()` 的两个分支
    #   都有 `is_isolate "$base" && continue`,隔离项**从不**被 symlink 出去。
    #   沙盒实测:往共享库放回一个 .credentials.json 再 sync,z 保持自己的私有实体
    #   (内容不是共享库那份)、b 根本没有,零软链、不串号。
    #   (D2 那条 600 启发式的同款说辞**仍然成立**——未声明项不在隔离集里,确实会被 symlink。)
    #
    # 它的**真实含义**是:有人没设 CLAUDE_CONFIG_DIR 就起了 claude ⇒ 产生了一个身份。
    # 那个身份此前是**不可见的幽灵**(manifest 不认、cc-monitor 看不到、用量查不到)。
    # 本工作区的立论是**吸收 > 检测 > 禁止**:把它登记成「账号 0」,而不是判它违规。
    # ⇒ 这里从 vfail 改判为**状态报告**。守不住的那条不变量,换成下面 `.claude.json` 那条可查的检查。
    # 判据就是声明里的 **root 字段**(Z06 建这张表就是为了这种问题有唯一答案):
    #   root=cfg  ⇒ 共享库**就是**账号 0 的 config dir ⇒ 它在这儿是**原生位置** ⇒ 状态,不是违规
    #   root=home ⇒ 账号 0 的那份住 $HOME、隔离账号的住各自 config dir ⇒ 共享库这份
    #               **不是任何账号的原生位置**,是迁移残留。它含 oauthAccount ⇒ 仍判致命。
    #               (混合模式除外:in-place 账号的 config dir 就是共享库,那儿是它的原生位置。)
    local _svc _z0=0
    for _svc in $(ni_secrets); do
      [ -e "$SHARED_STORE/$_svc" ] || continue
      if ni_is_home_rooted "$_svc"; then
        if [ "$inplace_any" = 1 ]; then
          skip "共享库有 $_svc,但存在 in-place 账号(它的原生位置就是这儿)⇒ 不判"
        else
          vfail "共享库里有 $_svc —— 它的原生根是 \$HOME,**不是任何账号的原生位置**\
(账号 0 的住 $LEGACY_HOME_DIR/$_svc,隔离账号的住各自 config dir)⇒ 这是迁移残留,且它含身份。\
请核对后 '$SELF isolate $_svc --apply' 或手工移除"
        fi
      else
        _z0=1
        ok "账号 0 已登录($_svc 在共享库 = 有人未设 CLAUDE_CONFIG_DIR 起过 claude)"
      fi
    done
    [ "$_z0" = 0 ] && ok "账号 0 未登录(共享库无 cfg 根的 secret 项)"
    if [ "$inplace_any" = 0 ] && [ -e "$LEGACY_HOME_DIR/.claude.json" ]; then
      vwarn "$LEGACY_HOME_DIR/.claude.json 又出现了 —— 有进程在没设 CLAUDE_CONFIG_DIR 的情况下起过 claude"
    fi
  else
    skip "全部账号都是 in-place,跳过「共享库应无账号态」检查"
  fi

  local emails=() checked=() want
  for rec in "${MF[@]}"; do
    IFS="$MF_SEP" read -r n e c d <<<"$rec"
    if [ "${#names[@]}" -gt 0 ]; then
      want=0
      for x in "${names[@]}"; do [ "$x" = "$n" ] && want=1; done
      [ "$want" = 1 ] || continue
    fi
    checked+=("$n")
    info ""
    info "${_c_bold}== 账号 $n ==${_c_reset}  $c"
    if ! acct_dir_ok "$c"; then vfail "config-dir 不在受控范围内(既不在 $ACCTS_DIR 内,也不是共享库本身):$c"; continue; fi
    if [ ! -d "$c" ]; then vfail "config-dir 不存在"; continue; fi
    local is_inplace=0 mode
    [ "$c" = "$SHARED_STORE" ] && is_inplace=1
    mode="$(stat -c %a "$c" 2>/dev/null || echo '?')"
    if [ "$mode" = "700" ]; then ok "config-dir 权限 700"
    elif [ "$is_inplace" = 1 ]; then vwarn "config-dir 权限 $mode(in-place 模式下它就是共享库,不强求 700)"
    else vfail "config-dir 权限 $mode(必须 700 —— 里面是凭据;跑 '$SELF sync --apply' 修)"; fi

    # 隔离项:必须是本账号私有的实体,不能是 symlink;凭据必须 600
    local item cmode
    for item in ${ISOLATE_ARR[@]+"${ISOLATE_ARR[@]}"}; do
      if [ -L "$c/$item" ]; then
        vfail "隔离项 $item 竟是 symlink(会串号!)"
      elif [ -e "$c/$item" ]; then
        if [ "$item" = ".credentials.json" ]; then
          cmode="$(stat -c %a "$c/$item" 2>/dev/null || echo '?')"
          if [ "$cmode" = "600" ]; then ok "隔离项 $item 是本账号私有实体(600)"
          else vfail "凭据权限 $cmode(必须 600;跑 '$SELF sync --apply' 修)"; fi
        else
          ok "隔离项 $item 是本账号私有实体"
        fi
      elif [ "$item" = ".credentials.json" ]; then
        vwarn "尚未登录(无 .credentials.json)—— 跑 '$SELF run $n' 后 /login"
      fi
    done

    # 共享项:必须是指向共享库的 symlink
    local miss=0 badlink=0 tgt shared_n=0
    if [ "$is_inplace" = 1 ]; then
      skip "in-place 账号:共享项即共享库本身,跳过 symlink 检查"
    else
      while IFS= read -r -d '' item; do
        shared_n=$((shared_n + 1))
        if [ ! -L "$c/$item" ]; then
          if [ -e "$c/$item" ]; then vfail "共享项 $item 是实体文件(应为 symlink,该账号的改动别人看不到)"; badlink=1
          else miss=$((miss + 1)); fi
          continue
        fi
        tgt="$(readlink "$c/$item")"
        if [ "$tgt" != "$SHARED_STORE/$item" ]; then vfail "共享项 $item 指向 $tgt(应为 $SHARED_STORE/$item)"; badlink=1; continue; fi
        if [ ! -e "$c/$item" ]; then
          # 源头本身就是断链的话,sync 修不了,得用户去共享库处理
          if [ -L "$SHARED_STORE/$item" ] && [ ! -e "$SHARED_STORE/$item" ]; then
            vwarn "共享项 $item 断链,但源头就断了:$SHARED_STORE/$item → $(readlink "$SHARED_STORE/$item")(请在共享库里修掉或删掉它)"
          else
            vfail "共享项 $item 是断链"; badlink=1
          fi
        fi
      done < <(share_items)
      if [ "$shared_n" = 0 ]; then
        vfail "共享项 0 个 —— 共享库 $SHARED_STORE 空的或不可读:这样根本没有共享"
      elif [ "$miss" -gt 0 ]; then
        vfail "共享项缺 $miss 个(跑 '$SELF sync --apply' 补)"
      elif [ "$badlink" = 0 ]; then
        ok "共享项 $shared_n 个全部就位"
      fi
    fi

    # 账号目录里的意外实体项(in-place 账号的目录就是共享库本身,不适用)
    if [ "$is_inplace" = 0 ]; then
      local base
      shopt -s nullglob dotglob
      for base in "$c"/*; do
        base="${base##*/}"
        [ -L "$c/$base" ] && continue
        is_isolate "$base" && continue
        vwarn "非预期的实体项 $base(既不在 ISOLATE_SET 也不是共享 symlink;要共享就迁进共享库,要私有就加进 ISOLATE_SET)"
      done
      shopt -u nullglob dotglob
    fi

    local live; live="$(claude_json_email "$c")"
    if [ -n "$live" ]; then ok "邮箱:$live"; emails+=("$n:$live")
    else skip "邮箱:未知(尚未登录 / 无 .claude.json)"; fi
  done

  # 隔离交叉验证:邮箱两两不同
  info ""
  info "${_c_bold}== 隔离(账号身份互不串)==${_c_reset}"
  if [ "${#emails[@]}" -lt 2 ]; then
    skip "已知邮箱不足 2 个,无法交叉验证(登录第二个账号后再跑)"
  else
    local i j ei ej dup=0
    for i in "${!emails[@]}"; do
      for j in "${!emails[@]}"; do
        [ "$i" -lt "$j" ] || continue
        ei="${emails[$i]#*:}"; ej="${emails[$j]#*:}"
        [ "$ei" = "$ej" ] && { vfail "${emails[$i]%%:*} 与 ${emails[$j]%%:*} 邮箱相同($ei)—— 没隔离开"; dup=1; }
      done
    done
    [ "$dup" = 0 ] && ok "各账号邮箱互不相同(${#emails[@]} 个)"
  fi

  # 共享活体探测:经**第一个账号**写入 → 验共享库可见 + 其余账号可见(双向)
  info ""
  info "${_c_bold}== 共享(改一处,处处可见)==${_c_reset}"
  if [ "$probe" != 1 ]; then
    skip "--no-probe:跳过活体探测"
  elif [ "${#checked[@]}" -lt 1 ]; then
    skip "无账号可探"
  else
    local pdir="" c1 idx1 item2
    idx1="$(mf_index "${checked[0]}")"
    c1="$(mf_field "$idx1" 3)"
    while IFS= read -r -d '' item2; do
      if [ -d "$c1/$item2" ] && [ -w "$c1/$item2" ]; then pdir="$item2"; break; fi
    done < <(share_items)
    if [ -z "$pdir" ]; then
      skip "找不到可写的共享目录,跳过活体探测"
    else
      local pname=".cc-acct-iso-probe.$$"
      PROBE_FILE="$SHARED_STORE/$pdir/$pname"     # 全局 trap 兜底清理
      local seen=0 miss2=0 nm cd2
      : >"$c1/$pdir/$pname" || die "探测文件写入失败:$c1/$pdir/$pname"
      if [ -e "$SHARED_STORE/$pdir/$pname" ]; then
        ok "账号 ${checked[0]} 写的文件出现在共享库实体里($pdir/)"
      else
        vfail "账号 ${checked[0]} 写的文件没落进共享库 —— 它的 $pdir 不是共享链"; miss2=1
      fi
      for nm in "${checked[@]}"; do
        cd2="$(mf_field "$(mf_index "$nm")" 3)"
        if [ -e "$cd2/$pdir/$pname" ]; then seen=$((seen + 1)); else
          vfail "账号 $nm 看不到 $pdir/$pname"; miss2=1
        fi
      done
      rm -f -- "$PROBE_FILE" "$c1/$pdir/$pname" 2>/dev/null || true
      PROBE_FILE=""
      [ "$miss2" = 0 ] && ok "一处写入,$seen 个账号都能经各自 config-dir 看到($pdir/)"
    fi
  fi

  # ── Z07:声明漂移检测(销 BACKLOG E37)────────────────────────────
  # E37 的实质:`CLAUDE_CONFIG_DIR` 零官方文档,而整套隔离压在它上面;它失效时
  # **今天没有任何东西会响**,而最坏形态不是报错、是**静默共用身份**
  # (以为在用 z,实际烧 b 的额度,UI 上看不出来)。
  #
  # **这里买到的是「快速失败」,不是「保证可迁」**:
  #   换位置(改名/搬目录) ⇒ D1 报出来,改声明 + `sync --apply` 即可
  #   换机制(凭据进 OS keyring) ⇒ 按目录切身份整体失效,任何检测都救不了那件事,
  #                              但 D1/D2 会让它**当场可见**而不是静默串号
  info ""
  info "${_c_bold}声明漂移(Z07)${_c_reset}"

  # D1(致命):声明里的项在共享库与**所有**账号里都找不到 ⇒ 声明与现实脱节。
  # 这正是「Claude Code 换了文件名/位置」的直接征兆。
  local _ni _found _ci
  while IFS= read -r _ni; do
    [ -n "$_ni" ] || continue
    _found=0
    { [ -e "$SHARED_STORE/$_ni" ] || [ -L "$SHARED_STORE/$_ni" ]; } && _found=1
    { [ -e "$LEGACY_HOME_DIR/$_ni" ] || [ -L "$LEGACY_HOME_DIR/$_ni" ]; } && _found=1
    if [ "$_found" = 0 ]; then
      for _ci in "${!MF[@]}"; do
        IFS="$MF_SEP" read -r _ _ c _ <<<"${MF[$_ci]}"
        { [ -e "$c/$_ni" ] || [ -L "$c/$_ni" ]; } && { _found=1; break; }
      done
    fi
    if [ "$_found" = 1 ]; then
      ok "声明项 $_ni 在实际布局里找得到"
    else
      # **只能是提示,不能判致命**:声明里好几项是 Claude Code **懒创建**的
      # (`policy-limits.json` 撞到限速才出现、`stats-cache.json` 用过才有),
      # 「还没被创建」与「改了位置」从这里分辨不出来。判致命会让几乎每台干净机器都红。
      # (本轮实测:初版写成 vfail,沙盒里当场误报 4 条。)
      # 真正无歧义的致命信号是下面 D1b 那条。
      vwarn "声明项 $_ni 在共享库/\$HOME/所有账号里都找不到 —— 可能只是**还没被创建**(懒创建的项), \
也可能 Claude Code 改了它的位置。若近期升级过 Claude Code,请复核 NATIVE_IDENTITY 那张表"
    fi
  done < <(ni_items)

  # D2(提示):共享库顶层出现 **mode 600 的文件**却不在声明里。
  # 为什么这条最要紧:共享集是 @auto(共享库顶层减去隔离集与排除集) ⇒ 这种文件会被
  # **自动 symlink 给每个账号**;它若含身份,就是 E37 最坏的那种静默串号。
  # 600 是启发式(Claude Code 写凭据用 600),故只报提示不判致命——**误报的代价远小于漏报**。
  local _sf _sbase _smode
  shopt -s nullglob dotglob
  for _sf in "$SHARED_STORE"/*; do
    [ -f "$_sf" ] || continue
    _sbase="${_sf##*/}"
    is_isolate "$_sbase" && continue
    is_excluded "$_sbase" && continue
    _smode="$(stat -c %a "$_sf" 2>/dev/null || echo '')"
    if [ "$_smode" = "600" ]; then
      vwarn "共享库里有 mode 600 的 $_sbase,而它**不在** NATIVE_IDENTITY 声明里 ⇒ 它会被自动 \
symlink 给每个账号。若它含身份,就是静默串号。请判定:是身份就加进声明再跑 '$SELF isolate $_sbase --apply'"
    fi
  done
  shopt -u nullglob dotglob

  # D3(提示):当前版本与 manifest 里钉的版本不同 ⇒ 要人复核声明还成不成立。
  # 版本探测是**只读**的(见 lib.sh 的 ni_probe_version,绝不执行 claude);探不到就跳过。
  local _nowv _pinv
  _nowv="$(ni_probe_version)"
  _pinv="$(manifest_pinned_version)"
  if [ -z "$_nowv" ]; then
    vwarn "探测不到 Claude Code 版本 ⇒ 版本钉这条检查跳过(不影响 D1/D2)"
  elif [ -z "$_pinv" ]; then
    vwarn "manifest 里还没钉版本(当前探测到 $_nowv)。跑一次 '$SELF sync --apply' 会把它钉上"
  elif [ "$_nowv" != "$_pinv" ]; then
    vwarn "Claude Code 版本从 $_pinv 变成了 $_nowv ⇒ **请复核 NATIVE_IDENTITY 那张表还成不成立**\
(身份文件有没有改名/搬位置)。复核完跑 '$SELF sync --apply' 重新钉"
  else
    ok "版本与声明所钉一致($_pinv)"
  fi

  info ""
  if [ "$V_FAIL" -gt 0 ]; then
    printf '%s结果:FAIL%s(%d 个致命 / %d 个提示)\n' "$_c_red" "$_c_reset" "$V_FAIL" "$V_WARN"
    return 1
  fi
  printf '%s结果:PASS%s(%d 个提示)\n' "$_c_grn" "$_c_reset" "$V_WARN"
  info "${_c_dim}并发不互踢的最终验证请手动做:两个终端各 '$SELF run <号A>' / '$SELF run <号B>',同时用一会儿,双方都不掉登录。${_c_reset}"
}

# ---------- sync ----------
cmd_sync() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --apply) APPLY=1; shift ;;
      -h|--help) usage; return 0 ;;
      *) die "sync:未知参数 $1" ;;
    esac
  done
  cfg_finalize; need_manifest; lock_acquire; manifest_load
  plan_init
  local i n e c d item tgt changed=0 live cmode
  for i in "${!MF[@]}"; do
    IFS="$MF_SEP" read -r n e c d <<<"${MF[$i]}"
    if ! acct_dir_ok "$c"; then warn "跳过 $n:config-dir 不在受控范围内($c)"; continue; fi
    if [ ! -d "$c" ]; then warn "跳过 $n:config-dir 不存在($c)"; continue; fi
    if [ "$c" != "$SHARED_STORE" ]; then     # in-place 账号无需补链/改权限
      [ "$(stat -c %a "$c" 2>/dev/null || echo 700)" = "700" ] || plan_add CHMOD 700 "$c"
      # Z06:权限修复从**声明**派生 —— 凡 `NATIVE_IDENTITY` 里类别为 `secret` 的项都要 600。
      # **这修了一个此前不可见的缺口**:`.claude.json` 同样含 `oauthAccount`(身份本体)、
      # `init --seed-claude-json` 也确实 chmod 600 了它,但 `sync` 此前只修 `.credentials.json`
      # ⇒ 它的权限漂了就再也没人修。散着写的时候这种不一致看不出来,收成一处声明就浮出来了。
      # (刻意**不**同时收紧 `verify` 的硬失败范围:在野的 `.claude.json` 若是 644,
      #  那会给用户一个突然的新红。见 feature 文档 §「浮出来但本轮不改的两处」。)
      local _sec
      for _sec in $(ni_secrets); do
        if [ -f "$c/$_sec" ] && [ ! -L "$c/$_sec" ]; then
          cmode="$(stat -c %a "$c/$_sec" 2>/dev/null || echo 600)"
          [ "$cmode" = "600" ] || plan_add CHMOD 600 "$c/$_sec"
        fi
      done
      while IFS= read -r -d '' item; do
        if [ -L "$c/$item" ]; then
          tgt="$(readlink "$c/$item")"
          [ "$tgt" = "$SHARED_STORE/$item" ] || plan_add RELINK "$SHARED_STORE/$item" "$c/$item"
        elif [ -e "$c/$item" ]; then
          warn "$n:$item 是实体文件而非共享链,未自动处理(要共享请自行合并进共享库后删掉它)"
        else
          plan_add LINK "$SHARED_STORE/$item" "$c/$item"
        fi
      done < <(share_items)
      # 清掉指向共享库、但已不属于共享集的残链。存在性判断必须与 share_items 一致:
      # 断链在 share_items 里算「存在」,这里若只用 -e 判就会一删一建来回翻,永不收敛。
      local base
      shopt -s nullglob dotglob
      for base in "$c"/*; do
        base="${base##*/}"
        [ -L "$c/$base" ] || continue
        tgt="$(readlink "$c/$base")"
        case "$tgt" in "$SHARED_STORE"/*) ;; *) continue ;; esac
        if is_isolate "$base"; then
          # Z08:隔离项现在是**指向共享库的软链** ⇒ 串号风险(`verify` 也这么报)。
          # **此前这里是 `RM`** —— 那会把该账号的这个文件**直接删掉**(实测:把 settings.json
          # 加进 ISOLATE_SET 再 sync --apply,两个账号的 settings.json 都不存在了、
          # 设置静默回落默认值)。正确处置是**私有化**:内容从共享库复制下来、软链原子替换,
          # 共享库那份保留作新账号模板。共享库真没有那份时才回落到 RM(无内容可复制)。
          if [ -e "$SHARED_STORE/$base" ] || [ -L "$SHARED_STORE/$base" ]; then
            plan_add ISOLATE "$SHARED_STORE/$base" "$c/$base"
          else
            plan_add RM "$c/$base"
          fi
        elif is_excluded "$base" \
           || { [ ! -e "$SHARED_STORE/$base" ] && [ ! -L "$SHARED_STORE/$base" ]; }; then
          plan_add RM "$c/$base"
        fi
      done
      shopt -u nullglob dotglob
    fi
    live="$(claude_json_email "$c")"
    if [ -n "$live" ] && [ "$live" != "$e" ]; then
      MF[i]="$n$MF_SEP$live$MF_SEP$c$MF_SEP$d"
      changed=1
    fi
  done
  if [ "$changed" = 1 ]; then
    manifest_render >"$STAGE/manifest.json"
    plan_add MANIFEST
  fi
  info "${_c_bold}sync${_c_reset}  共享库=$SHARED_STORE"
  plan_commit
}

# ---------- isolate（Z08）----------
# 把某个共享项就地变成**每个账号各自私有**的实体。用途有两个,都是真需求:
#   ① 第三方 API key 路线乙:`apiKeyHelper` 要写进每账号自己的 settings.json
#   ② Claude Code 换了身份文件的位置时,把 z/b 的物理布局迁过去
# **它不改 ISOLATE_SET**（那是配置的事）——它只让**现实**对齐配置。
# 正常用法是「先把该项加进 ISOLATE_SET,再跑 sync」;这个命令是**定向**版本,
# 用于只想动一项、不想让 sync 顺手把别的漂移也一起修的场合。
cmd_isolate() {
  local item=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --apply) APPLY=1; shift ;;
      -h|--help) usage; return 0 ;;
      -*) die "isolate:未知参数 $1" ;;
      *) [ -z "$item" ] || die "isolate:只接受一个项名"; item="$1"; shift ;;
    esac
  done
  [ -n "$item" ] || die "isolate:要私有化哪一项?(如 settings.json)"
  case "$item" in */*|.|..) die "isolate:项名必须是共享库下的单层名字,不能含 /" ;; esac
  cfg_finalize; need_manifest; lock_acquire; manifest_load
  { [ -e "$SHARED_STORE/$item" ] || [ -L "$SHARED_STORE/$item" ]; } \
    || die "共享库里没有 $item —— 无内容可复制"
  is_isolate "$item" || warn "$item 不在 ISOLATE_SET 里:本次会私有化,但下次 sync 会把它当共享项、\
再给每个账号建回软链。要长期私有请同时把它加进 ISOLATE_SET(见 config)"
  plan_init
  local i n e c d done_n=0
  for i in "${!MF[@]}"; do
    IFS="$MF_SEP" read -r n e c d <<<"${MF[$i]}"
    acct_dir_ok "$c" || { warn "跳过 $n:config-dir 不在受控范围内($c)"; continue; }
    [ -d "$c" ] || { warn "跳过 $n:config-dir 不存在($c)"; continue; }
    [ "$c" != "$SHARED_STORE" ] || continue          # in-place 账号就是共享库本身
    if [ -L "$c/$item" ] || [ ! -e "$c/$item" ]; then
      plan_add ISOLATE "$SHARED_STORE/$item" "$c/$item"
      done_n=$((done_n+1))
    else
      info "  $n:$item 已是私有实体,跳过"
    fi
  done
  info "${_c_bold}isolate${_c_reset}  $item  —— 待私有化 $done_n 个账号;共享库那份**保留**作新账号模板"
  plan_commit
}

# ---------- rollback ----------
_rb_target_ok() {   # RESTORE 的目标可以在 ACCTS_DIR 之外(迁移正是从共享库搬出来的),但必须落在这三处
  is_under "$1" "$ACCTS_DIR" && return 0
  is_under "$1" "$SHARED_STORE" && return 0
  { is_under "$1" "$LEGACY_HOME_DIR" && [ "$1" != "$LEGACY_HOME_DIR" ]; } && return 0
  return 1
}

cmd_rollback() {
  local ts=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --apply) APPLY=1; shift ;;
      -h|--help) usage; return 0 ;;
      -*) die "rollback:未知选项 $1" ;;
      *) [ -z "$ts" ] || die "rollback:多余参数 $1"; ts="$1"; shift ;;
    esac
  done
  cfg_finalize
  local bk="" d
  if [ -z "$ts" ] || [ "$ts" = latest ]; then
    shopt -s nullglob
    for d in "$ACCTS_DIR"/.backup-*; do
      [ -e "$d/.rolled-back" ] && continue     # 已消费过的跳过,免得重复回退空转
      bk="$d"
    done
    shopt -u nullglob
    [ -n "$bk" ] || die "找不到可用的备份($ACCTS_DIR/.backup-*;已回退过的不再计入)"
  else
    ts_check "$ts"                              # 只允许时间戳字符集:防 ../.. 目录穿越
    bk="$ACCTS_DIR/.backup-$ts"
    [ -d "$bk" ] || die "找不到备份:$bk"
  fi
  # 双保险:解析真实路径后必须仍在 ACCTS_DIR 之内
  is_under "$(real_of "$bk")" "$(real_of "$ACCTS_DIR")" || die "备份目录不在 $ACCTS_DIR 之内,拒绝:$bk"
  local undo="$bk/undo.tsv"
  [ -f "$undo" ] || die "备份不完整(缺 undo.tsv):$bk"

  info "${_c_bold}rollback${_c_reset}  备份=$bk"
  info ""
  info "将执行(与当初相反的顺序;先救数据再清垃圾):"
  local op p pass
  for pass in RESTORE DELETE; do
    while IFS=$'\t' read -r op p; do
      [ "$op" = "$pass" ] || continue
      case "$op" in
        RESTORE) info "  还原   $p  ${_c_dim}← $bk/root$p${_c_reset}" ;;
        DELETE)  info "  删除   $p  ${_c_dim}(当初新建的)${_c_reset}" ;;
      esac
    done < <(tac -- "$undo")
  done
  if [ "$APPLY" != 1 ]; then
    info ""
    info "${_c_dim}dry-run:以上均未执行。确认无误后重跑并加 --apply。${_c_reset}"
    return 0
  fi
  info ""
  local failed=0 pdir2 aside="$bk/pre-rollback"
  for pass in RESTORE DELETE; do
    while IFS=$'\t' read -r op p; do
      [ "$op" = "$pass" ] || continue
      # 每条都有自己的错误边界:一条失败绝不能挡住其余(尤其挡住"救数据"那些)
      case "$op" in
        RESTORE)
          if ! _rb_target_ok "$p"; then warn "跳过(还原目标越界):$p"; failed=1; continue; fi
          if [ ! -e "$bk/root$p" ] && [ ! -L "$bk/root$p" ]; then warn "跳过(备份里没有):$p"; failed=1; continue; fi
          pdir2="${p%/*}"; [ -n "$pdir2" ] || pdir2=/
          if [ -e "$p" ] || [ -L "$p" ]; then      # 现存的先挪进 pre-rollback/,不直接 rm
            mkdir -p -- "$aside$pdir2" 2>/dev/null || true
            mv -f -- "$p" "$aside$pdir2/" 2>/dev/null || { warn "无法挪开现存文件:$p"; failed=1; continue; }
          fi
          mkdir -p -- "$pdir2" 2>/dev/null || { warn "无法建目录:$pdir2"; failed=1; continue; }
          if cp -a -- "$bk/root$p" "$pdir2/" 2>/dev/null; then ok "还原 $p"
          else warn "还原失败:$p"; failed=1; fi
          ;;
        DELETE)
          if ! is_under "$p" "$ACCTS_DIR"; then warn "跳过删除(不在 $ACCTS_DIR 内):$p"; failed=1; continue; fi
          if rm -rf -- "$p" 2>/dev/null; then ok "删除 $p"
          else warn "删除失败:$p"; failed=1; fi
          ;;
        *) warn "未知 undo 操作:$op $p"; failed=1 ;;
      esac
    done < <(tac -- "$undo")
  done
  info ""
  if [ "$failed" = 1 ]; then
    warn "部分条目未能处理(见上面的 warn)。备份仍在 $bk,修掉原因后可重跑本命令。"
    return 1
  fi
  : >"$bk/.rolled-back"
  ok "已回退到 $bk 之前的状态"
  info "  ${_c_dim}备份目录保留(含凭据副本);确认无误后可自行删除:rm -rf '$bk'${_c_reset}"
  [ -d "$aside" ] && info "  ${_c_dim}被覆盖的现场文件挪到了:$aside${_c_reset}"
  return 0
}

# ---------- run ----------
cmd_run() {
  local name="${1-}"
  [ -n "$name" ] || die "用法:$SELF run <名> [-- <启动器参数>]"
  shift
  [ "${1-}" = "--" ] && shift
  cfg_finalize; need_manifest; manifest_load
  # Z01:起账号 0 = **什么都不设**。用 `env -u` 而不是不加 env —— 调用者的环境里
  # 很可能已经有 CLAUDE_CONFIG_DIR(比如从 `run z` 起的 shell 里再跑这条),不摘掉就串号了。
  # **绝不写 CLAUDE_CONFIG_DIR=""**:空值 ≠ 未设,Claude Code 会拿空串当路径。
  if [ "$name" = "$ACCOUNT_ZERO_NAME" ]; then
    have "$LAUNCHER" || die "找不到启动器:$LAUNCHER"
    acct_zero_logged || warn "账号 0 尚未登录(共享库无 .credentials.json),起来后请 /login"
    exec env -u CLAUDE_CONFIG_DIR "$LAUNCHER" "$@"
  fi
  local idx cfgdir
  idx="$(mf_index "$name")" || die "没有这个账号:$name(用 $SELF list 看)"
  cfgdir="$(mf_field "$idx" 3)"
  acct_dir_ok "$cfgdir" || die "config-dir 不在受控范围内:$cfgdir"
  [ -d "$cfgdir" ] || die "config-dir 不存在:$cfgdir(跑 $SELF verify)"
  have "$LAUNCHER" || die "找不到启动器:$LAUNCHER"
  # Z04:这是工具**自己**去产生 `CLAUDE_CONFIG_DIR=<共享库>` 那个环境的唯一一处。
  # 不禁(in-place 是被支持的逃生口,禁了它就没法用了),但把代价说在前面。
  [ "$cfgdir" = "$SHARED_STORE" ] && warn "$name 是 in-place(V1) 账号:这会设 CLAUDE_CONFIG_DIR=$SHARED_STORE,\
它的 .claude.json 与账号 0 的($LEGACY_HOME_DIR/.claude.json)是**两份**。要一份状态请迁到 V2"
  [ -f "$cfgdir/.credentials.json" ] || warn "$name 尚未登录,起来后请在里面 /login"
  exec env CLAUDE_CONFIG_DIR="$cfgdir" "$LAUNCHER" "$@"
}

# ---------- shellinit ----------
cmd_shellinit() {
  cfg_finalize; need_manifest; manifest_load
  local rec n c d def_cfg="" defname self_path
  self_path="$_LIBDIR/$SELF"
  if defname="$(mf_default_name)"; then
    def_cfg="$(mf_field "$(mf_index "$defname")" 3)"
  else
    warn "manifest 里没有默认账号 —— 不会产出 export CLAUDE_CONFIG_DIR(裸 claude 将找不到凭据)。"
  fi
  printf '# ===== BEGIN cc-acct-iso =====\n'
  printf '# 由 "%s shellinit" 生成 —— 贴进 ~/.bashrc(并删掉旧的 swap 式切号块)\n' "$SELF"
  if [ -n "$def_cfg" ]; then
    printf '# 裸 claude 走默认账号(全迁后必需,否则找不到凭据)\n'
    printf 'export CLAUDE_CONFIG_DIR=%q\n' "$def_cfg"
  fi
  # Z01:上面那行 `export CLAUDE_CONFIG_DIR=<默认>` 是**全局**的 ⇒ 之后这个 shell 里
  # 再没有回到账号 0 的路。给它一个逃生口。**`env -u` 不是 `=""`**(空值 ≠ 未设)。
  printf '%scc() { env -u CLAUDE_CONFIG_DIR command %q "$@"; }   # 账号 0(不设 CLAUDE_CONFIG_DIR)\n' \
    "$ACCOUNT_ZERO_NAME" "$LAUNCHER"
  for rec in ${MF[@]+"${MF[@]}"}; do
    IFS="$MF_SEP" read -r n _ c d <<<"$rec"
    case "$n" in *[!A-Za-z0-9_]*) printf '# (跳过 %s:名字不能做 shell 函数名)\n' "$n"; continue ;; esac
    printf '%scc() { CLAUDE_CONFIG_DIR=%q command %q "$@"; }   # %s\n' \
      "$n" "$c" "$LAUNCHER" "$([ "$d" = true ] && printf '默认账号' || printf '账号 %s' "$n")"
  done
  printf 'alias cc-acct-iso=%q\n' "$self_path"
  printf '# ===== END cc-acct-iso =====\n'
}

# ---------- main ----------
main() {
  cfg_load
  APPLY=0            # 配置文件是被 source 的:绝不允许它(哪怕写一行 APPLY=1)废掉 dry-run 保护
  local args=() a cmd="" got_cmd=0
  while [ $# -gt 0 ]; do
    a="$1"
    case "$a" in
      --shared-store) [ -n "${2-}" ] || die "--shared-store 需要路径"; SHARED_STORE="$2"; shift 2 ;;
      --accts-dir)    [ -n "${2-}" ] || die "--accts-dir 需要路径";    ACCTS_DIR="$2";    shift 2 ;;
      --launcher)     [ -n "${2-}" ] || die "--launcher 需要命令名";   LAUNCHER="$2";     shift 2 ;;
      --apply)        APPLY=1; args+=("$a"); shift ;;     # 命令前后都接受
      --) while [ $# -gt 0 ]; do args+=("$1"); shift; done ;;
      *)
        if [ "$got_cmd" = 0 ]; then cmd="$a"; got_cmd=1; else args+=("$a"); fi
        shift ;;
    esac
  done
  set -- "${args[@]+"${args[@]}"}"

  case "$cmd" in
    init)      cmd_init "$@" ;;
    add)       cmd_add "$@" ;;
    rm)        cmd_rm "$@" ;;
    list|ls)   cmd_list "$@" ;;
    which|who) cmd_which "$@" ;;
    verify)    cmd_verify "$@" ;;
    sync)      cmd_sync "$@" ;;
    isolate)   cmd_isolate "$@" ;;
    rollback)  cmd_rollback "$@" ;;
    run)       cmd_run "$@" ;;
    shellinit) cmd_shellinit "$@" ;;
    config)    cfg_finalize; cfg_dump ;;
    help|-h|--help|"") usage ;;
    *) die "未知命令:$cmd(看 $SELF help)" ;;
  esac
}

main "$@"

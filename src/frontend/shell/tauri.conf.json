{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cc-monitor",
  "version": "5.0.1",
  "identifier": "com.ccmonitor.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:24174",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../../.build/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "cc-monitor",
        "width": 1100,
        "height": 800,
        "decorations": true,
        "transparent": false,
        "focus": false,
        "backgroundColor": "#2b2a27"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "cc-monitor",
    "copyright": "Copyright © 2026 cc-monitor contributors",
    "category": "DeveloperTool",
    "shortDescription": "把各台机器上的 Claude Code 会话收进一个窗口",
    "longDescription": "cc-monitor 把本机与 SSH 远端机器上的 Claude Code 会话收进一个窗口：实时显示对话与工具调用（Markdown / LaTeX / 代码高亮 / 工具调用折叠卡），在消息流里答批准 · 提问 · 计划，起 · 恢复 · 分叉会话，多账号与额度轮换，远端机器的文件管理；配套 Android 手机端。Windows 10 / 11 · Linux。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["SimpChinese", "English"],
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine"
      }
    }
  }
}

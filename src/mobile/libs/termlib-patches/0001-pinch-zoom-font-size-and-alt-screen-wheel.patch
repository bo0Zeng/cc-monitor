+/**
+ * Folds a completed pinch-to-zoom gesture into a persistent font size.
+ *
+ * The transient visual zoom scale accumulated during the gesture is applied to the
+ * current font size and clamped into the allowed range, producing the size the
+ * terminal should re-layout with once the gesture ends.
+ *
+ * @param currentSp Current font size in sp
+ * @param zoomScale Accumulated zoom scale at gesture end (1f = no change)
+ * @param minSp Minimum allowed font size in sp
+ * @param maxSp Maximum allowed font size in sp
+ */
+@VisibleForTesting
+internal fun applyPinchZoomToFontSize(
+    currentSp: Float,
+    zoomScale: Float,
+    minSp: Float,
+    maxSp: Float,
+): Float = (currentSp * zoomScale).coerceIn(minSp, maxSp)
+
+/**
+ * Converts accumulated vertical swipe distance into whole mouse-wheel clicks,
+ * one step per character-row of travel.
+ *
+ * Truncates toward zero so partial rows stay in the caller's accumulator and carry
+ * over into the next event. A positive result means the finger moved down, i.e. the
+ * content should scroll toward earlier output (wheel-up), matching the direction of
+ * primary-screen scrollback.
+ *
+ * @param accumulatedPx Accumulated vertical finger travel in pixels
+ * @param charHeightPx Height of one character row in pixels
+ */
+@VisibleForTesting
+internal fun scrollDeltaToWheelSteps(accumulatedPx: Float, charHeightPx: Float): Int = if (charHeightPx <= 0f) 0 else (accumulatedPx / charHeightPx).toInt()

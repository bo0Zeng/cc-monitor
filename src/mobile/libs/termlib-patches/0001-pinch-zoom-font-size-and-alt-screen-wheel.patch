+package org.connectbot.terminal
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+// Steps drive alt-screen mouse-wheel reporting only; when the app has not enabled
+// mouse tracking the caller discards the accumulator and sends nothing (no arrow-key
+// fallback), so the step math below is used solely to pace wheel events.
+class ScrollWheelStepsTest {
+
+    @Test
+    fun lessThanOneRow_producesNoSteps() {
+        assertEquals(0, scrollDeltaToWheelSteps(accumulatedPx = 19.9f, charHeightPx = 20f))
+        assertEquals(0, scrollDeltaToWheelSteps(accumulatedPx = -19.9f, charHeightPx = 20f))
+    }
+
+    @Test
+    fun oneRowDown_producesOneStep() {
+        assertEquals(1, scrollDeltaToWheelSteps(accumulatedPx = 20f, charHeightPx = 20f))
+    }
+
+    @Test
+    fun oneRowUp_producesMinusOneStep() {
+        assertEquals(-1, scrollDeltaToWheelSteps(accumulatedPx = -20f, charHeightPx = 20f))
+    }
+
+    @Test
+    fun multipleRows_truncateTowardZero() {
+        assertEquals(3, scrollDeltaToWheelSteps(accumulatedPx = 79.9f, charHeightPx = 20f))
+        assertEquals(-3, scrollDeltaToWheelSteps(accumulatedPx = -79.9f, charHeightPx = 20f))
+    }
+
+    @Test
+    fun residualAfterConsumingSteps_carriesOver() {
+        // Simulates the gesture loop: consume whole steps, keep the remainder.
+        var accumulator = 0f
+        val charHeight = 20f
+        var events = 0
+        // Ten 7px drags = 70px total => 3 whole rows, 10px residual.
+        repeat(10) {
+            accumulator += 7f
+            val steps = scrollDeltaToWheelSteps(accumulator, charHeight)
+            if (steps != 0) {
+                accumulator -= steps * charHeight
+                events += steps
+            }
+        }
+        assertEquals(3, events)
+        assertEquals(10f, accumulator, 0.001f)
+    }
+
+    @Test
+    fun zeroOrNegativeCharHeight_isSafe() {
+        assertEquals(0, scrollDeltaToWheelSteps(accumulatedPx = 100f, charHeightPx = 0f))
+        assertEquals(0, scrollDeltaToWheelSteps(accumulatedPx = 100f, charHeightPx = -5f))
+    }
+}

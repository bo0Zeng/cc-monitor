+package org.connectbot.terminal
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class PinchZoomFontSizeTest {
+
+    @Test
+    fun zoomIn_scalesFontSizeUp() {
+        assertEquals(20f, applyPinchZoomToFontSize(currentSp = 10f, zoomScale = 2f, minSp = 6f, maxSp = 30f), 0.001f)
+    }
+
+    @Test
+    fun zoomOut_scalesFontSizeDown() {
+        assertEquals(7f, applyPinchZoomToFontSize(currentSp = 14f, zoomScale = 0.5f, minSp = 6f, maxSp = 30f), 0.001f)
+    }
+
+    @Test
+    fun identityScale_keepsFontSize() {
+        assertEquals(13f, applyPinchZoomToFontSize(currentSp = 13f, zoomScale = 1f, minSp = 6f, maxSp = 30f), 0.001f)
+    }
+
+    @Test
+    fun zoomIn_clampsToMax() {
+        assertEquals(30f, applyPinchZoomToFontSize(currentSp = 20f, zoomScale = 3f, minSp = 6f, maxSp = 30f), 0.001f)
+    }
+
+    @Test
+    fun zoomOut_clampsToMin() {
+        assertEquals(6f, applyPinchZoomToFontSize(currentSp = 8f, zoomScale = 0.5f, minSp = 6f, maxSp = 30f), 0.001f)
+    }
+
+    @Test
+    fun currentAlreadyOutsideBounds_isPulledBackIntoRange() {
+        // Defensive: if the current size somehow ends up outside min/max, the
+        // fold-in result is still clamped into the valid range.
+        assertEquals(30f, applyPinchZoomToFontSize(currentSp = 40f, zoomScale = 1f, minSp = 6f, maxSp = 30f), 0.001f)
+        assertEquals(6f, applyPinchZoomToFontSize(currentSp = 2f, zoomScale = 1f, minSp = 6f, maxSp = 30f), 0.001f)
+    }
+}

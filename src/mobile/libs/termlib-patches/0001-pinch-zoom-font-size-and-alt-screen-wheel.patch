+// Mouse wheel input handler
+bool Terminal::mouseWheel(bool up, int row, int col) {
+    std::scoped_lock lock(mLock);
+
+    if (!mVt) {
+        return false;
+    }
+
+    // Update libvterm's notion of the pointer position, then report a wheel
+    // button press (button 4 = wheel-up, 5 = wheel-down). libvterm encodes the
+    // event according to the mouse protocol the application negotiated
+    // (X10/UTF-8/SGR/rxvt) and emits it via the output callback. When the
+    // application has not enabled mouse reporting, libvterm produces no output
+    // at all, so this is safe to call unconditionally. Wheel buttons do not
+    // report release events.
+    vterm_mouse_move(mVt, row, col, VTERM_MOD_NONE);
+    vterm_mouse_button(mVt, up ? 4 : 5, true, VTERM_MOD_NONE);
+    return true;
+}

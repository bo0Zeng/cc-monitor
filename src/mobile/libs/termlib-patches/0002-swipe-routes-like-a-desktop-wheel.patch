 internal fun scrollDeltaToWheelSteps(accumulatedPx: Float, charHeightPx: Float): Int = if (charHeightPx <= 0f) 0 else (accumulatedPx / charHeightPx).toInt()
 
+/** Where a vertical swipe goes: the same three routes a desktop terminal uses for the mouse wheel. */
+internal enum class SwipeRoute {
+    /** The application enabled mouse reporting: report wheel events (tmux with `mouse on` enters copy-mode itself). */
+    WHEEL,
+
+    /** Alternate screen without mouse reporting: send cursor keys (xterm `alternateScroll`). */
+    ARROW_KEYS,
+
+    /** Neither: scroll the local scrollback buffer. */
+    SCROLLBACK,
+}
+
+/** Routes a vertical swipe like a desktop terminal routes the mouse wheel (see [SwipeRoute]). */
+@VisibleForTesting
+internal fun swipeRouteOf(altScreen: Boolean, mouseTracking: Boolean): SwipeRoute =
+    when {
+        mouseTracking -> SwipeRoute.WHEEL
+        altScreen -> SwipeRoute.ARROW_KEYS
+        else -> SwipeRoute.SCROLLBACK
+    }
+
+/**
+ * The cursor key xterm's `alternateScroll` sends for [steps] wheel clicks: finger moving down
+ * (positive) means earlier content, i.e. wheel-up, i.e. Up.
+ */
+@VisibleForTesting
+internal fun alternateScrollKey(steps: Int): Int = if (steps > 0) VTermKey.UP else VTermKey.DOWN
+

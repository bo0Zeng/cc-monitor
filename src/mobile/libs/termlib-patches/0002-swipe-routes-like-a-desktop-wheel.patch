+package org.connectbot.terminal
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+// A vertical swipe is handled the way a desktop terminal handles the mouse wheel:
+// mouse reporting on -> wheel events; alternate screen without mouse reporting ->
+// arrow keys (xterm alternateScroll); otherwise -> local scrollback.
+class SwipeRoutingTest {
+
+    @Test
+    fun mouseReportingOn_sendsWheelEvents() {
+        assertEquals(SwipeRoute.WHEEL, swipeRouteOf(altScreen = true, mouseTracking = true))
+        assertEquals(SwipeRoute.WHEEL, swipeRouteOf(altScreen = false, mouseTracking = true))
+    }
+
+    @Test
+    fun altScreenWithoutMouseReporting_sendsArrowKeys() {
+        assertEquals(SwipeRoute.ARROW_KEYS, swipeRouteOf(altScreen = true, mouseTracking = false))
+    }
+
+    @Test
+    fun primaryScreenWithoutMouseReporting_scrollsLocalScrollback() {
+        assertEquals(SwipeRoute.SCROLLBACK, swipeRouteOf(altScreen = false, mouseTracking = false))
+    }
+
+    @Test
+    fun arrowKeyDirection_followsWheelDirection() {
+        // Finger moves down (positive steps) -> earlier content -> Up, like wheel-up.
+        assertEquals(VTermKey.UP, alternateScrollKey(steps = 2))
+        assertEquals(VTermKey.DOWN, alternateScrollKey(steps = -1))
+    }
+}

#!/usr/bin/env python3
"""quota-warm：让各账号的 5h 窗口尽早开始计时。

读 `ccm -- --quota-read` 看每个号的 5h 重置时刻：
- 窗口在计时（重置时刻在将来）⇒ 不动，等它到点；
- 窗口已过期、或这台中转从没见过这个号的数 ⇒ 用这个号发一句最短的话，让窗口开始计时
  （在计时中的窗口不会因此被推后；没见过的号只有发一句才知道它此刻的状态）；
- 被拒（5h 或 7d 用满）⇒ 等到它重置；
- 登录失效 ⇒ 记一行，过一阵再看。

发法：调 cc-monitor 后端的 `ccm -- --quota-warm`（发那一句的做法只住后端一处，轮换判完开窗也走它），回包带回来的重置时刻。

用法：
  quota-warm status             只读：列出各号的重置时刻
  quota-warm once               跑一趟（该发的发）后退出
  quota-warm run                先跑一趟，之后按最早的重置时刻自己醒来再跑，一直跑
  选项：--accounts work,personal（不给 ⇒ quota-read 的 candidates：出过数的号 ＋ 账号库里没出过数的号）· --dry-run
"""

import argparse
import fcntl
import json
import os
import subprocess
import sys
import time
from datetime import datetime

HOME = os.path.expanduser("~")
CCM_HOME = os.path.join(HOME, ".cc-monitor")
CCM = os.path.join(CCM_HOME, "bin", "ccm")
LOG = os.path.join(CCM_HOME, "logs", "quota-warm.log")
LOCK = os.path.join(CCM_HOME, "quota-warm.lock")

RETRY_S = 15 * 60      # 发了没成 / 读不到额度账 ⇒ 过这么久再试
SEND_TIMEOUT_S = 150   # 后端那一发自己的期限是 120 秒
SLEEP_CHUNK_S = 600    # 长睡分段：机器休眠醒来后按真实时刻重算


def stamp(t=None):
    t = time.time() if t is None else t
    d = datetime.fromtimestamp(t)
    return d.strftime("%H:%M") if d.date() == datetime.now().date() else d.strftime("%m-%d %H:%M")


def log(msg):
    line = f"{datetime.now().strftime('%Y-%m-%d %H:%M:%S')} {msg}"
    print(line, flush=True)
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        with open(LOG, "a", encoding="utf-8") as f:
            f.write(line + "\n")
    except OSError:
        pass


def quota_read():
    p = subprocess.run(
        # 不带 `--tz` ⇒ 回包里的「几点」按这台的钟写。
        [CCM, "--", "--quota-read"],
        cwd=HOME, capture_output=True, text=True, timeout=60,
    )
    if p.returncode != 0:
        raise RuntimeError(f"quota-read 退出码 {p.returncode}: {p.stderr.strip()[:200]}")
    d = json.loads(p.stdout)
    return d.get("data", d)


def judge(q, name):
    """一个号此刻怎么办 ⇒ (动作, 醒点, 说明)。判定在 cc-monitor 核心（quota-read 每号的 `warm`），这里只照抄。"""
    entry = next(
        (a for a in q.get("accounts", []) + q.get("unseen", []) if a.get("account") == name), None
    )
    if entry is None:
        return "skip", None, "这台账号库里没有这个号"
    w = entry.get("warm") or {}
    at = w.get("at")
    return w.get("act", "skip"), at, w.get("text", "")


def send(name):
    """后端那一条命令发一句 ⇒ (回来的重置时刻 或 None, 说明)。"""
    try:
        p = subprocess.run(
            [CCM, "--", "--quota-warm"],
            input=json.dumps({"agent": "claude", "account": name}),
            cwd=HOME, capture_output=True, text=True, timeout=SEND_TIMEOUT_S,
        )
    except subprocess.TimeoutExpired:
        return None, "超时"
    if p.returncode != 0:
        try:
            e = json.loads(p.stderr.strip().splitlines()[-1])
            return None, f"{e.get('code')}：{e.get('said')}"
        except (ValueError, IndexError, AttributeError):
            return None, f"退出码 {p.returncode}，回包读不懂"
    try:
        d = json.loads(p.stdout)
    except ValueError:
        return None, "回包读不懂"
    at = d.get("resets_at")
    return at, ("发了" if d.get("sent") else "15 分钟内发过") + (f" ⇒ ↻{stamp(at)}" if at else "")


def candidates(q):
    """不给 --accounts 时看哪几个号：照 quota-read 的 `candidates`（出过数的 ＋ 账号库里没出过数的，核心挑好），不另扫账号库。"""
    seen = []
    for c in q.get("candidates", []):
        n = c.get("account")
        if n and n not in seen:
            seen.append(n)
    return seen


def one_pass(accounts, dry_run):
    """跑一趟，回下一次该醒的时刻。`accounts` 为空 ⇒ 这一趟照额度账的候选。"""
    try:
        q = quota_read()
    except Exception as e:  # noqa: BLE001 —— 读不到就过一阵再试，不让常驻那一形死掉
        log(f"读额度账失败：{e}")
        return time.time() + RETRY_S
    wakes = []
    for name in accounts or candidates(q):
        action, at, why = judge(q, name)
        if action == "send":
            if dry_run:
                log(f"{name}: {why} ⇒ 该发（--dry-run，没发）")
                continue
            at, info = send(name)
            if at and at > time.time():
                log(f"{name}: {why} ⇒ {info}")
                wakes.append(at + 60)
            else:
                log(f"{name}: {why} ⇒ 没成（{info}）⇒ {stamp(time.time() + RETRY_S)} 再试")
                wakes.append(time.time() + RETRY_S)
        elif action == "wait":
            log(f"{name}: {why}")
            wakes.append(at)
        else:
            log(f"{name}: {why}，跳过")
    return min(wakes) if wakes else None


def status(accounts):
    q = quota_read()
    for name in accounts or candidates(q):
        action, at, why = judge(q, name)
        print(f"{name:10} {why}" + ("  ⇒ 该发" if action == "send" else ""))


def hold_lock():
    os.makedirs(CCM_HOME, exist_ok=True)
    f = open(LOCK, "w")
    try:
        fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        sys.exit("另一个 quota-warm 正在跑（锁：%s）" % LOCK)
    f.write(str(os.getpid()))
    f.flush()
    return f


def main():
    ap = argparse.ArgumentParser(description="让各账号的 5h 窗口尽早开始计时")
    ap.add_argument("mode", choices=["status", "once", "run"])
    ap.add_argument("--accounts", help="逗号分隔的账号名（不给 ⇒ 额度账的候选：出过数的 ＋ 账号库里没出过数的）")
    ap.add_argument("--dry-run", action="store_true", help="只判、不发")
    a = ap.parse_args()
    accounts = [x for x in (a.accounts or "").split(",") if x]
    if a.mode == "status":
        status(accounts)
        return
    lock = hold_lock()  # noqa: F841 —— 进程活着就一直持着
    log(f"开始（{a.mode}）：{', '.join(accounts) or '额度账的候选'}")
    while True:
        wake = one_pass(accounts, a.dry_run)
        if a.mode == "once":
            return
        if wake is None:
            log("没有要看的号，退出")
            return
        wake = max(wake, time.time() + 30)
        log(f"下次 {stamp(wake)}")
        while (left := wake - time.time()) > 0:
            time.sleep(min(left, SLEEP_CHUNK_S))


if __name__ == "__main__":
    main()

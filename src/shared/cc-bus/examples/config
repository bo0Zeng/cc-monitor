# cc-bus 配置示例 —— 复制到 ~/.cc-bus/config 并按需改。全部键都有内置默认,缺文件/缺键 = 用默认。
# 这是 sourceable 的 KEY=VAL,不要写引号外的空格。范围(谁送得到谁)由组定,不在这里配。

# —— 敲门 ——
CCBUS_NUDGE_DEBOUNCE=2      # 同一收件人两次敲门最小间隔秒

# —— 限流(防风暴只靠它,opt-in,默认 0=关)——
# CCBUS_RATE_PAIR=0         # 每 (from,to) 每窗口最大条数,0=不限
# CCBUS_RATE_GLOBAL=0       # 全局每窗口最大条数(熔断),0=不限
# CCBUS_RATE_WINDOW=60      # 限流窗口秒
#
# —— 推荐 ——
#   CCBUS_RATE_PAIR=12       # 同一对话最多 12 条/分钟,足够正常来回、挡住失控回环
#   CCBUS_RATE_GLOBAL=60     # 全网 60 条/分钟熔断
# 改本文件即时生效:每发一封都读一次。

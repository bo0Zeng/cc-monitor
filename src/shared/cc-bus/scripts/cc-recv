#!/usr/bin/env bash
# cc-recv [id]  读取本 agent 自上次以来的新消息,并推进"已读位置"(唯一消费入口)
set -euo pipefail
BUS="${CC_BUS_HOME:-$HOME/.cc-bus}"
SELFDIR=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
# shellcheck source=cc-bus-lib.sh
. "$SELFDIR/cc-bus-lib.sh"
ccbus_migrate_once || true                # 旧收件箱迁一次(迁过就是一次 stat)
if [ -n "${1:-}" ]; then id="$1"; else id=$("$SELFDIR/cc-whoami"); fi   # 无参则自动认领身份
case "$id" in *[!A-Za-z0-9_-]*|'') echo "cc-recv: 非法/空 id '$id'" >&2; exit 2;; esac
inbox="$BUS/inbox/$id.jsonl"
posf="$BUS/state/$id.pos"
[ -f "$inbox" ] || exit 0
(
  flock 9
  # 用 awk 计行数:把"末行无结尾换行"也计入,与下面 sed 取行范围口径一致
  total=$(awk 'END{print NR}' "$inbox")
  pos=$(cat "$posf" 2>/dev/null || echo 0)
  [[ "$pos" =~ ^[0-9]+$ ]] || pos=0          # pos 被截断/损坏时归零自愈,别静默失效
  [ "$pos" -le "$total" ] || pos=0           # inbox 被外部清空/截短而 pos 仍高 → 归零,别永远收不到
  if [ "$total" -gt "$pos" ]; then
    new=$(sed -n "$((pos+1)),\$p" "$inbox")
    # 显示:fromjson? 跳过非法 JSON 坏行(防毒丸卡死)。给 agent 读的那一段只印线上码(act · tier),不放显示用的词。
    printf '%s\n' "$new" \
      | jq -Rr 'fromjson? // empty | "[cc-bus] id=\(.id // "-") from=\(.from // "?") ts=\(.ts // "?") tier=\(.tier // "?") act=\(.act // "?")\(if .re then " re=\(.re)" else "" end)\ntitle: \(.title // "")\(if ((.refs // []) | length) > 0 then "\nrefs: \(.refs | join(" "))" else "" end)\n\(.text // "")\n(reply: cc-send \(.from // "?") --act answer --re \(.id // "-") --title \"…\")\n"'
    # ★★ **读不懂的行照跳，但要说一句**〔08-13 实测〕
    #
    # 上面那个 `fromjson? // empty` 会静默丢掉解析不了的行（防毒丸卡死,那是对的),
    # 而下面 `echo "$total" > "$posf"` **照样把已读位置推过去** ⇒ 那条消息**永远读不到了**,
    # 且**没有任何地方提过这件事**。实测:收件箱 3 行(中间一行是半截 JSON),
    # 显示 2 条、位置推到 3、一个字的提示都没有。
    #
    # ⚠ 丢弃本身不改（毒丸不能卡住整条收件箱）——改的是**沉默**：
    # 数一下跳了几条，把行号范围说出来，人才有得查。
    _seen=$(printf '%s\n' "$new" | grep -c . || true)
    _ok=$(printf '%s\n' "$new" | jq -Rr 'fromjson? // empty | .id // "-"' 2>/dev/null | grep -c . || true)
    if [ "${_seen:-0}" -gt "${_ok:-0}" ]; then
      printf '⚠ 跳过 %s 条读不懂的消息（收件箱 %s 的第 %s..%s 行，它们不会再出现）\n' \
        "$(( _seen - _ok ))" "$inbox" "$((pos+1))" "$total"
    fi
    echo "$total" > "$posf"
  fi
) 9>>"$inbox.lock"

#!/usr/bin/env bash
# cc-bus <动词> [参数…] —— cc-bus 唯一的入口(PATH 上只有它)。
#   每个动词的本体是同目录的 `cc-bus-<动词>.sh`(被这里调,不进 PATH),每一条只是把一句交给 cc-monitor 后端;
#   `recv` 就是这里把 peek 接上 commit,不另写渲染。
#   退出码照各动词;不认识的动词 · 没给动词 ⇒ 2。
set -uo pipefail
SELFDIR=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)

usage() {
  cat <<'EOF'
用法:cc-bus <动词> [参数…]
  send      <会话 id> --act <码> --title <一行> [--tier 1|2] [--re <消息 id>] [--ref <引用>]… [--] [正文…|-]
  recv      [<会话 id>]                          读新消息并推进已读位置(= peek 接 commit)
  peek      [<会话 id>] [--max-lines N] [--token-file <路径>]   纯读,令牌走 stderr 或那份文件
  commit    <会话 id> <令牌>                     确认,推进已读位置
  list                                           各收件箱:会话 id · 在不在 · 待读 · 标题
  whoami                                         这是哪条会话(问 cc-monitor)
  unread    [<会话 id>]                          未读几条(只读)
  log       <会话 id> [-n N]                     只读看收件箱尾巴
  stop-hook                                      Stop 钩子(接进 agent 的设置)
EOF
}

verb="${1:-}"
[ $# -gt 0 ] && shift
case "$verb" in
  send|peek|commit|list|whoami|unread|log|stop-hook)
    exec "$SELFDIR/cc-bus-$verb.sh" "$@" ;;
  recv)
    [ $# -le 1 ] || { echo "cc-bus recv: 多给了参数" >&2; exit 2; }
    id="${1:-}"
    [ -n "$id" ] || id=$("$SELFDIR/cc-bus-whoami.sh") || exit 1
    tf=$(mktemp) || exit 1
    trap 'rm -f "$tf"' EXIT
    "$SELFDIR/cc-bus-peek.sh" "$id" --token-file "$tf" || exit $?
    [ -s "$tf" ] || exit 0                # 没有新消息
    "$SELFDIR/cc-bus-commit.sh" "$id" "$(cat "$tf")"; rc=$?
    # 11 = 有人替我推过了:手上这段照常印出来了,不算错。
    case "$rc" in 0|11) exit 0 ;; *) exit "$rc" ;; esac ;;
  help|-h|--help) usage; exit 0 ;;
  '') usage >&2; exit 2 ;;
  *) echo "cc-bus: 不认识的动词 '$verb'" >&2; usage >&2; exit 2 ;;
esac

#!/usr/bin/env bash
# cc-spawn [--tool claude|codex] <目录> [初始任务...]  在该目录开一个独立 claude 或 codex 会话、自动上总线、返回其 id。
# 产物是【独立历史 + 原生读该目录文件】的长驻协作 agent(区别于 subagent:同上下文、一次性)。
# 收掉用 cc-kill <id>;看它用 tmux attach -t <id>;跟它聊用 cc-send <id> "..."。
set -euo pipefail
# ⚠ `CC_BUS_HOME` 这里**不再读**:三件全搬进 ccm 之后,本脚本不碰总线目录了。
#   它仍然要**原样传下去**(env 继承) —— ccm 调的 cc-register/cc-spawned-record 认这个变量。
# ⚠ 〔`K-R48` 第二拍 09-11〕`SELFDIR` **删了**:它唯一的用途是拼 `$SELFDIR/../../ccm`
#   去找仓内那个 bash 脚本,而那个文件今天不存在了(见下面查找次序那段)。
#   留一个没人读的变量比删掉更坏 —— 下一个人会以为本脚本还按「自己住哪」找东西。
# 旗标可在 <目录> 前任意顺序出现。
tool=""
acct=""
use_base=0
while true; do
  case "${1:-}" in
    --new)  shift;;                                               # P4b 后**默认就是新建**,本旗标是 no-op。保留它是因为外面可能有人在传——让它报错等于把别人的脚本弄坏
    --tool) tool="${2:-}"; shift 2 2>/dev/null || { echo "cc-spawn: --tool 需要参数(claude|codex)" >&2; exit 2; };;  # 派生哪个 CLI
    # L2(unify-launch B03 审计):显式指定账号。**不加这个的话** ccm 会落 manifest 的默认号,
    # 于是从驾驶舱点两下就在默认账号上起真 agent 烧额度,而用户无从选择也无从得知用了哪个号。
    # ccm 本来就支持 --account/--base,这里只是转发——**不改 ccm 本体**(账本红线)。
    --account) acct="${2:-}"; shift 2 2>/dev/null || { echo "cc-spawn: --account 需要参数" >&2; exit 2; };;
    --base) use_base=1; shift;;   # 显式不注入任何账号(issue #75 的同款逃生口)
    --)     shift; break;;
    *)      break;;
  esac
done
# ⚠ 用法串里**不再宣传 `--new`**:它今天是 no-op(默认就是新建),宣传一个什么都不做的旗标
#   等于让人以为不加它会有别的行为。旗标本身仍然接受,见上面的 case 臂。
dir="${1:?用法: cc-spawn [--tool claude|codex] <目录> [初始任务...]}"; shift || true
task="$*"

# 定 tool:显式 --tool > 从 CCSPAWN_LAUNCH basename 推断 > 默认 claude(向后兼容)。
if [ -z "$tool" ]; then
  case "$(basename "${CCSPAWN_LAUNCH:-claude}")" in *codex*) tool=codex;; *) tool=claude;; esac
fi
case "$tool" in claude|codex) ;; *) echo "cc-spawn: 未知 --tool '$tool'(应为 claude|codex)" >&2; exit 2;; esac
[ -n "$acct" ] && [ "$use_base" = 1 ] && { echo "cc-spawn: --account 与 --base 互斥" >&2; exit 2; }
# 启动器:CCSPAWN_LAUNCH 覆盖;否则按 tool 取默认。(可测性钩子:测试时设 mock 命令免起真 CLI)
LAUNCH="${CCSPAWN_LAUNCH:-$tool}"

# ★★ `K-R48` 第二拍(09-11):**`ccm` 不再是一个脚本,它就是后端二进制。**
#    〔用@09-11 `K33`〕逐字「后端**只有一个**…**不要有什么 bash 脚本**,**不要有什么单独的 ccm**。
#    **所有命令只许有一处**,其他都是**根据传参来调用**」。
#    ⇒ 原来这里找的是 `$SELFDIR/../../ccm`(仓里那个 1592 行的 bash 脚本、部署形态下
#    落在 `~/.claude/skills/ccm`)。**那个文件今天不存在了**,查找规则整条换成找后端。
#
#    **查找次序**:`$CCM_BIN`(显式) → 部署落点 `~/.cc-monitor/bin/` → PATH 上的
#    `cc-monitor-remote` → PATH 上的 `ccm`(给「已经把后端软链成 `ccm`」的人用)。
#    🔴 **刻意不认 `$CCM_DAEMON_BIN`**:那个变量在仓里的 e2e 夹具里指的是**假 daemon**
#    (`tests/e2e/fake-daemon.sh` 这一族,只会答几条 wire 子命令),拿它当 CLI 叫会得到一个
#    「答得出话、干不了活」的东西 —— 那正是本仓最贵的一类假信号。显式覆盖走 `CCM_BIN`。
#    ⚠ **必须 `-f` 而不能只 `-x`**:`[ -x <目录> ]` 为真,而查找次序里那几档都可能是目录
#    (历史实测:`~/.claude/skills/` 下全是目录,装个名叫 `ccm` 的 skill 就会劫持解析)。
#    `CCM_BIN` 可显式覆盖(测试钩子),语义一个字没变。
CCM_BIN="${CCM_BIN:-}"
if [ -z "$CCM_BIN" ]; then
  for _x in "$HOME/.cc-monitor/bin/cc-monitor-remote" \
            "$(command -v cc-monitor-remote 2>/dev/null)" \
            "$(command -v ccm 2>/dev/null)"; do
    if [ -n "$_x" ] && [ -f "$_x" ] && [ -x "$_x" ]; then CCM_BIN="$_x"; break; fi
  done
  unset _x
  [ -n "$CCM_BIN" ] || {
    echo "cc-spawn: 找不到后端(~/.cc-monitor/bin/cc-monitor-remote / PATH 上的 cc-monitor-remote 或 ccm 都没有)" >&2
    echo "  后端由 cc-monitor 客户端自己释放到 ~/.cc-monitor/bin/;或用 CCM_BIN=<路径> 显式指定。" >&2
    exit 2; }
fi

# **怎么把它当 `ccm` 叫**:后端认两条入口,都只经 `control::ccm::intercept` ——
#   ① `argv[0]` 的 basename 是 `ccm`(别名/软链指过来);② `cc-monitor-remote ccm <argv…>`。
# 找到的那份 basename 不是 `ccm` 时走②。**这不是两套实现**,是同一处解析的两条入口。
ccm_prefix=("$CCM_BIN")
case "$(basename "$CCM_BIN")" in
  ccm|ccm.exe) ;;
  *) ccm_prefix+=(ccm) ;;
esac

# **能力协商**(B02 审计重要-7):cc-spawn 硬依赖 `--detach` 等四项,而用户盘上 PATH 前面
# 完全可能还躺着一份**旧的 bash `ccm` 副本**(`~/.local/bin/ccm`,实测那份就没有 --detach)。
# 不检查的话报出来的是 `ccm: 未知选项: --detach` + `建会话失败`,把"版本太旧"说成"建会话失败"。
# ⚠ 〔`K-R48` 第二拍〕**这道闸今天比从前更要紧**:查找次序末档就是 PATH 上的 `ccm`,
#   而那正是旧副本最可能待的地方 —— 它是今天唯一挡得住旧副本的东西。
# ⚠ **刻意仍按能力协商、不按 `version=` 比大小**:那个号今天是个裸串、没有单调性契约
#   (`K-R48` `§0-Bx-3㈥` 逐条记着这笔账,归 `KR48D3`)。能力集是**有**契约的那一份。
# ⚠⚠ **`|| true` 不许省**〔`K-R48` 第二拍 09-11 实测逮到〕:本文件开头是 `set -euo pipefail`,
#   而**探针失败恰恰是这道闸要处理的那一格**。旧写法能活下来只是因为当时探的那份
#   总是 rc=0(它认得 `--ccm-probe`);今天走②那条入口时,一份不认 `ccm` 子命令的旧副本
#   会 rc≠0 ⇒ `pipefail` 把整条赋值判成失败 ⇒ `set -e` **当场静默退出**,
#   下面那句「版本太旧」一个字都印不出来。**把诊断掐死在诊断之前**,正是本闸要治的病本身。
_caps=$("${ccm_prefix[@]}" --ccm-probe 2>/dev/null | sed -n 's/^capabilities=//p') || true
for _c in detach tmux-size tmux-base bus-register; do
  case ",$_caps," in
    *",$_c,"*) ;;
    *) echo "cc-spawn: ccm 版本太旧,缺能力 '$_c'($CCM_BIN)。" >&2
       echo "  今天的 ccm 就是后端本体(cc-monitor 客户端会把它释放到 ~/.cc-monitor/bin/)。" >&2
       echo "  PATH 上那份多半是旧的 bash 副本:要么把它挪开,要么 CCM_BIN=<后端路径> 显式指定。" >&2
       exit 2 ;;
  esac
done
unset _caps _c

# 向后兼容:预信任的可测性钩子改名了(cc-spawn 的 CCSPAWN_* → ccm 的 CCM_*)。
# 收编后若不映射,任何还在设 CCSPAWN_CLAUDEJSON 来**保护真实 ~/.claude.json** 的外部
# 测试/脚本会静默失效并**直接写真文件**——静默丢失一个安全钩子比丢功能更坏。
# 只在对应的 CCM_* 未设时映射,不覆盖显式设置。
[ -n "${CCSPAWN_CLAUDEJSON:-}" ] && [ -z "${CCM_CLAUDEJSON:-}" ] && export CCM_CLAUDEJSON="$CCSPAWN_CLAUDEJSON"
[ -n "${CCSPAWN_CODEXTOML:-}" ] && [ -z "${CCM_CODEXTOML:-}" ] && export CCM_CODEXTOML="$CCSPAWN_CODEXTOML"

# 1. 绝对路径 + 校验目录存在
absdir=$(cd "$dir" 2>/dev/null && pwd) || { echo "cc-spawn: 目录不存在: $dir" >&2; exit 2; }

# 2. 派生会话名 = <basename>_cc(消毒 + strip 首尾 -,与 cc-whoami resolve 对齐)
bn=$(basename "$absdir")
base="$(printf '%s' "$bn" | tr -c 'A-Za-z0-9_-' '_' | sed 's/^-*//; s/-*$//')_cc"

# ★★ P4b（C14〔用 08-12〕）:**spawn 就是起,就是 creat** —— 默认复用整个删掉。
#
# 原来这里是「到就用、没有才建」:同目录已有活会话(且非 --new)就复用它。用户逐字裁定
# 「**所有起会话就是起会话. attach就是attach, 不要or / 分离开 / spawn就是起, 就是creat**」
# 与「**cc-spawn 不应该复用活会话**」。
#
# ⚠ 这是那个 `or` 的**第四份**实现:P3s 数出两份(ccm 的、TS 的),P4d 的冒烟又撞出
# daemon 的 wire mode(第三份),这里是第四份。「我数完了」这句话在这个仓里已经错过三次。
#
# 命名避让**必须留着**:不复用 ≠ 不避让。同名直接建会撞上别人的会话,
# 那正是 C14 要消灭的东西的另一面。
# ★★ 而 08-13(C15〔用「cc-bus收进ccm」〕)起,避让**住进 ccm 了** —— 见下面 `--tmux-base`。

# 3. 建 detached 会话 + 送任务 —— **全部经 ccm**(unify-launch B02,闭合账本"起会话被写死成
#    N 套实现"那一行)。ccm 现在负责:建会话(--detach 只建不 attach)、窗口尺寸、预信任、
#    账号/env 注入、信任框轮询兜底、codex 的 CC_BUS_ID。
#    cc-spawn 只保留 cc-bus 专属的部分 —— C15 三件全搬完之后,**这里已经一件不剩**。
#
# ★★ C15〔用@08-13「cc-bus收进ccm」〕第一件:**命名避让搬进 ccm**(`--tmux-base=<基名>`)。
#    原来这里是 `while tmux has-session -t "=$name"; do name="$base-$k"; done`,自己探一遍
#    再把算好的名字用 `--tmux=<名>` 传进去。两条问题:
#      ① **同一个事实算两遍** —— 探名字的人与建会话的人不是同一个,而只有后者知道结果;
#      ② **探完到真建之间有窗口期** —— 别人可以在那一瞬插进来占掉这个名,而 P3sc 之后
#         显式 `--tmux=<名>` 撞名是**响亮失败**(exit 3),于是 cc-spawn 会以"建会话失败"收场。
#    ⇒ 改成把**基名**交给 ccm,由它避让并把最终名字用 `ccm-session=` 报回来(P4b① 的前置)。
#    cc-spawn 从此**不再有 tmux 会话名的算法**,只有 base 的派生规则(`<basename>_cc`,
#    与 `cc-whoami resolve` 对齐 —— 那是 cc-bus 的 id 规则,不是 tmux 的取名规则)。
#
#    删掉的原实现,逐条说明为什么不是回归:
#      · 预信任 46 行 → ccm F11 已上提,且比这里多修了绝对路径规范化(cwd_abs)与
#        CCM_NO_PRETRUST 逃生口(本脚本原先没有,收编后 cc-spawn 用户顺带获得)。
#      · 信任框轮询 12 行 → ccm 同款六轮 0.5s capture-pane,且额外尊重 CCM_NO_PRETRUST。
#      · CC_BUS_ID 手动注入 → ccm 的 agent_needs_bus_id 只对 codex 生效(同一判断、同一理由),
#        且它从 tmux 会话名自动派生,与这里原先注入的 $name 逐字相同(隔离 socket 实测确认)。
#      · `-x 220 -y 50` → 未丢,改由 `--tmux-size 220x50` 表达。
# **$LAUNCH 可能是多词命令行,必须分词**(B02 审计阻塞-2,实测复现)。
# 旧实现走 `send-keys "$LAUNCH ..."`,pane 里的 shell 会对 $LAUNCH **重新分词**,所以
# wrapper 形式一直可用——`cc-bus-install.sh:96` 就明文教用户
# `CCSPAWN_LAUNCH="codex --dangerously-bypass-hook-trust"` 做无人值守的钩子信任,
# 本脚本 :24 也还在按多词字符串推断 tool。而 ccm 的 `--launcher` 收的是**单个 argv[0]**
# (`argv=("$launcher")` → `exec "${argv[@]}"`),整串塞进去会被当成一个含空格的文件名,
# 结果是 `没有那个文件或目录` + 会话退回裸 bash,而 cc-spawn 却 rc=0、还把这个僵尸登上总线
# ——假成功比失败更坏(`cc-list` 显示在线,`cc-send` 石沉大海)。
#
# 等价还原:首词 → `--launcher`,余词 → `--` 透传的**最前面**,任务排在余词之后。
# `exec env VAR=x codex '<任务>'` 与旧的 `send-keys "env VAR=x codex '<任务>'"` 逐字同义。
# shellcheck disable=SC2206  # 这里的分词是**有意的**,正是要复刻旧 shell 的行为
launch_argv=($LAUNCH)
[ ${#launch_argv[@]} -gt 0 ] || { echo "cc-spawn: 启动器为空(CCSPAWN_LAUNCH?)" >&2; exit 2; }
ccm_args=(--tmux-base="$base" --detach --bus-register --tmux-size 220x50 --cwd "$absdir" --agent "$tool" --launcher "${launch_argv[0]}")
# ⚠ `--bus-note` **只在任务非空时给**:`need_val` 拒收空串(所有带值旗标同一条纪律),
#   `--bus-note ""` 会当场 die「--bus-note 需要一个值」。
#   ★ 首版就是无条件给的 —— **单测全绿、e2e 当场红四条**(1-5 号用例都带任务,
#   6/7/8 号不带)。判据钉得了「那个旗标在」,钉不了「不带任务时它还能跑」。
[ -n "$task" ] && ccm_args+=(--bus-note "$task")
# 账号:转发给 ccm(它已有 --account/--base,校验与解析都在那边,这里不重复实现)
[ -n "$acct" ] && ccm_args+=(--account "$acct")
[ "$use_base" = 1 ] && ccm_args+=(--base)
# 初始任务作为**位置参数**传给启动器(`exec <launcher> [启动器余下的词] '<任务>'`)。
passthru=("${launch_argv[@]:1}")
[ -n "$task" ] && passthru+=("$task")
[ ${#passthru[@]} -gt 0 ] && ccm_args+=(-- "${passthru[@]}")
# **名字由建它的人报**:ccm 在 `--detach` 时打一行 `ccm-session=<名>`(P4b①)。
# stdout 捕下来只为摘那一行,**其余原样转发**(不吞 ccm 将来可能打的任何东西)。
# ★★ 撞名要**重试**〔08-13 实测事故〕：4 个 cc-spawn 同时打进同一目录 ⇒ **只成 1 个**，
# 另外 3 个报「经 ccm 建会话失败」。
#
# 机理:避让是 `has-session` 探完再 `new-session`,**中间有窗口期**。`C15` 那次我写
# 「让建的人自己避让把窗口期关掉了」——**那句话是错的**:窗口只是从「cc-spawn 探完到 ccm 建」
# 搬到了「ccm 内部探完到建」,并没有消失。**已在账本订正。**
#
# 为什么重试是对的处置(而不是去 ccm 里改成运行期重试):
# · `--tmux-base` 的语义就是「**给我一个新的**」⇒ 撞了再要一次,语义上完全成立;
# · 而 ccm 那侧要改就得让**运行期**才知道最终名字,`--print` 的黄金串(A′ 组钉着)与
#   `ccm-session=` 的时机都会跟着变 —— 代价远大于收益;
# · 显式 `--tmux=<名>` 那条**不该**重试(调用方就要那个名,撞了是真错,`P3sc` 的 exit 3 是对的)。
#   ⇒ 重试只属于**要基名**的这条路,也就是这里。
#
# ⚠ 只对 **exit 3**(撞名)重试:别的失败(ccm 没装、参数错、预信任炸了)重试多少次都一样。
_out=""
_rc=0
# ⚠⚠ **退出码要这么取**〔08-13 实测,首版就栽在这〕:
#   `if _out=$(cmd); then …; fi` 之后的 `$?` 是**if 语句自己的状态**(条件为假且无 else ⇒ **0**),
#   **不是** cmd 的退出码。首版这么写 ⇒ 循环把「撞名失败」读成 0、当场 break、
#   于是 cc-spawn 拿着**失败那次**印出来的名字继续往下走 ——
#   并发实测:原本 3 个**响亮失败**变成 3 个**假成功**(都报同一个名字,而会话只有 1 个)。
#   **比修之前更坏** ⇒ 用 `cmd && rc=0 || rc=$?` 这种直接取法。
for _try in 1 2 3 4 5; do
  _out=$("${ccm_prefix[@]}" "${ccm_args[@]}") && _rc=0 || _rc=$?
  [ "$_rc" = 0 ] && break
  [ "$_rc" = 3 ] || break               # 不是撞名 ⇒ 立刻停,别掩盖真错误
  [ "$_try" = 5 ] || sleep 0.2
done
if [ "$_rc" != 0 ]; then
  [ "$_rc" = 3 ] && echo "cc-spawn: 连续 5 次都撞上会话名(并发太密?)" >&2
  echo "cc-spawn: 经 ccm 建会话失败" >&2
  exit 1
fi
name=$(printf '%s\n' "$_out" | sed -n 's/^ccm-session=//p' | tail -1)
printf '%s\n' "$_out" | grep -v '^ccm-session=' || true
# 拿不到名字就**停**:再往下 cc-register 与台账会写进空名字,产出一个总线上叫 "" 的幽灵。
[ -n "$name" ] || { echo "cc-spawn: ccm 没报出会话名(ccm-session=) —— 版本太旧?" >&2; exit 1; }
unset _out

# ★★ C15 第二、三件(总线登记 + 台账)也搬进 ccm 了(`--bus-register`/`--bus-note`)。
# 这里原来是:自己 `tmux list-panes` 取 pane → `cc-register` → flock 追加 `spawned.tsv`。
# 为什么必须由 **ccm** 做而不是 cc-spawn 事后补:
#   · pane 只有**建会话的人**当场拿得到(它知道刚建的是哪个会话、什么时候建好的);
#   · 事后补 = 中间有窗口期 —— 会话已经在跑、却还没上总线,`cc-send` 打过去石沉大海。
# ⚠ 而**格式仍归 cc-bus**:ccm 调的是 cc-bus 自己的 `cc-register` / `cc-spawned-record`,
#   不复刻 TSV 的列与锁(同一个格式两份实现 = 改一处漏一处)。找不到 cc-bus 时 ccm 静默 no-op。

# 6. 给启动器一点启动时间。**不是**信任框兜底(那条已归 ccm),而是保留原脚本的既有时序:
#    紧接着用户敲的 cc-send 更可能被即时处理(消息落 inbox 不丢,这只影响即时性)。
#    显式保留而非默默删掉——原先 pretrusted 成功路径上就是 sleep 1.5。
sleep 1.5


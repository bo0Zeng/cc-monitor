#!/usr/bin/env bash
# cc-peek [id] [--max-lines N] [--token-file PATH] [--kinds-file PATH]
#   两阶段读口的**第一跳:纯读**。渲染消息文本 ＋ 吐一个自包含令牌,**不写任何状态**。
#   第二跳是 cc-commit(唯一的副作用)。cc-recv 一字不改地留着 ≡ peek 之后立刻 commit。
#
# ## 为什么非有不可(设计 95 §3ter.0,实测事故)
#
# 「40 条普通消息(每条约 4KB,单条都不超限)累计 160KB ⇒ `jq --arg r "$reason"` 走 argv,
#  撞 `MAX_ARG_STRLEN`(128 KiB)⇒ 钩子 rc=126、stdout 空,而**已读位置已经推到 40**
#  ⇒ 那 40 条再也读不到。」
# ⇒ 两阶段口把这件事从「**推进了再退回**」换成「**没确认就不推进**」。
#   而 `--max-lines` 是它顺带买到的解药:积压分若干轮排空,每轮都在上限以下
#   (cc-recv 做不到分段 —— 它要么全推要么不推)。
#
# ## 令牌:`<from>.<to>.<anchor>`,**不落盘**
#
#   from   peek 那一刻的已读位置(行号,与 `.pos` 同一口径)
#   to     这一段的末行行号
#   anchor 第 `to` 行现算的 `cksum`,形如 `<校验和>-<字节数>`(零新依赖:与 `_dedup_hash` 同一招)
#
# 落盘就要有人清(cc-bus 已经有孤儿 tmp / 死信两条清扫龄,再加一族就是第三条),
# ⇒ 令牌的全部信息塞进令牌自己里,**不建第二个真相源**(`D2`)。
# ⚠ anchor **买到**:收件箱被外部清空/截短后同一行号指向另一条消息 ⇒ 显式失败,不静默推错。
# ⚠ anchor **买不到**:防篡改。谁都能造一个令牌 —— 能写令牌的人本来就能直接写 `.pos`。
#
# ## 令牌走哪条通道
#
# **默认 stderr(裸的一行),`--token-file` 写文件。** 刻意**不混进 stdout**:
# stdout 是消息正文,而 Stop 钩子会把它整个当正文喂给 Claude ⇒ 令牌会被当成消息内容。
# (95 §3ter.7 把"走哪条通道"登记为判不了,缺的证据是"钩子改造后的取法定了没有" ——
#  本轮把钩子一起改了,取法就是 `--token-file`,于是这一格有答案了。)
#
# ## `--kinds-file`:这一段里每条消息的 `kind`(设计 95 §2)
#
# Stop 钩子要按 kind 决定**拦不拦**、用**哪一段**注入模板 —— 而 stdout 必须与 cc-recv 逐字节同一套渲染
# (判据对拍),kind 不能混进正文。⇒ 与令牌同一个取法:**写到调用方指定的文件里**,一行
# `kind:from kind:from …`(两样都过白名单,不合的记成 `msg` / `?`)。同样**不许落在总线目录里**。
#
# 退出码:0 = 正常(有没有新消息都是 0) · 2 = 参数非法 · 13 = 适配层办不到。
set -euo pipefail
BUS="${CC_BUS_HOME:-$HOME/.cc-bus}"
# 自举:适配层还没装载,这一处只能用裸 `readlink -f`(与其余 13 个脚本同一个写法)
SELFDIR=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
# shellcheck source=cc-bus-adapt.sh
. "$SELFDIR/cc-bus-adapt.sh"
ccbus_adapt_load || exit 13        # 三个 trait 装不齐就不干活(fail-closed,不退化成裸 flock)
# shellcheck source=cc-bus-lib.sh
. "$SELFDIR/cc-bus-lib.sh"

id=""; maxlines=""; tokfile=""; kindsfile=""
while [ $# -gt 0 ]; do
  case "$1" in
    --max-lines)  [ $# -ge 2 ] || { echo "cc-peek: --max-lines 后面要跟一个数" >&2; exit 2; }
                  maxlines="$2"; shift 2 ;;
    --token-file) [ $# -ge 2 ] || { echo "cc-peek: --token-file 后面要跟一个路径" >&2; exit 2; }
                  tokfile="$2"; shift 2 ;;
    --kinds-file) [ $# -ge 2 ] || { echo "cc-peek: --kinds-file 后面要跟一个路径" >&2; exit 2; }
                  kindsfile="$2"; shift 2 ;;
    --) shift; break ;;
    -*) echo "cc-peek: 不认识的旗标 '$1'" >&2; exit 2 ;;
    *)  [ -z "$id" ] || { echo "cc-peek: 多给了一个 id '$1'" >&2; exit 2; }; id="$1"; shift ;;
  esac
done
if [ -n "$maxlines" ]; then
  case "$maxlines" in ''|*[!0-9]*|0) echo "cc-peek: --max-lines 要正整数,给的是 '$maxlines'" >&2; exit 2;; esac
fi
# 🔴 令牌文件**不许落在总线目录里**:本命令的全部价值是"零写面",
#    而一个写进 `$BUS/` 的令牌文件会把它变成"写了一点点",并且要有人清(撞 §3ter.2 那条)。
case "${tokfile:-}" in "$BUS"/*) echo "cc-peek: --token-file 不许指向总线目录 $BUS 里" >&2; exit 2;; esac
case "${kindsfile:-}" in "$BUS"/*) echo "cc-peek: --kinds-file 不许指向总线目录 $BUS 里" >&2; exit 2;; esac
[ -n "$id" ] || id=$("$SELFDIR/cc-whoami")
case "$id" in *[!A-Za-z0-9_-]*|'') echo "cc-peek: 非法/空 id '$id'" >&2; exit 2;; esac

inbox="$BUS/inbox/$id.jsonl"
posf="$BUS/state/$id.pos"
[ -f "$inbox" ] || exit 0

# ★ 锁:**共享读锁,锁文件仍是 `<inbox>.lock`**(95 §3ter.5 格④「锁不搬家,只多一处」)。
#   罩住「量行数 ＋ 取那一段 ＋ 算 anchor」,否则 route_deliver 的追加会让读者读到半行。
# ⚠ `9>>"$inbox.lock"` 是本脚本**唯一**碰盘的一处(打开锁文件);它在判据里**逐条登记豁免** ——
#   不开这个 fd 就没有锁,而锁文件必须与 route_deliver / cc-recv 是同一个(不许另开第二把)。
raw=$(
  (
    store_lock_shared 9 || exit 13     # 锁失败要**显式**退出:别指望 errexit 替你收场
    total=$(awk 'END{print NR}' "$inbox")
    pos=$(cat "$posf" 2>/dev/null || echo 0)
    [[ "$pos" =~ ^[0-9]+$ ]] || pos=0          # 损坏归零:与 cc-recv:16 同一条
    # ⚠ 这里**刻意不把"越界"改写成 0**(cc-recv:17 那条自愈):peek 不写,
    #   而令牌的 from 必须与盘上那个值逐字相等,否则 cc-commit 的 CAS 永远比不中。
    #   截短这一格由 cc-commit 按「cur > total」认出来,并逐条登记为单调性的唯一豁免。
    from=$pos
    [ "$pos" -le "$total" ] || pos=0
    if [ "$total" -gt "$pos" ]; then
      to=$total
      if [ -n "$maxlines" ] && [ $((pos+maxlines)) -lt "$total" ]; then to=$((pos+maxlines)); fi
      new=$(sed -n "$((pos+1)),${to}p" "$inbox")
      printf '%s.%s.%s\n' "$from" "$to" "$(twophase_anchor "$inbox" "$to")"
      # 第二行:这一段每条的 kind:from(与令牌同在锁内取 ⇒ 与正文是同一个快照)。坏行不出条目。
      printf '%s\n' "$new" | jq -Rj 'fromjson? // empty
        | ((.kind // "msg") | tostring | if test("^[a-z0-9_-]{1,32}$") then . else "msg" end) + ":"
        + ((.from // "?") | tostring | if test("^[A-Za-z0-9_-]+$") then . else "?" end) + " "'
      printf '\n'
      # 显示:fromjson? 跳过非法 JSON 坏行(防毒丸卡死),// 默认容忍 v1 缺字段行
      # 🔴 **这一段与 cc-recv:21-37 是同一套渲染**,判据逐字对拍两边的 jq 程序 ——
      #    分成两份写就会漂,而"漂了"在输出上只表现成"两条命令给出不同的正文"。
      printf '%s\n' "$new" \
        | jq -Rr 'fromjson? // empty | "【cc-bus 来自 \(.from // "?") @ \(.ts // "?") (\(.id // "-"))】\n\(.text // "")\n(回复用: cc-send \(.from // "?") \"…\")\n"'
      _seen=$(printf '%s\n' "$new" | grep -c . || true)
      _ok=$(printf '%s\n' "$new" | jq -Rr 'fromjson? // empty | .id // "-"' 2>/dev/null | grep -c . || true)
      if [ "${_seen:-0}" -gt "${_ok:-0}" ]; then
        printf '⚠ 跳过 %s 条读不懂的消息（收件箱 %s 的第 %s..%s 行，它们不会再出现）\n' \
          "$(( _seen - _ok ))" "$inbox" "$((pos+1))" "$to"
      fi
      # ⚠ 哨兵是**承重的**:命令替换会把尾随换行全吃掉,而 cc-recv 的正文末尾**有**空行。
      #   不补这一字节,「与 cc-recv 同一套渲染」就差一个换行 —— 判据 B7 现打逮到过。
      printf '\001'
    fi
  ) 9>>"$inbox.lock"
) || exit $?
[ -n "$raw" ] || exit 0                        # 没有新消息:不出正文、不出令牌

raw=${raw%$'\001'}
token=${raw%%$'\n'*}
rest=${raw#*$'\n'}
kinds=${rest%%$'\n'*}
body=${rest#*$'\n'}
[ "$body" != "$rest" ] || body=""              # 只有令牌 ＋ kinds 两行(理论上不会发生)时别把它们当正文
[ -z "$body" ] || printf '%s' "$body"
if [ -n "$tokfile" ]; then
  printf '%s' "$token" > "$tokfile"            # 调用方指定的文件,不在 BUS 里 ⇒ 不是总线状态
else
  printf '%s\n' "$token" >&2
fi
[ -z "$kindsfile" ] || printf '%s' "$kinds" > "$kindsfile"   # 同 --token-file:调用方指定、不在 BUS 里
exit 0

#!/usr/bin/env bash
# cc-spawn [--tool claude|codex] <目录> [初始任务...]  在该目录开一个独立 claude 或 codex 会话、自动上总线、返回其 id。
# 产物是【独立历史 + 原生读该目录文件】的长驻协作 agent(区别于 subagent:同上下文、一次性)。
# 收掉用 cc-kill <id>;看它用 tmux attach -t <id>;跟它聊用 cc-send <id> "..."。
set -euo pipefail
BUS="${CC_BUS_HOME:-$HOME/.cc-bus}"
SELFDIR=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
# 旗标可在 <目录> 前任意顺序出现。
new_flag=0
tool=""
while true; do
  case "${1:-}" in
    --new)  new_flag=1; shift;;                                   # 强制新建(否则默认复用同目录已有活会话)
    --tool) tool="${2:-}"; shift 2 2>/dev/null || { echo "cc-spawn: --tool 需要参数(claude|codex)" >&2; exit 2; };;  # 派生哪个 CLI
    --)     shift; break;;
    *)      break;;
  esac
done
dir="${1:?用法: cc-spawn [--new] [--tool claude|codex] <目录> [初始任务...]}"; shift || true
task="$*"

# 定 tool:显式 --tool > 从 CCSPAWN_LAUNCH basename 推断 > 默认 claude(向后兼容)。
if [ -z "$tool" ]; then
  case "$(basename "${CCSPAWN_LAUNCH:-claude}")" in *codex*) tool=codex;; *) tool=claude;; esac
fi
case "$tool" in claude|codex) ;; *) echo "cc-spawn: 未知 --tool '$tool'(应为 claude|codex)" >&2; exit 2;; esac
# 启动器:CCSPAWN_LAUNCH 覆盖;否则按 tool 取默认。(可测性钩子:测试时设 mock 命令免起真 CLI)
LAUNCH="${CCSPAWN_LAUNCH:-$tool}"

# 1. 绝对路径 + 校验目录存在
absdir=$(cd "$dir" 2>/dev/null && pwd) || { echo "cc-spawn: 目录不存在: $dir" >&2; exit 2; }

# 2. 派生会话名 = <basename>_cc(消毒 + strip 首尾 -,与 cc-whoami resolve 对齐)
bn=$(basename "$absdir")
base="$(printf '%s' "$bn" | tr -c 'A-Za-z0-9_-' '_' | sed 's/^-*//; s/-*$//')_cc"

# 默认【到就用、没有才建】:该目录已有活会话(且非 --new)→ 复用它,别重复开
if [ "$new_flag" != 1 ] && tmux has-session -t "=$base" 2>/dev/null; then
  rpane=$(tmux list-panes -t "$base" -F '#{pane_id}' 2>/dev/null | head -1)
  [ -n "${rpane:-}" ] && TMUX_PANE="$rpane" "$SELFDIR/cc-register" "$base" >/dev/null 2>&1 || true
  [ -n "$task" ] && "$SELFDIR/cc-send" "$base" "$task" >/dev/null 2>&1 || true
  echo "复用已有会话: $base${task:+(已把任务发给它)}"
  echo "  跟它聊: cc-send $base \"...\"    看它: tmux attach -t $base    要开全新的: 加 --new"
  exit 0
fi

# 新建:同名加后缀(= 精确,防前缀误判)
name="$base"; k=2
while tmux has-session -t "=$name" 2>/dev/null; do name="$base-$k"; k=$((k+1)); done

# 3. 预信任派生目录,免启动器卡在信任框(仅当尚未信任才写)。
pretrusted=0
if [ "$tool" = claude ]; then
  cj="${CCSPAWN_CLAUDEJSON:-$HOME/.claude.json}"   # 可测性钩子:测试指副本,不碰真主配置
  if [ -f "$cj" ] && command -v jq >/dev/null 2>&1; then
    if jq -e --arg d "$absdir" '.projects[$d].hasTrustDialogAccepted == true' "$cj" >/dev/null 2>&1; then
      pretrusted=1
    else
      cp -p "$cj" "$cj.bak-ccspawn.$$" 2>/dev/null || true
      tmpj="$cj.tmp.ccspawn.$$"
      if jq --arg d "$absdir" '(.projects[$d].hasTrustDialogAccepted) = true' "$cj" > "$tmpj" 2>/dev/null \
         && jq -e . "$tmpj" >/dev/null 2>&1; then
        mv "$tmpj" "$cj"; pretrusted=1; rm -f "$cj.bak-ccspawn.$$"
      else
        rm -f "$tmpj"; echo "cc-spawn: 预信任写入失败(claude 起来可能弹信任框,已备兜底)" >&2
      fi
    fi
  fi
else
  # codex:把该 worktree 标记为 trusted 写进 ~/.codex/config.toml(幂等、原子、并发安全;Codex 信任按 worktree)。
  # 注意:cc-bus 钩子装在【用户级】,即使不预信任也能登记上总线——预信任只是免启动时弹信任框。
  ct="${CCSPAWN_CODEXTOML:-$HOME/.codex/config.toml}"   # 可测性钩子:测试指副本
  mkdir -p "$(dirname "$ct")" 2>/dev/null || true
  [ -f "$ct" ] || : > "$ct"
  # 路径含控制字符(换行/制表…)无法表示成 TOML basic-string key、会破坏这份共享文件 → 对这类
  # 病态路径跳过预信任(codex 起来可能弹信任框,但 config.toml 保持合法)。正常路径(空格/unicode/"/\ )无碍。
  if [[ "$absdir" == *[[:cntrl:]]* ]]; then   # bash 能匹配内嵌控制字符(用 printf|grep 会把换行当行分隔符吃掉)
    echo "cc-spawn: codex 预信任跳过——目录路径含控制字符(会破坏 config.toml)" >&2
  else
    # 把 absdir 转义成 TOML basic-string(双引号)key:先反斜杠再双引号,
    # 使含 " 或 \ 的路径不会破坏这份共享文件。防重复的 grep 用【同一】转义形式。
    cesc=${absdir//\\/\\\\}; cesc=${cesc//\"/\\\"}
    ( flock 9
      if ! grep -qF "[projects.\"$cesc\"]" "$ct" 2>/dev/null; then   # 该目录已有 stanza 就跳过(不重复写表头 → 保持 TOML 合法)
        cp -p "$ct" "$ct.bak-ccspawn.$$" 2>/dev/null || true
        if printf '\n[projects."%s"]\ntrust_level = "trusted"\n' "$cesc" >> "$ct" 2>/dev/null; then
          rm -f "$ct.bak-ccspawn.$$"
        else
          [ -f "$ct.bak-ccspawn.$$" ] && mv -f "$ct.bak-ccspawn.$$" "$ct"   # 半写失败则回滚
          echo "cc-spawn: codex 预信任写入失败(codex 起来可能弹信任框)" >&2
        fi
      fi
    ) 9>>"$ct.lock"
    grep -qF "[projects.\"$cesc\"]" "$ct" 2>/dev/null && pretrusted=1   # 信任 stanza 现已存在(原有或刚追加)
  fi
fi

mkdir -p "$BUS"
# 4. 建 detached 会话,并立刻取【pane id】(刚建精确会话存在,此处裸 -t 安全;之后一律用 pane id,免前缀撞会话)
tmux new-session -d -s "$name" -c "$absdir" -x 220 -y 50
pane=$(tmux list-panes -t "$name" -F '#{pane_id}' 2>/dev/null | head -1)
[ -n "$pane" ] || { echo "cc-spawn: 建会话失败" >&2; exit 1; }
# 起 LAUNCH[+任务](任务用 %q 安全转义,防注入)。
# codex 路径注入 CC_BUS_ID=<会话名> 进启动环境:模型的沙箱 shell 工具够不着 tmux 服务端 socket
#(Landlock/seccomp),那里 cc-whoami 没法靠 tmux 解析身份——但 CC_BUS_ID 是它最高优先级、不依赖 tmux
# 的来源,且环境变量能透进沙箱。(Claude 的 shell 工具能用 tmux,强设 CC_BUS_ID 会盖掉用来细分同会话多 CC 的
# @cc_id 标签,所以只对 codex。)用 env 前缀式,这样 CCSPAWN_LAUNCH 覆盖成 wrapper(如 env CODEX_HOME=... codex)时也生效。
inj=""
[ "$tool" = codex ] && inj="CC_BUS_ID=$(printf '%q' "$name") "
if [ -n "$task" ]; then
  tmux send-keys -t "$pane" "${inj}$LAUNCH $(printf '%q' "$task")" Enter
else
  tmux send-keys -t "$pane" "${inj}$LAUNCH" Enter
fi

# 5. spawn 自己登记(不靠 SessionStart 钩子,保证上总线)
TMUX_PANE="$pane" "$SELFDIR/cc-register" "$name" >/dev/null 2>&1 || true

# 6. 台账(加锁)
( flock 9; printf '%s\t%s\t%s\t%s\n' "$name" "$absdir" "$(date -Iseconds)" "${task:-}" >> "$BUS/spawned.tsv" ) 9>>"$BUS/spawned.tsv.lock"

# 7. 信任框兜底(Claude 专有提示文本):仅当预信任【没成功】且启动的是 claude 时才检测信任框回车。
#    Codex 已由 config.toml 预信任(且其 cc-bus 钩子是用户级),这里无需处理信任框。
if [ "$pretrusted" != 1 ] && [ "$tool" = claude ]; then
  for _i in 1 2 3 4 5 6; do
    sleep 0.5
    if tmux capture-pane -t "$pane" -p 2>/dev/null | grep -q 'Yes, I trust this folder'; then
      tmux send-keys -t "$pane" Enter; break
    fi
  done
else
  sleep 1.5   # 给启动器一点启动时间(消息落 inbox 不丢,这只是让紧接着的 cc-send 更可能即时被处理)
fi

echo "已 spawn: $name   (目录: $absdir${task:+  初始任务: $task})"
echo "  跟它聊: cc-send $name \"...\"    看它: tmux attach -t $name    收掉: cc-kill $name"

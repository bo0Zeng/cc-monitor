#!/usr/bin/env bash
# cc-kill <id>  收掉一个会话(通常是 cc-spawn 派生的):杀会话+进程树 + 清名册/台账 + 清其状态。
set -euo pipefail
BUS="${CC_BUS_HOME:-$HOME/.cc-bus}"
id="${1:?用法: cc-kill <id>}"
case "$id" in *[!A-Za-z0-9_-]*|'') echo "cc-kill: 非法 id '$id'" >&2; exit 2;; esac

# 递归收集一个 pid 的整棵进程树(含自己)
_tree(){ local p="$1" c; echo "$p"; for c in $(pgrep -P "$p" 2>/dev/null); do _tree "$c"; done; }

# 杀会话 + 进程树。claude 可能 trap SIGHUP 扛过 kill-session 并被 init 收养 →
# 必须【kill-session 前】收好整棵树,【之后无条件】清 survivors(不能只看 pane_pid 存活与否)。
# ★★ **杀之前先核这个会话还是不是它**〔08-13 实测事故〕
#
# 本脚本按**名字**杀（`-t "=$id"`），而会话名会被重用 —— `cc-spawn` 就按目录基名取名。
# 实测：agent `proj_cc` 退出后，用户在同名会话里跑别的东西，UI 上点「收掉 agent proj_cc」
# ⇒ **那个无辜进程被 kill -9、会话被杀**。这是今天那条「敲门打进陌生人屏幕」的同族，
# 但后果重得多：那条只是打扰,这条是**销毁**。
#
# ⇒ 用 `agents.tsv` 第 4 列（登记时记下的 pane 根进程 pid,与敲门那条同一份数据）核一次：
# · 对得上 ⇒ 照杀;
# · **对不上 ⇒ 不杀会话、不删收件箱**,只摘掉那条陈旧登记(那也确实是"收掉"的一半),并说明;
# · 第 4 列为空(老表)⇒ 保持老行为,但**说一句**(存量不能一刀拦死)。
_want_pid=$(awk -F'\t' -v id="$id" '$1==id{p=$4} END{print p}' "$BUS/agents.tsv" 2>/dev/null || true)
# ⚠ **要问登记的那个 pane，不是"这个会话现在的 pane"**〔08-13 自己的探针撞出来的〕：
#   第一版写 `list-panes -t "=$id" | head -1` —— 那取的是**当前窗口**的第一个 pane。
#   用户在自己 agent 的会话里开一个新窗口，当前窗口就变了 ⇒ pid 对不上
#   ⇒ cc-kill 会对**它自己的 agent** 说「名字被别人占了」。**假阳性比不查更坏**：
#   它会让人以为身份核对坏了，进而把这道保护删掉。
#   ⇒ 用 agents.tsv 第 2 列那个**完整地址**（`sess:win.pane`）精确问，与敲门那条一致。
_want_target=$(awk -F'\t' -v id="$id" '$1==id{t=$2} END{print t}' "$BUS/agents.tsv" 2>/dev/null || true)
_identity_ok=1
if tmux has-session -t "=$id" 2>/dev/null && [ -n "${_want_pid:-}" ] && [ -n "${_want_target:-}" ]; then
  _have_pid=$(tmux display-message -p -t "=$_want_target" '#{pane_pid}' 2>/dev/null || true)
  if [ "${_have_pid:-}" != "$_want_pid" ]; then
    _identity_ok=0
    echo "cc-kill: 会话 $id 现在的根进程是 ${_have_pid:-<无>}，而登记时是 $_want_pid ——" >&2
    echo "         **这个名字已经被别人占了，不杀它**（只摘掉那条陈旧登记）。" >&2
  fi
elif [ -z "${_want_pid:-}" ]; then
  echo "cc-kill: 这条登记没有身份信息（老格式），杀之前无法核对是不是它 —— 按老行为继续。" >&2
fi

if [ "$_identity_ok" = 1 ] && tmux has-session -t "=$id" 2>/dev/null; then
  ppid=$(tmux list-panes -t "=$id" -F '#{pane_pid}' 2>/dev/null | head -1)
  procs=""; [ -n "${ppid:-}" ] && procs=$(_tree "$ppid" 2>/dev/null || true)
  # ⚠ **把要销毁的东西说出来**：身份已经核准（是这个 agent 没错），但用户可能在这个会话里
  #   开过自己的窗口。daemon 的 `kill` 原语在证据较弱时用「只杀单窗口」当第三道门；
  #   这里证据更强（登记的 pane 根进程 pid 对上了）⇒ **照杀，但把窗口数摆出来**。
  #   要不要在多窗口时干脆拦下，是产品判断 ⇒ 记在 ROADMAP `U18`，不在这儿替用户定。
  _wins=$(tmux display-message -p -t "=$id:" '#{session_windows}' 2>/dev/null || true)
  case "${_wins:-1}" in ''|1) : ;; *) echo "cc-kill: 注意，$id 有 $_wins 个窗口，一起收掉" >&2 ;; esac
  tmux kill-session -t "=$id" 2>/dev/null && echo "已杀会话 $id" || echo "杀会话 $id 失败" >&2
  if [ -n "${procs:-}" ]; then
    kill $procs 2>/dev/null || true; sleep 0.3; kill -9 $procs 2>/dev/null || true
  fi
elif [ "$_identity_ok" = 1 ]; then
  echo "无 tmux 会话 $id(可能已退)"
fi

# 名册清除(flock;成功才 mv,失败不动原文件,免 awk 出错清空整库)
touch "$BUS/agents.tsv"
(
  flock 9
  if awk -F'\t' -v id="$id" '$1!=id' "$BUS/agents.tsv" > "$BUS/agents.tsv.tmp.$$" 2>/dev/null; then
    mv "$BUS/agents.tsv.tmp.$$" "$BUS/agents.tsv"
  else rm -f "$BUS/agents.tsv.tmp.$$"; fi
) 9>>"$BUS/agents.tsv.lock"

# 台账清除(flock)
if [ -f "$BUS/spawned.tsv" ]; then
  (
    flock 8
    if awk -F'\t' -v id="$id" '$1!=id' "$BUS/spawned.tsv" > "$BUS/spawned.tsv.tmp.$$" 2>/dev/null; then
      mv "$BUS/spawned.tsv.tmp.$$" "$BUS/spawned.tsv"
    else rm -f "$BUS/spawned.tsv.tmp.$$"; fi
  ) 8>>"$BUS/spawned.tsv.lock"
fi

# 清该 id 的状态。
# ⚠ 身份对不上时**不删**：那个 id 的收件箱里可能还有它没读的消息，
#   而我们刚刚才确认"这个名字现在是别人的" —— 连它是不是真的没了都不知道。
if [ "$_identity_ok" = 0 ]; then
  echo "已摘掉 $id 的陈旧登记（会话与收件箱都没动）"
  exit 0
fi
# 清该 id 的状态:id-keyed + pair-keyed(免 respawn 同 id 串到旧因果链/旧去重)
rm -f "$BUS/inbox/$id.jsonl" "$BUS/inbox/$id.jsonl.lock" \
      "$BUS/state/$id.pos" "$BUS/state/nudge-$id" "$BUS/state/nudge-$id.lock" \
      "$BUS/state/dedup-$id" "$BUS/state/dedup-$id.lock" \
      "$BUS/state/rate-${id}__"* "$BUS/state/rate-"*"__${id}" \
      "$BUS/state/lastread-${id}__"* "$BUS/state/lastread-"*"__${id}" 2>/dev/null || true
echo "已清 $id 的名册/台账/状态"

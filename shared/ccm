#!/usr/bin/env bash
# ccm — cc-monitor 统一启动器（unify-launch F02）
#
# 核心思想（MASTERPLAN §0）：把「起一个会话」从一堆写死的命令，变成
# **一个动作 + 若干正交修饰**；并让这个模型在 IR、CLI、UI 三处是同一个。
# 本文件是它在 shell 侧的投影，也是 app 与终端的**唯一共同实现**。
#
# 用法：ccm [动作] [修饰…] [-- 透传给 agent 的参数]
#   动作（缺省 = new）
#     new                     起新会话
#     resume <sid>            恢复会话（`--resume <sid>` 是等价别名）
#     attach <名>             接回已有 tmux 会话
#   修饰（全部正交、可任意组合、可缺省；缺省即旧 cc/ccm 的行为）
#     --tmux[=<名>]           容器。**三种取名模式**（撞名策略各不相同，见 `derive_tmux_name` 上方那段）：
#                             · `--tmux`（无名）    → 派生 cc-<safe-basename>，**无条件避让**（撞了退 -2/-3）
#                             · `--tmux=<名>`       → 就要这个名，**不避让**；被占就 exit 3 响亮失败（C14）
#                             · `--tmux-base=<基名>`→ **调用方给底、ccm 避让**（C15：cc-spawn 用它）
#                             已在 tmux 里则就地起，不建嵌套（给了名的除外）
#     --tmux-base=<基名>      见上。最终会话名由 ccm 用 `ccm-session=<名>` 报回 stdout（配合 --detach）
#     --account <名>          注入该账号的 CLAUDE_CONFIG_DIR
#     --base                  显式不注入（issue #75 逃生口）
#     --model <名>            该次会话的 ANTHROPIC_MODEL（如 opus/sonnet，或完整模型 ID）
#     --cwd auto|<dir>        默认 auto = 旧 _cc_resolve_target 语义
#     --agent claude|codex    默认 claude
#     --launcher <cmd>        覆盖该 agent 的默认启动命令
#     --ccm-sid <sid>         身份打标（cc-monitor 已知 sid 时传）
#     --detach                只建会话并返回，**不** attach（配合 --tmux；给脚本化调用方用）
#                             ⚠ 括号里原写「如 cc-spawn：建完还要拿 pane id 去登记总线、写台账」——
#                             **C15（08-13）之后那两件已经收进 ccm 自己**（见 --bus-register），
#                             cc-spawn 只从 `ccm-session=` 读回名字。散文跟着改，别留旧图景
#     --tmux-size <W>x<H>     新建 tmux 会话的窗口尺寸（如 220x50）。detached 会话默认 80x24，
#                             太窄会把 agent 输出折行；仅对**新建**生效，幂等接回既有会话时无效
#     --bus-register          把新会话登记上 cc-bus（配合 --detach）。**格式归 cc-bus** ——
#                             ccm 调它自己的 `cc-register` / `cc-spawned-record`，不复刻 TSV。
#                             找不到 cc-bus 就静默 no-op，但**会往 stderr 说一句**
#     --bus-note <文本>       写进 spawn 台账第 4 列（初始任务）。配合 --bus-register
#   （**没有 --bus-id**：cc-bus 身份无需调用方传——见 `agent_needs_bus_id`，codex 下 ccm 自己
#     从 tmux 会话名派生 CC_BUS_ID，与 cc-spawn 原先手动注入的值逐字相同。实测确认。）
#   环境（不是旗标，但影响行为 —— 判据 `every_advertised_capability_has_a_usage_line` 要求
#   `capabilities=` 里的每个 token 在这里有一行）
#     --daemon-discover       **不是旗标**：能力 token，声明「本 ccm 会自己找本机 daemon」。
#                             次序 $CCM_DAEMON_BIN → ~/.cc-monitor/bin/cc-monitor-remote → PATH；
#                             `CCM_NO_DAEMON=1` 整条关掉（P4e）。resume 时用它问 daemon 要命令
#     --account-via-daemon    **不是旗标**：能力 token（`K-C1`），声明「`--account` / 默认号的
#                             解析走 daemon 的 `--list-accounts`，不自己读 manifest」。
#                             消费者要它做什么：cc-monitor 列给用户看的账号表来自 daemon，
#                             而**旧 ccm 是自己读文件的** —— 两份能不一致（daemon 有 schema
#                             版本闸与 configDir 安全谓词，文件那份没有）⇒ 用户在 UI 里挑得到
#                             的号，交给旧 ccm 可能报「不可用」。有这个 token = 两侧同一份答案。
#                             缺 daemon 时**降级读文件并往 stderr 说一句**（见 `acct_table_load`）
#   自省
#     --print                 打印将要执行的命令，不执行
#     --ccm-probe             打印 name/version/capabilities
#     --version / --help
#   退出码（**外部契约** —— 调用方按它分辨失败的**种类**，不是只分辨「成没成」）
#     0   成功
#     2   用法 / 参数 / 环境不满足（`die`：在 tmux 里用无名 `--tmux`、`--account` 打错名字、
#         没装 tmux …）—— 这一类是**你敲错了**
#     3   `--tmux=<名>` 撞名：拒绝静默接回别人的会话（`C14`：spawn 就是起）
#     4   **后端不可达，起不来**〔`K-P2` 09-04〕。`ccm --tmux` 建会话**只走后端** ——
#         ccm 不铺、不起、不找退路；本机 tmux 直起那条退路已经**删掉**
#         （用@09-04 逐字「ccm不要管找不到, 统一走后端」）。
#         ⇒ 装/起本机后端在 cc-monitor 里做（设置 → 本机后端），不在 ccm 里。
#         这一类是**这台机器上没有后端**，与 2 那一类分得开：它是可修的部署缺口。
#         `CCM_NO_DAEMON=1` 明示关掉整条后端路 ⇒ **照样是这个码**：
#         「你自己关掉了」与「机器上没有」在结果上是同一件事 —— 起不来。
#
# 示例：
#   ccm --tmux --account z                      # 用账号 z、tmux 幂等接回，起/接回默认新会话
#   ccm resume abc-123 --tmux --model opus      # 恢复会话 abc-123，这次用 opus 模型
#   ccm --tmux=my-session --agent codex         # 显式会话名、codex agent
#
# 想固定一个常用组合？存成 shell 别名即可（cc-monitor 设置面板有生成器，拼好直接复制）：
#   alias cct='ccm --tmux --account z'
#
# 想看这台机器上配置了哪些账号？那是 cc-monitor 自己管的数据（不是 ccm 的职责），去
# cc-monitor 的设置面板「账号」组看，ccm 本身不提供列账号的子命令。
#
# `--tmux` 建**新**会话时会顺带把该目录标记为已信任（写 ~/.claude.json 或
# ~/.codex/config.toml），免得 claude/codex 在无人盯着的 detached 会话里卡在信任确认框——
# 设 CCM_NO_PRETRUST=1 可关闭这个行为（如你想自己手动确认每个新目录的信任）。
#
# **为什么必须是这个结构**（别"简化"掉，每条都有血）：
#  1. 环境（cwd / CLAUDE_CONFIG_DIR / 代理 / unset 嵌套 env）**必须在最终 exec 的那个 shell 里设**。
#     旧 `cct` 的做法是外层 export + 自建 tmux + send-keys，而 tmux 的 `update-environment`
#     默认列表不含 CLAUDE_CONFIG_DIR → export 在 tmux 进程边界上被整个吃掉，账号注入 100% 失效。
#     本 CLI 的 --tmux 因此**不在外层设 env**，而是把「同一条 ccm 命令、去掉 --tmux」送进 tmux 内部。
#  2. `exec` 不能省 —— **但理由在 `U-NP④`（08-14）之后换了一条，别照旧理解**：
#     旧理由是「身份回填 poller 读 `~/.claude/sessions/$PID.json`，不 exec 则 PID 对不上」。
#     那条 poller 已删（见 §L5），今天认 pidfile 的是 daemon，而 pidfile 的名字是
#     **claude 自己的 PID** ⇒ 「PID 对不上」这个后果**不再存在**。留着 `exec` 的理由是
#     另外两条：① 不在 agent 与终端之间留一层多余的 shell（信号、退出码、Ctrl-C 直传）；
#     ② 部署契约里逐字要求它（`sftp.rs` 的 needle）。**照旧写 `exec`，但别再引用那个旧后果。**
#  3. 所有 tmux `-t` 目标用 `=<名>:` 精确形态（见 doc/INVARIANTS.md §31a）。裸目标是
#     「精确→名字开头→glob」三级解析，会杀错/打错兄弟会话。尾冒号不能省。
#  4. **身份（`@ccm_sid`）必须走 daemon —— 没有 daemon 就响亮失败，不静默降级。**
#     ⚠ 这一条 `U-NP④`（08-14）**整条改写过**。旧文说的是「身份注册用运行时自适应而非
#     编译期门控：装了就用，没装就无声地退化成一个普通启动器」。那句话今天是**假的**：
#     （⚠ 旧话**刻意不逐字抄在这里** —— 钉这条的判据是「ccm 里不许再出现那句话」，
#      连注释一起扫，抄一遍就会把它自己打红。同 `tmux_hook.rs` 头注那条纪律。）
#     用户裁定「不要轮询」＋「ccm 做到必须走 daemon」之后，ccm 里那条每秒一轮、与会话同寿的
#     身份 poller 被整条删掉，**没有留任何轮询退路**。于是「没装 daemon」不再是「少一个
#     锦上添花」，而是「这个会话在 monitor 里永远绑不上、点 ↗ 弹『未绑定窗口』且没人知道
#     为什么」。⇒ 在 tmux 里起有身份的 agent 而找不到 daemon ⇒ **exit 2 并说清怎么办**。
#     逃生口仍在：`CCM_NO_DAEMON=1` 明示放弃身份（那时**照样往 stderr 说一句**，不闷声）。

set -u

# 2：B02 新增 --detach / --tmux-size（capabilities 变了）。本文件经 `sftp.rs` 的
# `include_str!` 部署到远端，版本号与 capabilities 一样是**外部可见契约**，不能只改后者。
# 3：`K-C1` 新增能力 token `account-via-daemon`（账号解析走 daemon 的 `--list-accounts`）。
#    照上一行那条纪律：capabilities 变了 ⇒ 版本号跟着走。它同时是**行为**变化的版本标记 ——
#    用户机器上那份 `~/.local/bin/ccm` 副本可能很旧（`KL4`：改它要考虑升级路径）。
# 4：〔`K-P2` `F` 拍 09-04；用@09-04「ccm不要管找不到, 统一走后端」〕**capabilities 一个字没变，
#    变的是行为** —— `--tmux` 建会话的**本地退路删掉了**：后端不可达 ⇒ `exit 4`，
#    不再退回本机 tmux 直起、也不再 `rc=0`。
#    ⇒ 这一格正是上一行那句「它同时是**行为**变化的版本标记」在说的事：
#    那条纪律是「caps 变了 ⇒ 版本跟着走」，**不是**「只有 caps 变了才许走版本」。
#    一台远端上装的是 3 还是 4，决定了「daemon 没部署时那台机器起不起得来会话」——
#    这是 `ccm_probe` 唯一分辨得出来的东西（`version=` 那一行）。
#    ⚠ **本拍刻意不加能力 token**（如 `tmux-via-daemon`），理由与代价逐条登记在
#      件计划 `§4`：今天没有任何消费者会据它改行为，而加它要连带订正**写区外** 3 处
#      「现打 17 个 token」的读数（`history.rs` · `payload.rs` 两处）。**留给 PM/`K-P3` 裁。**
CCM_VERSION="4"

# —— 自身绝对路径（--tmux 时要把自己送进容器；不依赖 PATH）——
if [ -z "${CCM_SELF:-}" ]; then
  _self="$0"
  case "$_self" in
    /*) : ;;
    *) _self="$(cd "$(dirname "$_self")" 2>/dev/null && pwd)/$(basename "$_self")" ;;
  esac
  CCM_SELF="$_self"
fi

# —— 配置。优先级：**环境变量 > 配置文件 > 内置默认**。
# 三个默认值必须先存下继承来的环境变量再赋值——否则会把 env 覆盖掉，
# 导致 `CCM_ACCTS_MANIFEST=/x ccm …` 这类隔离调用无效（测试与远端排障都要靠它）。
CCM_CONFIG="${CCM_CONFIG:-$HOME/.config/ccm/config}"
_env_ws="${CCM_WORKSPACE:-}"; _env_am="${CCM_ACCTS_MANIFEST:-}"; _env_ev="${CCM_ENV:-}"
# 内置默认刻意用**中性路径**：本文件会被 `include_str!` 原样部署到任意远端，
# 不能把某台机器的本地化目录（如 `$HOME/文档/...`）烧进去。要改走配置文件。
CCM_WORKSPACE="$HOME/claude-conversation"
CCM_ENV=""                                   # 起 agent 前 eval 的 env（旧 CC_ENV 迁移到这）
CCM_ACCTS_MANIFEST="$HOME/.claude-accts/accounts.json"
# ★ `K-C1`：daemon 的 `--list-accounts` **只收目录**（`--accts-dir`），manifest 的文件名由
#   它自己拼（Rust 侧 `acct-core::MANIFEST_NAME`）⇒ ccm 要判「这个 CCM_ACCTS_MANIFEST 能不能
#   转译成一个 --accts-dir」就得知道那个文件名。**从上面这行默认值里取，不再手抄一份** ——
#   手抄等于给同一个常量开第三个写点（Rust 一份、上面那行一份、判断处再一份）。
#   必须在 env/配置覆盖**之前**取：覆盖之后取到的是用户指的那个名字，判断就恒真了。
_CCM_MANIFEST_NAME="${CCM_ACCTS_MANIFEST##*/}"
# shellcheck source=/dev/null
[ -f "$CCM_CONFIG" ] && . "$CCM_CONFIG"
[ -n "$_env_ws" ] && CCM_WORKSPACE="$_env_ws"
[ -n "$_env_am" ] && CCM_ACCTS_MANIFEST="$_env_am"
[ -n "$_env_ev" ] && CCM_ENV="$_env_ev"
unset _env_ws _env_am _env_ev

die() { printf 'ccm: %s\n' "$*" >&2; exit 2; }

# 带值 flag 的取值守卫。**盲取下一个 token 会把后面的 flag 当成值吃掉**——真机踩过：
# `ccm --tmux --account --print` 里 `--account` 吞掉了 `--print`，账号名变成字面量 "--print"，
# 会话照建、claude 照起，用户只在一闪而过的一行里看到报错。凡是要值的 flag 都过这道门。
need_val() { # need_val <flag名> <下一个token(可空)>
  [ -n "${2:-}" ] || die "$1 需要一个值"
  case "$2" in -*) die "$1 需要一个值，但拿到的是 '$2'（像是漏了参数）" ;; esac
}

# POSIX 单引号 quote（与前端 posixQuote 同算法）。**构造真正要执行的命令时一律用它。**
sq() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# 仅在必要时加引号 —— **只给 `--print` 的展示/等价断言用**。
# 目的：零修饰调用的输出与今天 `ccm()` 的 `exec claude` **逐字节一致**（`exec 'claude'` 虽等价但不逐字节）。
qarg() {
  case "$1" in
    ''|*[!A-Za-z0-9_@%+=:,./-]*) sq "$1" ;;
    *) printf '%s' "$1" ;;
  esac
}

# ===== JSON 编码器（BEGIN json-encoder）=====
#
# ## 它为什么存在〔`K-P2` `D` 阶段第一拍，09-03〕
#
# daemon 的一次性口 `--launch` **只收 stdin JSON**（`cli_control.rs` 头注逐字：「CLI 面收
# **stdin JSON** 而不是把参数摊进 argv，正是为了不引入一层 shell 解析把它丢掉」），
# 而 `launch` 要送的 `payload` / `cwd` 是**任意串** —— `payload` 是本文件用 `sq` 拼出来的
# 一整条命令行（含单引号、双引号、反斜杠、`$`），前面还可能挂着若干段 `export …=…; `。
#
# 🔴 **在本函数之前，本文件唯一一处产 JSON 是 `printf '{"sessionId":"%s"}' "$1"`** ——
# 那**不是编码器，是一个只对受限字符集成立的模板**：`sessionId` 在
# `control/launch.rs::parse_request` 那一侧已被收窄到 `[A-Za-z0-9_-]`，
# 所以模板看着一直是对的。⇒ **照抄它去送 payload 就是拿转义换正确性。**
# 那两处已经改走本函数（见 `resolve_from_daemon` / `resolve_recipe`），
# 「本文件里还有第二种产 JSON 的办法」由 `ccm_cli_contract.rs` 那条结构判据钉住。
#
# ## 为什么是纯 bash，不借 `jq` / `python`
#
# 本文件经 `sftp.rs` 的 `include_str!` **部署到任意远端** ⇒ 「那台机器上装了什么」
# 不是本文件可以假设的东西（`DAEMON_BIN_RECIPE` 头注为 `timeout` 立过同一条纪律）。
# 而 `KC6d` 那一族判据（`e2e/ccm-cli.test.sh` 的 `KNF` / `KALLNEW`）逐条钉着热路径上
# **零外部依赖** ⇒ 本函数一个外部命令都不起（`printf` 是 builtin，`case` 是语法）。
#
# ## 编码规则：与 `jq` **逐字节同形**，一条例外都不留
#
# RFC 8259 只强制转义 `"` `\` 与 U+0000–U+001F；其余（`/` · U+007F · 非 ASCII）**可转可不转**。
# 而「可选」正是「大多数输入下看着对」的藏身处 ⇒ 本函数**不留可选项**，选定 `jq` 的那一套：
# `\" \\ \b \f \n \r \t`，**其余控制字符与 U+007F** 走 `\u00xx`（小写十六进制），
# `/` 不转义，非 ASCII **原样透传 UTF-8 字节**。
# ⇒ 判据因此可以写成「**与 `jq -Rs .` 逐字节相等**」（`e2e/ccm-cli.test.sh` 的 `JSONENC` 那节），
# 而不是一张「这几种输入允许不一样」的例外表 —— **例外表会替以后所有真 bug 挡枪**。
# ⚠ U+007F 那一格是**实测逼出来的**，不是设计出来的：初版照 RFC 的「可选」把它透传，
#   与 `jq` 对拍当场 1 处 DIFF（件文件 `§16-3` 的 `E1`）。
#
# ## 逐字符扫描，而且**字节保真**
#
# `${s#?}` 在 UTF-8 locale 下吃掉一个**字符**、在 C locale 下吃掉一个**字节**；
# 两种切法下非 ASCII 都只走 `*)` 那一支原样拼回 ⇒ **输出逐字节与 locale 无关**
#（三种 locale 实测同值，`§16-3` 的 `E2`）。
# ⚠ `?` **一个字节都吃不动**时（locale 认不出的字节）`s` 不会变短 ⇒ 写成 while 就是**死循环**。
#   ⇒ 当场出声 + `return 1`，**不猜、不静默丢、不转圈**。
#
# ⚠ **本函数不做的事，写出来别让人以为它做了**：它不判输入是不是合法 UTF-8
#（非法字节会被原样透传成非法 JSON，由收端报错），也不管 `MAX_FIELD_BYTES` 那条长度限。
#   ⚠ 还有一格是**行为差异不是编码细节**：daemon 的 `check_field` **拒收含控制字符的字段**
#   ⇒ 载荷里真有换行时，新路会拿到 `invalid_args`，而今天那条 shell 路照跑。
_CCM_JSON_CTRL=$'\001\002\003\004\005\006\007\013\016\017\020\021\022\023\024\025\026\027\030\031\032\033\034\035\036\037\177'

json_str() {  # $1=任意串 → stdout: 一个**完整的 JSON 字符串**（含外围双引号）
  local s="$1" out="" c rest hex
  while [ -n "$s" ]; do
    rest="${s#?}"
    c="${s%"$rest"}"
    if [ -z "$c" ]; then
      printf 'ccm: json_str: 输入里有当前 locale 认不出的字节，拒绝编码\n' >&2
      return 1
    fi
    s="$rest"
    case "$c" in
      '"')   out="$out"'\"' ;;
      '\')   out="$out"'\\' ;;
      $'\b') out="$out"'\b' ;;
      $'\f') out="$out"'\f' ;;
      $'\n') out="$out"'\n' ;;
      $'\r') out="$out"'\r' ;;
      $'\t') out="$out"'\t' ;;
      *)
        # 剩下的控制字符（含 U+007F）没有短名 ⇒ `\u00xx`。
        # `"'$c"` 是 POSIX printf 的「取首字符码位」写法；这里只对**单字节**控制字符走这一支。
        case "$_CCM_JSON_CTRL" in
          *"$c"*) printf -v hex '%04x' "'$c"; out="$out\\u$hex" ;;
          *)      out="$out$c" ;;
        esac ;;
    esac
  done
  printf '"%s"' "$out"
}
# ===== JSON 编码器（END json-encoder）=====

# ===== agent 轴（哪个 AI）——CLI 主体零分支，全部查表 =====
# 与 src/agent-profile.ts 的 AGENT_PROFILE 对位；改这里要同步那边。
agent_default_launcher() { case "$1" in claude) echo claude ;; codex) echo codex ;; esac; }
agent_resume_flag()      { case "$1" in claude) printf '%s' "--resume" ;; codex) printf '' ;; esac; }
# 顺序照 unset 命令，与 AGENT_PROFILE.nestedEnvVars 逐字一致。
agent_nested_env()       {
  case "$1" in
    claude) echo "CLAUDECODE CLAUDE_CODE_ENTRYPOINT CLAUDE_CODE_SESSION_ID CLAUDE_CODE_CHILD_SESSION" ;;
    codex)  echo "" ;;
  esac
}
# 该 agent 有没有 per-PID session 文件（决定这个会话有没有身份、要不要要求 daemon 在场）。
# ⚠ `U-NP④` 前这行写的是「决定要不要起身份回填 poller」—— poller 已删，措辞跟着改。
agent_has_identity()     { case "$1" in claude) return 0 ;; *) return 1 ;; esac; }
# 该 agent 需不需要把 tmux 会话名注入 CC_BUS_ID（cc-bus 多实例身份）。
#   codex：**需要**——它的模型-shell 沙箱(Landlock/seccomp)够不着 tmux 服务端 socket，
#     `cc-whoami` 在那里没法靠 tmux 解析身份；`CC_BUS_ID` 是它最高优先级且唯一不依赖

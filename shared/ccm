#!/usr/bin/env bash
# ccm — cc-monitor 统一启动器（unify-launch F02）
#
# 核心思想（MASTERPLAN §0）：把「起一个会话」从一堆写死的命令，变成
# **一个动作 + 若干正交修饰**；并让这个模型在 IR、CLI、UI 三处是同一个。
# 本文件是它在 shell 侧的投影，也是 app 与终端的**唯一共同实现**。
#
# 用法：ccm [动作] [修饰…] [-- 透传给 agent 的参数]
#   动作（缺省 = new）
#     new                     起新会话
#     resume <sid>            恢复会话（`--resume <sid>` 是等价别名）
#     attach <名>             接回已有 tmux 会话
#   修饰（全部正交、可任意组合、可缺省；缺省即旧 cc/ccm 的行为）
#     --tmux[=<名>]           容器。缺省名 = cc-<safe-basename>（同目录**幂等接回**同一会话；
#                             同名但**异目录**会退让到 -2/-3。已在 tmux 里则就地起，不建嵌套）
#     --account <名>          注入该账号的 CLAUDE_CONFIG_DIR
#     --base                  显式不注入（issue #75 逃生口）
#     --model <名>            该次会话的 ANTHROPIC_MODEL（如 opus/sonnet，或完整模型 ID）
#     --cwd auto|<dir>        默认 auto = 旧 _cc_resolve_target 语义
#     --agent claude|codex    默认 claude
#     --launcher <cmd>        覆盖该 agent 的默认启动命令
#     --ccm-sid <sid>         身份打标（cc-monitor 已知 sid 时传）
#     --detach                只建会话并返回，**不** attach（配合 --tmux；给脚本化调用方用，
#                             如 cc-spawn：建完还要拿 pane id 去登记总线、写台账、打印提示）
#     --tmux-size <W>x<H>     新建 tmux 会话的窗口尺寸（如 220x50）。detached 会话默认 80x24，
#                             太窄会把 agent 输出折行；仅对**新建**生效，幂等接回既有会话时无效
#   （**没有 --bus-id**：cc-bus 身份无需调用方传——见 `agent_needs_bus_id`，codex 下 ccm 自己
#     从 tmux 会话名派生 CC_BUS_ID，与 cc-spawn 原先手动注入的值逐字相同。实测确认。）
#   自省
#     --print                 打印将要执行的命令，不执行
#     --ccm-probe             打印 name/version/capabilities
#     --version / --help
#
# 示例：
#   ccm --tmux --account z                      # 用账号 z、tmux 幂等接回，起/接回默认新会话
#   ccm resume abc-123 --tmux --model opus      # 恢复会话 abc-123，这次用 opus 模型
#   ccm --tmux=my-session --agent codex         # 显式会话名、codex agent
#
# 想固定一个常用组合？存成 shell 别名即可（cc-monitor 设置面板有生成器，拼好直接复制）：
#   alias cct='ccm --tmux --account z'
#
# 想看这台机器上配置了哪些账号？那是 cc-monitor 自己管的数据（不是 ccm 的职责），去
# cc-monitor 的设置面板「账号」组看，ccm 本身不提供列账号的子命令。
#
# `--tmux` 建**新**会话时会顺带把该目录标记为已信任（写 ~/.claude.json 或
# ~/.codex/config.toml），免得 claude/codex 在无人盯着的 detached 会话里卡在信任确认框——
# 设 CCM_NO_PRETRUST=1 可关闭这个行为（如你想自己手动确认每个新目录的信任）。
#
# **为什么必须是这个结构**（别"简化"掉，每条都有血）：
#  1. 环境（cwd / CLAUDE_CONFIG_DIR / 代理 / unset 嵌套 env）**必须在最终 exec 的那个 shell 里设**。
#     旧 `cct` 的做法是外层 export + 自建 tmux + send-keys，而 tmux 的 `update-environment`
#     默认列表不含 CLAUDE_CONFIG_DIR → export 在 tmux 进程边界上被整个吃掉，账号注入 100% 失效。
#     本 CLI 的 --tmux 因此**不在外层设 env**，而是把「同一条 ccm 命令、去掉 --tmux」送进 tmux 内部。
#  2. `exec` 不能省：身份回填 poller 读 `~/.claude/sessions/$PID.json`，不 exec 则 PID 对不上。
#  3. 所有 tmux `-t` 目标用 `=<名>:` 精确形态（见 doc/INVARIANTS.md §31a）。裸目标是
#     「精确→名字开头→glob」三级解析，会杀错/打错兄弟会话。尾冒号不能省。
#  4. 身份注册用**运行时自适应**而非编译期门控：装了就用，没装逐字节退化成裸 launcher。

set -u

# 2：B02 新增 --detach / --tmux-size（capabilities 变了）。本文件经 `sftp.rs` 的
# `include_str!` 部署到远端，版本号与 capabilities 一样是**外部可见契约**，不能只改后者。
CCM_VERSION="2"

# —— 自身绝对路径（--tmux 时要把自己送进容器；不依赖 PATH）——
if [ -z "${CCM_SELF:-}" ]; then
  _self="$0"
  case "$_self" in
    /*) : ;;
    *) _self="$(cd "$(dirname "$_self")" 2>/dev/null && pwd)/$(basename "$_self")" ;;
  esac
  CCM_SELF="$_self"
fi

# —— 配置。优先级：**环境变量 > 配置文件 > 内置默认**。
# 三个默认值必须先存下继承来的环境变量再赋值——否则会把 env 覆盖掉，
# 导致 `CCM_ACCTS_MANIFEST=/x ccm …` 这类隔离调用无效（测试与远端排障都要靠它）。
CCM_CONFIG="${CCM_CONFIG:-$HOME/.config/ccm/config}"
_env_ws="${CCM_WORKSPACE:-}"; _env_am="${CCM_ACCTS_MANIFEST:-}"; _env_ev="${CCM_ENV:-}"
# 内置默认刻意用**中性路径**：本文件会被 `include_str!` 原样部署到任意远端，
# 不能把某台机器的本地化目录（如 `$HOME/文档/...`）烧进去。要改走配置文件。
CCM_WORKSPACE="$HOME/claude-conversation"
CCM_ENV=""                                   # 起 agent 前 eval 的 env（旧 CC_ENV 迁移到这）
CCM_ACCTS_MANIFEST="$HOME/.claude-accts/accounts.json"
# shellcheck source=/dev/null
[ -f "$CCM_CONFIG" ] && . "$CCM_CONFIG"
[ -n "$_env_ws" ] && CCM_WORKSPACE="$_env_ws"
[ -n "$_env_am" ] && CCM_ACCTS_MANIFEST="$_env_am"
[ -n "$_env_ev" ] && CCM_ENV="$_env_ev"
unset _env_ws _env_am _env_ev

die() { printf 'ccm: %s\n' "$*" >&2; exit 2; }

# 带值 flag 的取值守卫。**盲取下一个 token 会把后面的 flag 当成值吃掉**——真机踩过：
# `ccm --tmux --account --print` 里 `--account` 吞掉了 `--print`，账号名变成字面量 "--print"，
# 会话照建、claude 照起，用户只在一闪而过的一行里看到报错。凡是要值的 flag 都过这道门。
need_val() { # need_val <flag名> <下一个token(可空)>
  [ -n "${2:-}" ] || die "$1 需要一个值"
  case "$2" in -*) die "$1 需要一个值，但拿到的是 '$2'（像是漏了参数）" ;; esac
}

# POSIX 单引号 quote（与前端 posixQuote 同算法）。**构造真正要执行的命令时一律用它。**
sq() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# 仅在必要时加引号 —— **只给 `--print` 的展示/等价断言用**。
# 目的：零修饰调用的输出与今天 `ccm()` 的 `exec claude` **逐字节一致**（`exec 'claude'` 虽等价但不逐字节）。
qarg() {
  case "$1" in
    ''|*[!A-Za-z0-9_@%+=:,./-]*) sq "$1" ;;
    *) printf '%s' "$1" ;;
  esac
}

# ===== agent 轴（哪个 AI）——CLI 主体零分支，全部查表 =====
# 与 src/agent-profile.ts 的 AGENT_PROFILE 对位；改这里要同步那边。
agent_default_launcher() { case "$1" in claude) echo claude ;; codex) echo codex ;; esac; }
agent_resume_flag()      { case "$1" in claude) printf '%s' "--resume" ;; codex) printf '' ;; esac; }
# 顺序照 unset 命令，与 AGENT_PROFILE.nestedEnvVars 逐字一致。
agent_nested_env()       {
  case "$1" in
    claude) echo "CLAUDECODE CLAUDE_CODE_ENTRYPOINT CLAUDE_CODE_SESSION_ID CLAUDE_CODE_CHILD_SESSION" ;;
    codex)  echo "" ;;
  esac
}
# 该 agent 有没有 per-PID session 文件（决定要不要起身份回填 poller）。
agent_has_identity()     { case "$1" in claude) return 0 ;; *) return 1 ;; esac; }
# 该 agent 需不需要把 tmux 会话名注入 CC_BUS_ID（cc-bus 多实例身份）。
#   codex：**需要**——它的模型-shell 沙箱(Landlock/seccomp)够不着 tmux 服务端 socket，
#     `cc-whoami` 在那里没法靠 tmux 解析身份；`CC_BUS_ID` 是它最高优先级且唯一不依赖
#     tmux 的来源（`cc-whoami:10`），且环境变量能透进沙箱。不注入 → cc-send 的 FROM = unknown。
#   claude：**不要**——它的 shell 工具能用 tmux，强设会盖掉用来细分「同会话多 CC」的 `@cc_id`
#     （见 `cc-spawn:104-109` 的同一判断）。
agent_needs_bus_id()     { case "$1" in codex) return 0 ;; *) return 1 ;; esac; }

# ===== cc-bus 身份注入：一段逻辑、两种表示（U9a）=====
#
# **病**：这段派生原先只长在真 exec 那条路上，`--print` 一个字都没说。而 `--print` 的定位是
# **平价预言机**（「打印将要执行的命令」，`e2e/ccm-print-parity.sh` 拿它当唯一能离线验证
# 渲染器意图的手段）——于是 codex + 已在 tmux 内那一格，预言机漏报了一个真的会被 export 的
# 变量，且**没有任何判据会因此变红**。
#
# **为什么不能让 `--print` 直接把值打出来**：那会当场破掉本文件另一条更老的纪律
#（见下方 `--tmux` 撞名那段的头注：「`--print` 必须是**纯的**…不能依赖实时 tmux 状态」）。
# 值只有运行时才知道 ⇒ **打印的是配方，不是值**，求值推迟到那条串真正被执行的时候。
# 这样 `--print` 对宿主 `TMUX` 仍然逐字节稳定，44 条黄金串不需要为实现让路。
#
# ⚠ 于是这段逻辑有**两种表示**：函数（exec 路用）与文本（print 路用）。它们**无法真正
#   共用一处** —— 那条串跑在别人的 shell 里，看不见本文件的函数。保证二者一致的是
#   差分判据 `e2e/ccm-contract-parity.sh` A 组（同一组 flag，print 串跑出来的环境
#   必须逐字等于真跑出来的环境），**不是人的记性**。
#
# 判空不能省：`[ -n "$v" ] && export` —— tmux 查不到时若照样 export 一个空串，
# `cc-whoami:10` 会拿到一个「最高优先级的空身份」，比不设更坏。
derive_bus_id() {
  agent_needs_bus_id "$1" && [ -n "${TMUX:-}" ] || { printf ''; return 0; }
  tmux display-message -p '#S' 2>/dev/null
  return 0   # tmux 缺失时 rc=127 会透出去；本文件今天没有 set -e，但别把这个留给以后
}
# 上面那个函数的文本表示（只在 `--print` 里用）。是否输出它由 `agent_needs_bus_id` 决定 ——
# 那是纯的（只看 flag），`TMUX` 判断留在串里、执行时才求值。
BUS_ID_RECIPE='if [ -n "${TMUX:-}" ]; then _ccm_bus="$(tmux display-message -p "#S" 2>/dev/null)"; [ -n "$_ccm_bus" ] && export CC_BUS_ID="$_ccm_bus"; unset _ccm_bus; fi;'

# ===== F06b（C4）：resume 的 argv 向 daemon 要 —— 同样是「一段逻辑、两种表示」=====
#
# C4：ccm 只上报上下文 → **拿 argv** → 设 env → `exec`。daemon 侧 `--resolve` 早已做好
# （`remote-daemon-proto/src/control/resolve_query.rs`：stdin `ResumeSpec`{`sessionId` 必填}
# → stdout `CommandPlan`{`command` 是**唯一可信的一项**}）。缺的一直是 ccm 这一侧的调用。
#
# ⚠ **照上面 `derive_bus_id`/`BUS_ID_RECIPE` 的先例写**，一个字都不新发明：
#   函数给 exec 路用、文本给 print 路用，**是否输出配方**由**纯的**条件决定
#   （那里是 `agent_needs_bus_id`，这里是 `action=resume` 且没显式 `--launcher`），
#   而**运行时才知道的那部分**（那里是 `$TMUX`，这里是 `$CCM_DAEMON_BIN` 在不在）
#   **留在串里、执行时才求值**。⇒ `--print` 仍然是纯的。
#
# ⚠ **显式 `--launcher` 优先于 daemon 的建议**〔自 08-04，理由进 DECISIONS §2〕：
#   `--launcher` 是调用方当场写下的覆盖，daemon 给的是它对这个 sid 的**建议**。
#   让远端建议压掉本地显式覆盖，等于让 `--launcher` 在 resume 上静默失效 —— 而
#   「写了个修饰、看起来生效了、其实被吃掉」正是本文件反复消灭的病（见 `attach` 那段头注）。
#
# ⚠ **拿不到就走本地那条，不报错**（定框 §5：诚实降级）。daemon 没装 / 没起 / 答非所问，
#   `ccm resume` 都必须照今天的样子跑起来 —— 这条失败是**静默**的，钉它的是
#   `e2e/ccm-contract-parity.sh` A′ 组的两条**绝对断言**（逐字钉住本地行为）。
resolve_from_daemon() {   # $1=sid → stdout: daemon 给的 command 串（拿不到就空）
  [ -n "${CCM_DAEMON_BIN:-}" ] && [ -x "${CCM_DAEMON_BIN}" ] || { printf ''; return 0; }
  printf '{"sessionId":"%s"}' "$1" | "$CCM_DAEMON_BIN" --resolve 2>/dev/null \
    | grep -o '"command":"[^"]*"' | head -1 | cut -d'"' -f4
  return 0
}
# 上面那个函数的文本表示（只在 `--print` 里用）—— 与函数体逐行同构，改一边必须改另一边。
# 保证二者一致的是 `e2e/ccm-contract-parity.sh` **A′ 组**（print↔exec 的 argv 差分），
# 不是人的记性。⚠ 那一组是 F06b-1b 专为本次接线先立的网：立网之前，接一半都会安静地绿。
# 用法：`resolve_recipe <sid> <本地兜底的 exec 串>` → stdout 一行 shell。
resolve_recipe() {
  local sid_json="{\"sessionId\":\"$1\"}"
  printf '%s' "_ccm_c=\"\"; if [ -n \"\${CCM_DAEMON_BIN:-}\" ] && [ -x \"\$CCM_DAEMON_BIN\" ]; then"
  printf '%s' " _ccm_c=\"\$(printf '%s' $(sq "$sid_json") | \"\$CCM_DAEMON_BIN\" --resolve 2>/dev/null"
  printf '%s' " | grep -o '\"command\":\"[^\"]*\"' | head -1 | cut -d'\"' -f4)\"; fi;"
  printf '%s' " if [ -n \"\$_ccm_c\" ]; then exec \$_ccm_c; else $2; fi"
}

# ===== 默认值 =====
action=new
sid=""
attach_name=""
use_tmux=0
tmux_name=""
account=""
use_base=0
cwd_spec=auto
agent=claude
model=""
launcher=""
ccm_sid=""
do_print=0
detach=0
tmux_size=""
passthru=()

# ===== 参数解析 =====
# 动作可以是位置参数（new/resume/attach），其余一律 flag。`--` 之后全部透传给 agent。
if [ $# -gt 0 ]; then
  case "$1" in
    new)    action=new; shift ;;
    # 下一个 token 以 `-` 开头 → 用户漏了参数（`ccm resume --tmux` 会静默把 --tmux 当 sid）
    resume) action=resume; shift
            { [ $# -gt 0 ] && case "$1" in -*) false ;; *) true ;; esac; } || die "resume 需要 <sid>"
            sid="$1"; shift ;;
    attach) action=attach; shift
            { [ $# -gt 0 ] && case "$1" in -*) false ;; *) true ;; esac; } || die "attach 需要 <会话名>"
            attach_name="$1"; shift ;;
  esac
fi

while [ $# -gt 0 ]; do
  case "$1" in
    --) shift; passthru+=("$@"); break ;;
    # `--resume <sid>` 与 `resume <sid>` 等价 —— cc-monitor 今天就是这么拼的，
    # 于是 F02 一落地、前端零改动就已经正确（MASTERPLAN §0 推论④）。
    --resume)      shift; need_val "--resume" "${1:-}"; action=resume; sid="$1" ;;
    --resume=*)    action=resume; sid="${1#*=}" ;;
    --tmux)        use_tmux=1 ;;
    --tmux=*)      use_tmux=1; tmux_name="${1#*=}" ;;
    --account)     shift; need_val "--account" "${1:-}"; account="$1" ;;
    --account=*)   account="${1#*=}" ;;
    --base)        use_base=1 ;;
    --cwd)         shift; need_val "--cwd" "${1:-}"; cwd_spec="$1" ;;
    --cwd=*)       cwd_spec="${1#*=}" ;;
    --agent)       shift; need_val "--agent" "${1:-}"; agent="$1" ;;
    --agent=*)     agent="${1#*=}" ;;
    --model)       shift; need_val "--model" "${1:-}"; model="$1" ;;
    --model=*)     model="${1#*=}" ;;
    --launcher)    shift; need_val "--launcher" "${1:-}"; launcher="$1" ;;
    --launcher=*)  launcher="${1#*=}" ;;
    --ccm-sid)     shift; need_val "--ccm-sid" "${1:-}"; ccm_sid="$1" ;;
    --ccm-sid=*)   ccm_sid="${1#*=}" ;;
    --detach)      detach=1 ;;
    --tmux-size)   shift; need_val "--tmux-size" "${1:-}"; tmux_size="$1" ;;
    --tmux-size=*) tmux_size="${1#*=}" ;;
    --print)       do_print=1 ;;
    --ccm-probe)
      printf 'name=ccm\nversion=%s\nself=%s\ncapabilities=new,resume,attach,tmux,account,model,cwd,agent,launcher,ccm-sid,print,detach,tmux-size\nagents=claude,codex\n' \
        "$CCM_VERSION" "$CCM_SELF"
      exit 0 ;;
    --version)     printf 'ccm %s\n' "$CCM_VERSION"; exit 0 ;;
    -h|--help)     sed -n '/^# 用法：/,/^# \*\*为什么/p' "$CCM_SELF" | sed '$d' | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*)            die "未知选项: $1（用 --help 看用法）" ;;
    *)             die "多余的位置参数: $1（动作只能是 new/resume/attach 且必须在最前）" ;;
  esac
  shift
done

case "$agent" in claude|codex) : ;; *) die "未知 agent: $agent（支持 claude|codex）" ;; esac
[ -n "$account" ] && [ "$use_base" = 1 ] && die "--account 与 --base 互斥"

# `--detach` / `--tmux-size` 只在容器路径有意义。**不静默忽略**——静默忽略正是本工作区
# 反复消灭的那类病（写了个修饰、看起来生效了、实际被吃掉）。
[ "$detach" = 1 ] && [ "$use_tmux" != 1 ] && die "--detach 需要配合 --tmux（非容器路径没有会话可 detach）"
[ -n "$tmux_size" ] && [ "$use_tmux" != 1 ] && die "--tmux-size 需要配合 --tmux"
# 尺寸会被拼进 `tmux new-session -x W -y H`，**必须**只允许纯数字，否则就是一条注入面。
if [ -n "$tmux_size" ]; then
  # 不用 extglob（本脚本没开 shopt，且要保持可移植）：逐条排除法等价于「<数字>x<数字>」
  # ——只含数字与 x、不以 x 开头/结尾、有且仅有一个 x。
  case "$tmux_size" in
    *[!0-9x]* | x* | *x | *x*x* | '')
      die "非法 --tmux-size: '$tmux_size'（要 <宽>x<高>，如 220x50，且均为正整数）" ;;
  esac
fi
if [ "$action" = resume ] && [ -z "$(agent_resume_flag "$agent")" ]; then
  die "agent=$agent 不支持 resume（无 resume flag）"
fi

# ===== L2 环境：cwd =====
# `auto` 逐字复刻旧 `_cc_resolve_target`：在 $HOME 用工作区；在 git 仓用其父目录；否则当前目录。
resolve_cwd() {
  if [ "$cwd_spec" != auto ]; then printf '%s' "$cwd_spec"; return; fi
  # **auto 只对 `new` 生效**。resume/attach 的目标目录由 sid/会话决定、调用方已经定位好
  # （cc-monitor 发的是 `cd '<会话cwd>' && ccm --resume <sid>`）；再 auto 解析一次会把
  # 工作目录换成 git 仓的**父目录** → Claude 按 `projects/<enc(cwd)>/<sid>.jsonl` 找不到会话。
  # 实测踩过：在任何 git 仓里 `ccm --resume <sid>` 都会跑偏。
  if [ "$action" != new ]; then printf '%s' "$PWD"; return; fi
  local r
  if [ "$PWD" = "$HOME" ]; then
    r="$CCM_WORKSPACE"
  else
    local g
    g="$(git rev-parse --show-toplevel 2>/dev/null)"
    if [ -n "$g" ]; then r="$(dirname "$g")"; else r="$PWD"; fi
  fi
  # 旧 `_cc_resolve_target` 结尾有 `mkdir -p "$REPLY"` —— 保住它：在 $HOME 首次敲 `cc` 时
  # 工作区可能还不存在，没有这句会直接报"无法进入目录"。**只在 auto 路径建**（显式
  # `--cwd <dir>` 不代建：cc-monitor 传的是已存在的会话目录，代建会掩盖"目录被删/移走"）。
  [ "$do_print" = 1 ] || mkdir -p "$r" 2>/dev/null || true
  printf '%s' "$r"
}
cwd="$(resolve_cwd)"

# ===== L1 容器：会话名派生 =====
# 与前端 `deriveTmuxName` 同规则（basename → 非 [A-Za-z0-9_-] 换 `-` → 折叠 → 截 32 → 剥首尾 `-`）。
# 同规则 = 终端 `cct` 与 app「开新 Claude」在同一目录造出**同一个名字** → 幂等接回同一会话。
derive_tmux_name() {
  local b s
  b="$(printf '%s' "$1" | sed 's:/*$::')"   # 去掉全部尾斜杠（对齐 TS 的 /\/+$/）
  b="${b##*/}"
  s="$(printf '%s' "$b" | sed 's/[^A-Za-z0-9_-]/-/g; s/--*/-/g' | cut -c1-32 | sed 's/^-*//; s/-*$//')"
  # S4b-3b（用户 2026-07-31）：`cc-` 前缀反转成 `-cc` 后缀。与前端 `deriveTmuxName`
  # 逐字同规则（跨语言双写点，`e2e/ccm-cli.test.sh` 真值对拍钉住）。
  if [ -n "$s" ]; then printf '%s-cc' "$s"; else printf 'session-cc'; fi
}

# 撞名策略**按调用方分成两条**（2026-07-31 修，用户实测报障后改）：
#
#   `--tmux=<名>`（显式名）→ **不避让**，幂等接回。调用方（cc-monitor）自己算好了要哪个
#     会话（如灰会话 fresh resume 的 `cc-<sid8>-2`），CLI 再改一次就错了。
#   `--tmux`（无名）    → **无条件新建**，撞名就退到 `-2/-3`。
#
# 原先两者共用「不避让 + 幂等接回」，理由是「同目录再开一次会产孤儿（实测踩过）」。
# **那个理由只对显式名成立。** 复核（2026-07-31）：`src/launch-render-cli.ts:95` 显示
# cc-monitor 起会话时**永远**传 `--tmux=<名>`；无名的 `--tmux` 只出现在两处 ——
# 给用户复制的诊断文案，和别名块 `cct() { ccm --tmux "$@"; }`，也就是**用户在终端里敲的
# 那一下**。这条路径上**没有任何调用方对名字有期望**，所以不存在「谁被搞糊涂了」。
#
# 用户报的病：在某目录已经有会话的情况下，**新开一个终端**进同一目录敲 `cct`，会被
# attach 进那个正在被别处用着的会话（两个终端镜像同一个窗口、按键互相打架）。
# 「我既然新开一个终端在这个路径 cc 了，我肯定是要新建窗口而非 attach」—— 这是对的：
# 终端里那一下**从来就不是**「接回我 detach 的那个」，而是「再来一个」。

# ===== L2 环境：账号 =====
# 从 cc-acct-iso 的 manifest 解析 configDir。解析不到 → 报错退出（显式选号绝不静默降级）。
# **只回显值、绝不 die** —— 本函数在 `$(...)` 里被调用，`die`(exit 2) 只会杀掉子 shell，
# 主流程照跑 → 用户打错账号名会**静默落到继承来的账号上**（rc=0）。实测踩过，性质比
# 「换号不生效」更坏。所有失败一律回空串，由**顶层**判空后中止。
account_config_dir() {
  local name="$1" dir=""
  [ -f "$CCM_ACCTS_MANIFEST" ] || { printf ''; return; }
  if command -v jq >/dev/null 2>&1; then
    dir="$(jq -r --arg n "$name" '.accounts[] | select(.name==$n) | .configDir // empty' "$CCM_ACCTS_MANIFEST" 2>/dev/null)"
  else
    # 无 jq 的兜底：按 name 定位同一对象里的 configDir（manifest 是每账号一行的紧凑格式）。
    dir="$(grep -o "\"name\"[[:space:]]*:[[:space:]]*\"$name\"[^}]*\"configDir\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" \
            "$CCM_ACCTS_MANIFEST" 2>/dev/null | sed 's/.*"configDir"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')"
  fi
  [ -n "$dir" ] && [ -d "$dir" ] || { printf ''; return; }
  printf '%s' "$dir"
}

# manifest 里的账号名列表（给错误信息用——报"不可用"必须同时告诉用户有哪些可用）。
list_account_names() {
  [ -f "$CCM_ACCTS_MANIFEST" ] || { printf '(无账号库)'; return; }
  if command -v jq >/dev/null 2>&1; then
    jq -r '[.accounts[].name] | join(" ")' "$CCM_ACCTS_MANIFEST" 2>/dev/null
  else
    grep -o '"name"[[:space:]]*:[[:space:]]*"[^"]*"' "$CCM_ACCTS_MANIFEST" 2>/dev/null \
      | sed 's/.*"\([^"]*\)"$/\1/' | tr '\n' ' '
  fi
}

# manifest 里的默认账号（`isDefault: true`）。
default_account_name() {
  [ -f "$CCM_ACCTS_MANIFEST" ] || { printf ''; return; }
  if command -v jq >/dev/null 2>&1; then
    jq -r '.accounts[] | select(.isDefault==true) | .name' "$CCM_ACCTS_MANIFEST" 2>/dev/null | head -1
  else
    grep -o '"name"[[:space:]]*:[[:space:]]*"[^"]*"[^}]*"isDefault"[[:space:]]*:[[:space:]]*true' \
      "$CCM_ACCTS_MANIFEST" 2>/dev/null | head -1 | sed 's/.*"name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/'
  fi
}

# 账号解析。三态：
#   显式 --account X  → 必须解析成功，否则**中止**（显式选号绝不静默降级到别的号）
#   显式 --base       → 不注入（issue #75 逃生口：装账号功能前的老会话住基座）
#   都不传            → 落 manifest 的 isDefault（复刻旧 `_cc_acct_last` 的粘滞体验）。
#     **这条必须有**：cc-acct-iso 把凭据搬进各账号目录后，基座 `~/.claude/.credentials.json`
#     通常已不存在 —— 不落默认号的话，最常敲的 `cc`/`cct` 会掉进一个没登录的 config dir。
config_dir=""
if [ -n "$account" ]; then
  config_dir="$(account_config_dir "$account")"
  [ -n "$config_dir" ] || die "账号 '$account' 不可用（不在 $CCM_ACCTS_MANIFEST，或其目录不存在）。可用: $(list_account_names)"
elif [ "$use_base" != 1 ] && [ -z "${CLAUDE_CONFIG_DIR:-}" ]; then
  # **只在调用方没有已选定账号时才落默认号**（真机复现过的 bug：cc-monitor 把
  # `resumeCommandRemote` 配成 ccm 时，是「外层已 export 好账号 X 的 CLAUDE_CONFIG_DIR，
  # 再 exec ccm --resume <sid>（不带任何账号 flag）」——这条路径下，若无脑落默认号，会把
  # cc-monitor 精心选中的账号 X **静默覆盖**成 manifest 的 isDefault，等于账号选择完全失效。
  # 加 `-z "${CLAUDE_CONFIG_DIR:-}"` 这道闸：已有继承来的账号 → 尊重它、不覆盖；
  # 真正的"空白终端裸敲 cc/cct"（无继承）才落默认号——两个场景用同一条 if 天然区分。
  _def="$(default_account_name)"
  if [ -n "$_def" ]; then
    config_dir="$(account_config_dir "$_def")"
    [ -n "$config_dir" ] || die "默认账号 '$_def' 目录不存在（manifest 说它是 isDefault）。用 --base 起基座，或 --account <名> 指定。"
    account="$_def"
  fi
fi

# ===== L3/L4：启动器与参数 =====
# 显式 `--launcher` 要优先于 daemon 的建议（见 resolve_from_daemon 头注）——
# 必须在填默认值**之前**记下来，填完就分不清「用户写的」与「默认的」了。
launcher_explicit=0; [ -n "$launcher" ] && launcher_explicit=1
[ -n "$launcher" ] || launcher="$(agent_default_launcher "$agent")"
nested="$(agent_nested_env "$agent")"

argv=("$launcher")
if [ "$action" = resume ]; then
  rf="$(agent_resume_flag "$agent")"
  argv+=("$rf" "$sid")
fi
[ ${#passthru[@]} -gt 0 ] && argv+=("${passthru[@]}")

# ===== attach：不起 agent，直接接回 =====
if [ "$action" = attach ]; then
  # B02 审计重要-4：`attach` 分支在这里就 exec 掉了，早于下面的容器逻辑，所以
  # `ccm attach foo --tmux --detach` 会**静默吞掉** `--detach` 照样 attach。
  # 静默忽略正是本工作区反复消灭的病（写了个修饰、看起来生效了、其实被吃掉）。
  [ "$detach" = 1 ] && die "attach 动作与 --detach 矛盾（attach 的语义就是接进去）"
  [ -n "$tmux_size" ] && die "attach 动作不支持 --tmux-size（接回既有会话，尺寸归它自己）"
  cmd="tmux attach -t $(sq "=$attach_name:")"
  if [ "$do_print" = 1 ]; then printf '%s\n' "$cmd"; exit 0; fi
  exec tmux attach -t "=$attach_name:"
fi

# ===== --tmux：把「同一条 ccm 命令、去掉 --tmux」送进容器内部 =====
# 关键：**外层一个 env 都不设**。env 由容器内部那次 ccm 调用自己设 —— 这样它落在最终 exec 的
# 那个 shell 里，穿得过 tmux 的进程边界（旧 cct 正是死在这一步）。
# **已经在 tmux 里 → 就地起**（旧 `cct` 有这条分支：`if [ -n "$TMUX" ]; then … return; fi`）。
# 不然会另建一个 detached 会话、agent 跑在用户看不见的地方，而 `tmux attach` 报
# "sessions should be nested with care" rc=1 → 用户原地不动、什么也没拿到（实测）。
# cc-monitor / cc-bus 用户基本常驻 tmux，这条必须有。
if [ "$use_tmux" = 1 ] && [ -n "${TMUX:-}" ] && [ -z "$tmux_name" ]; then
  # B02 审计重要-4：这条分支把 `use_tmux` 清零 → 不再走容器路径 → `--detach` /
  # `--tmux-size` 双双落空。对 `--detach` 尤其危险：调用方要的是"建完就返回"，
  # 拿到的却是**阻塞式 exec**（就地把当前 shell 换成 agent），语义完全相反。
  # 显式 die：要么别在 tmux 里用无名 --tmux，要么给个显式会话名走真容器路径。
  if [ "$detach" = 1 ] || [ -n "$tmux_size" ]; then
    die "已在 tmux 内且未给会话名 → 会就地起而非建容器，--detach/--tmux-size 无法生效。请用 --tmux=<显式名>"
  fi
  use_tmux=0
fi

if [ "$use_tmux" = 1 ]; then
  command -v tmux >/dev/null 2>&1 || die "未安装 tmux"
  if [ -n "$tmux_name" ]; then
    # 显式 `--tmux=<名>` 是一条**创建**路径 → 过 INVARIANTS §31a 的第二道防线：
    # 禁 glob `*`/`?`（`kill-session -t 'a*a'` 实测会命中并杀掉 `alpha`）、禁 tmux 保留字
    # `.`/`:`（session:window.pane 分隔符）、禁前导 `-`（会被当成选项）、禁控制字符与空串。
    # 与前端 `isValidNewTmuxName` 同一套判据（`src/remote-launch.ts`）。
    case "$tmux_name" in
      ""|-*)        die "非法 tmux 会话名（空或以 - 开头）: '$tmux_name'" ;;
      # ★ F15 在下面那行加了 `=`：**别创建一个主路杀不掉的名字。**
      #   kill 的主路从 F04b 起走 daemon（`remote-daemon-proto/src/control/kill.rs`），它的形状门
      #   逐字拒 `:` 与 `=`（「它们是 tmux 目标语法」），且**按设计不回落**（回落到 shell 路 =
      #   把一次形状拒绝洗成另一条路的成功）。而这里原本只禁 `. : * ?`，加上 `--tmux=*` 的取值是
      #   `${1#*=}`（剥到第一个 `=`）⇒ `ccm --tmux=proj=x` 能建出 `proj=x`，通道 B 还会给它写真
      #   `@ccm_sid` ⇒ Gate 2 通过、正常出现在 monitor 列表里，而「结束会话」永远 `invalid_args`
      #   ⇒ **那个会话在 UI 上杀不掉**（F04b 之前那条 SSH 串杀得掉它）。实测过：改之前
      #   `ccm new --tmux=proj=x --print` 产的就是 `new-session -d -s 'proj=x'`。
      # ⚠ 上面那句「与前端 `isValidNewTmuxName` 同一套判据」—— **F04b 之后曾经是假的**
      #   （F04b 只给 TS 那份加了 `=`，跨轨钉也只读了 TS 那一份）。加上这个字符之后它重新成立，
      #   并由 Rust 侧那条**遍历式**的创建路径登记表钉住（见 `daemon_kill.rs`）。
      *[*?.:=]*)     die "非法 tmux 会话名（含 glob 或 tmux 目标语法 * ? . : =）: '$tmux_name'" ;;
      *[[:cntrl:]]*) die "非法 tmux 会话名（含控制字符）: '$tmux_name'" ;;
    esac
    # 显式名到此为止 —— **不做派生、不做避让**。调用方（cc-monitor）传显式名正是因为它
    # 自己算好了要哪个会话（如灰会话 fresh resume 的 `cc-<sid8>-2`），CLI 再改一次就错了。
  else
    tmux_name="$(derive_tmux_name "$cwd")"
    # **无条件避让**：名字被占就退到 `-2/-3/...`，不问它是不是同一个目录。
    #
    # 这一条同时覆盖了原先那个更窄的判据（同名但异目录：派生规则会把 basename 全非 ASCII
    # 的目录一律塌成 `cc-session`，`~/文档` 与 `~/下载/测试` 同名，不避让会**接回前者里那个
    # claude**）—— 无条件避让是它的超集，故那段单独的 cwd 比对已删。
    #
    # **只在真建会话时查**：`--print` 必须是**纯的**（F03 要拿它做渲染等价断言），
    # 不能依赖实时 tmux 状态。`--print` 展示基名；真跑时撞名会退让到 `-N`。
    # ⚠ U9a 2026-08-02 **确认这条纪律仍然有效、没有例外**：`CC_BUS_ID` 那次是靠
    #   **打印配方而不是打印值**（`BUS_ID_RECIPE`）来同时满足「说全」与「保持纯」的。
    #   避让为什么不能照办：配方要判的是「这个名字被占没被占」，那**必须**在真跑时查，
    #   而查到的结果会改变**名字本身** —— 名字是黄金串的主体，不是可以推迟求值的一段 env。
    #   ⇒ 撞名避让归 `ccm-acceptance` 场景 5/5bis（真 tmux）管，见 `doc/INVARIANTS.md` §33a。
    if [ "$do_print" != 1 ] && tmux has-session -t "=$tmux_name:" 2>/dev/null; then
      _n=2
      while tmux has-session -t "=$tmux_name-$_n:" 2>/dev/null; do
        _n=$((_n+1))
      done
      tmux_name="$tmux_name-$_n"
    fi
  fi

  # F11（unify-launch）：预信任 $cwd，免 claude/codex 起来卡在信任确认框数小时（detached
  # 会话没人盯着按 Enter）。逻辑原样搬自 cc-bus 的 cc-spawn（已生产验证过，照抄不重新设计），
  # 测试钩子改名 CCM_CLAUDEJSON/CCM_CODEXTOML（对齐 CCSPAWN_* 的既有命名模式）。
  # **`--print` 跳过**——预信任是写文件的副作用，`--print` 必须纯（同上方 tmux 状态查询的既有纪律）。
  # **维护提示**：这段逻辑与 cc-spawn 里的同名实现目前仍是重复实现，但 **B01 之后两者已同仓**
  # （`shared/cc-bus/scripts/cc-spawn`，不再是"分属不同仓库、没有共享源可抽"）。**B02 的任务
  # 正是消除这处重复**：cc-spawn 改为经 `ccm` 起会话，届时这段就是唯一实现、本提示可删。
  # 在 B02 落地之前，改动这里仍需手动对拍 `shared/cc-bus/scripts/cc-spawn` 的同名逻辑
  # （如 TOML 转义字符集、jq 校验），差别在于**现在同仓可写测试检测漂移了**。**例外**：`CCM_NO_PRETRUST`
  # 逃生口是 `ccm` 独有的、cc-spawn 没有对应机制——这处差异是有意的（受众判断不同，见下方
  # opt-out 处的说明），对拍 cc-spawn 时不要把这条误判成"漏同步"。
  pretrusted=0
  # Phase D 审计（重要项修复）：ccm --tmux 是 cc-monitor 主 UI 的默认统一实现（受众比 cc-spawn
  # 这类窄众协作工具宽得多），照搬一个无退出口的行为不合适——加 CCM_NO_PRETRUST=1 逃生口
  # （已写进 --help 文本）。
  if [ "$do_print" != 1 ] && [ "${CCM_NO_PRETRUST:-}" != 1 ]; then
    # Phase D 审计（阻塞项修复）：cc-spawn 的 $absdir 恒经 `cd && pwd` 规范化，本脚本的 $cwd
    # 在 `--cwd <相对路径>` 时**不**保证是绝对路径（`resolve_cwd` 对非 auto 值原样透传）——
    # 若直接拿 $cwd 当 JSON/TOML key，会写出字面量 "."/"../foo" 这种野 key：① 对真实的
    # Claude/Codex 信任表毫无意义（它们用真绝对路径查），预信任完全零效果；② 还会往用户
    # 真实的 ~/.claude.json/~/.codex/config.toml 里永久塞一条垃圾条目，且 `jq -e .` 校验照样
    # 通过、不报任何错——已实测复现。修法：预信任专用一份规范化路径 $cwd_abs，解析失败
    # （目录已消失等极端情况）就放弃预信任而非拿一个可能错误的相对路径瞎写。
    cwd_abs="$(cd "$cwd" 2>/dev/null && pwd)" || cwd_abs=""
    if [ -n "$cwd_abs" ]; then
      if [ "$agent" = claude ]; then
        cj="${CCM_CLAUDEJSON:-$HOME/.claude.json}"
        if [ -f "$cj" ] && command -v jq >/dev/null 2>&1; then
          if jq -e --arg d "$cwd_abs" '.projects[$d].hasTrustDialogAccepted == true' "$cj" >/dev/null 2>&1; then
            pretrusted=1
          else
            cp -p "$cj" "$cj.bak-ccm.$$" 2>/dev/null || true
            tmpj="$cj.tmp.ccm.$$"
            if jq --arg d "$cwd_abs" '(.projects[$d].hasTrustDialogAccepted) = true' "$cj" > "$tmpj" 2>/dev/null \
               && jq -e . "$tmpj" >/dev/null 2>&1; then
              mv "$tmpj" "$cj"; pretrusted=1; rm -f "$cj.bak-ccm.$$"
            else
              rm -f "$tmpj"; echo "ccm: 预信任写入失败（claude 起来可能弹信任框，已备兜底）" >&2
            fi
          fi
        fi
      elif [ "$agent" = codex ]; then
        ct="${CCM_CODEXTOML:-$HOME/.codex/config.toml}"
        mkdir -p "$(dirname "$ct")" 2>/dev/null || true
        [ -f "$ct" ] || : > "$ct"
        # 路径含控制字符会破坏 TOML → 跳过预信任（同 cc-spawn；正常路径含空格/unicode/"/\ 无碍）。
        if [[ "$cwd_abs" == *[[:cntrl:]]* ]]; then
          echo "ccm: codex 预信任跳过——目录路径含控制字符（会破坏 config.toml）" >&2
        else
          cesc=${cwd_abs//\\/\\\\}; cesc=${cesc//\"/\\\"}
          ( flock 9
            if ! grep -qF "[projects.\"$cesc\"]" "$ct" 2>/dev/null; then
              cp -p "$ct" "$ct.bak-ccm.$$" 2>/dev/null || true
              if printf '\n[projects."%s"]\ntrust_level = "trusted"\n' "$cesc" >> "$ct" 2>/dev/null; then
                rm -f "$ct.bak-ccm.$$"
              else
                [ -f "$ct.bak-ccm.$$" ] && mv -f "$ct.bak-ccm.$$" "$ct"
                echo "ccm: codex 预信任写入失败（codex 起来可能弹信任框）" >&2
              fi
            fi
          ) 9>>"$ct.lock"
          grep -qF "[projects.\"$cesc\"]" "$ct" 2>/dev/null && pretrusted=1
        fi
      fi
    fi
  fi

  # 内层命令 = 自己 + 全部修饰（去掉 --tmux，cwd 固化为已解析值，避免容器内重新 resolve）
  inner=("$CCM_SELF")
  [ "$action" = resume ] && inner+=(resume "$sid")
  inner+=(--cwd "$cwd" --agent "$agent")
  [ -n "$account" ] && inner+=(--account "$account")
  [ "$use_base" = 1 ] && inner+=(--base)
  [ -n "$model" ] && inner+=(--model "$model")
  [ -n "$launcher" ] && inner+=(--launcher "$launcher")
  [ -n "$ccm_sid" ] && inner+=(--ccm-sid "$ccm_sid")
  # `--detach` / `--tmux-size` **不**转发：它们是外层容器自身的属性（要不要 attach、
  # 新建窗口多大），内层没有 --tmux，转发过去只会撞上「--detach 需要配合 --tmux」。
  [ ${#passthru[@]} -gt 0 ] && inner+=(-- "${passthru[@]}")

  payload=""
  for a in "${inner[@]}"; do payload="$payload${payload:+ }$(sq "$a")"; done

  # R08（2026-07-28 实测复现并修复）：**继承来的账号必须在这里被显式化**，否则会在容器边界丢掉。
  #
  # 账号解析（见上方 `config_dir=` 那段）有一条刻意的沉默分支：既没传 --account/--base、
  # 但 CLAUDE_CONFIG_DIR 已有继承值时，`account` 与 `config_dir` **都留空**——因为
  # "尊重继承值"在非容器路径下等于"什么都不做"（`exec` 保留进程环境，天然正确，这正是 R11 的修法）。
  #
  # 但容器路径不成立：send-keys 打进的是 **tmux server fork 出来的新 shell**，
  # 其环境来自 tmux server 全局环境，而 `update-environment` 默认列表**不含** CLAUDE_CONFIG_DIR
  # （MASTERPLAN §2.1 实测的那份列表）——继承值在 L1 边界被整个吃掉。内层 ccm 于是看到
  # "空的 CLAUDE_CONFIG_DIR + 没有账号 flag" → 落 manifest 默认号，把调用方选中的号静默换掉。
  # 症状与 R11 同型且同样隐蔽：**看起来生效了，只是换成了错的号。**
  #
  # 修法：把继承值写进载荷**内侧**（export 在 tmux 边界的里面，故穿得过去）。
  # 为什么不反查 manifest 换成 `--account <名>`：① 继承值可能指向 manifest 外的目录
  # （用户自己维护 CLAUDE_CONFIG_DIR 的边缘配置，见 R13），反查不到就没法表达；
  # ② 逐字节转发继承值语义最保真，不引入 名→目录 的二次解析。
  # 内层 ccm 收到后会命中它自己的 `-z "$CLAUDE_CONFIG_DIR"` 闸 → 尊重、不覆盖（复用 R11 的机制）。
  #
  # 三条不受影响：`--account` / 默认号回退（两者 `account` 非空 → 上面已发 --account）
  # 与 `--base`（已发 --base）；本分支只在"三者皆无、仅有继承值"时触发。
  if [ -z "$account" ] && [ "$use_base" != 1 ] && [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
    payload="export CLAUDE_CONFIG_DIR=$(sq "$CLAUDE_CONFIG_DIR"); $payload"
  fi

  t="$(sq "=$tmux_name:")"
  # `--tmux-size`：detached 会话默认 80x24，太窄会把 agent 输出折行（cc-spawn 一直用 220x50）。
  # 只对**新建**生效——幂等接回既有会话时 new-session 失败短路，尺寸自然不动，这是对的：
  # 已有会话的尺寸归它自己（可能有人正 attach 着），不该被后来的调用方改掉。
  # 已在上方校验过只含数字与单个 x，故此处直接拆开拼入无注入面。
  size_opt=""
  [ -n "$tmux_size" ] && size_opt=" -x ${tmux_size%x*} -y ${tmux_size#*x}"
  # 幂等建闸：会话已存在 → new-session 失败被吞、`&&` 短路跳过后续 → 只 attach（不重复起）。
  seq="tmux new-session -d -s $(sq "$tmux_name") -c $(sq "$cwd")$size_opt 2>/dev/null"
  seq="$seq && (tmux set-option -t $t @ccm_agent $(sq "$agent") 2>/dev/null || true)"
  # F04：通道A（意图）写 @ccm_sid_expect，不写 @ccm_sid——只有通道B（poller 独立读会话文件
  # 后确认）才写 @ccm_sid，破坏性动作（kill 等）只认 @ccm_sid，不被"声明了但从未真正跑起来"
  # 的会话骗过（见 doc/INVARIANTS.md 对应条目 / MASTERPLAN R10）。
  [ -n "$ccm_sid" ] && seq="$seq && (tmux set-option -t $t @ccm_sid_expect $(sq "$ccm_sid") 2>/dev/null || true)"
  seq="$seq && tmux send-keys -t $t $(sq "$payload") Enter"
  # Phase D 审计（阻塞项修复）：预信任只搬了"写入"，没搬 cc-spawn 真正的安全网——写入没成功
  # 时（jq/文件缺失/写失败，任何原因）轮询抓 pane 文本找信任框、自动按 Enter（同 cc-spawn
  # cc-spawn:122-133）。detached 会话没人盯着，且本地 tmux 会话在 cc-monitor 前端完全不可见
  # （capture-pane 预览只对远端 origin 开放）——没有这层兜底，信任框会静默卡死且没人发现。
  # 只对 claude 做（同 cc-spawn：codex 已由 config.toml 预信任生效，不弹这个交互框）；
  # `&&` 挂在 send-keys 之后，幂等接回既有会话时（new-session 失败短路）不会误触发轮询。
  # CCM_NO_PRETRUST=1 也关掉这条自动按 Enter 兜底——选择不自动管理信任的用户不该被这条
  # 换了个机制（每次自动按而非持久化写入）的路径悄悄绕过。
  # **`|| true` 不能省**（B02 审计阻塞-1，实测复现）：`for` 循环的退出码 = 最后一条命令的
  # 退出码，而**信任框没出现**（绝大多数正常情况）时最后一条是失败的 `grep -q`，循环 rc=1。
  # 在 `--detach` 出现之前，这个 rc 被尾部的 `; tmux attach` 冲掉了，没人看得见；`--detach`
  # 把 attach 摘掉之后它就直接成了 `exec bash -c "$seq"` 的退出码 —— 于是「预信任没生效」
  # （`~/.claude.json` 不存在 / 没装 jq / 该文件是坏 JSON）这条**良性**路径上，ccm 恒返回 1，
  # 调用方（cc-spawn）判定失败并跳过 `cc-register` 与台账，留下一个**真的在跑、却不在总线上
  # 的孤儿会话**，同时报出与事实相反的"建会话失败"。兜底本身是 best-effort，它的成败
  # 不该表达为整条链的成败。
  if [ "$agent" = claude ] && [ "$pretrusted" != 1 ] && [ "${CCM_NO_PRETRUST:-}" != 1 ]; then
    seq="$seq && { (for _i in 1 2 3 4 5 6; do sleep 0.5; tmux capture-pane -t $t -p 2>/dev/null | grep -q 'Yes, I trust this folder' && { tmux send-keys -t $t Enter; break; }; done) || true; }"
  fi
  # `--detach`：只建会话就返回，不 attach。
  # **为什么这是拆开而非新增**：`--tmux` 至此一直同时承担两件正交的事——「起一个容器」与
  # 「把当前终端 attach 进去」。cc-monitor 的 UI 两件都要（它开一个终端窗口给用户看），
  # 于是二者被焊在了一起；而 cc-spawn 只要前者：它建完还得拿 pane id 去 `cc-register`
  # 登记总线、写 `spawned.tsv` 台账、打印用法提示——attach 会当场夺走控制流，这些都做不成。
  # 焊在一起就是 MASTERPLAN §0 说的那个病（「一个动作 + 若干正交修饰」被写死成一套实现），
  # `--detach` 把「要不要 attach」还原成一个独立修饰。**默认仍 attach，既有调用方零感知。**
  [ "$detach" = 1 ] || seq="$seq; tmux attach -t $t"

  if [ "$do_print" = 1 ]; then printf '%s\n' "$seq"; exit 0; fi
  exec bash -c "$seq"
fi

# ===== 非容器路径：在**本进程**里设好环境，然后 exec =====
# 到这里就是最终 shell。exec 之后 PID 不变（$$），身份 poller 据此读 session 文件。

# --print：吐出等价的一行 shell（供 cc-monitor 等价断言 / 调试）。
if [ "$do_print" = 1 ]; then
  line=""
  [ -n "$CCM_ENV" ] && line="$line$CCM_ENV; "
  # 顺序与下面真 exec 那条路逐条对齐（CCM_ENV → CC_BUS_ID → 会话级 env → cd → exec）。
  # **输出的是配方不是值** —— 见 `BUS_ID_RECIPE` 头注：这样 `--print` 仍然不查实时 tmux 状态。
  agent_needs_bus_id "$agent" && line="$line$BUS_ID_RECIPE "
  [ -n "$config_dir" ] && line="${line}export CLAUDE_CONFIG_DIR=$(sq "$config_dir"); "
  [ "$use_base" = 1 ] && line="${line}unset CLAUDE_CONFIG_DIR; "
  [ -n "$model" ] && line="${line}export ANTHROPIC_MODEL=$(sq "$model"); "
  [ -n "$nested" ] && line="${line}unset $nested; "
  [ -n "$cwd" ] && line="${line}cd $(sq "$cwd") && "
  # 本地那条（今天的行为）先拼好 —— 它同时是配方里的兜底分支。
  local_exec="exec"
  for a in "${argv[@]}"; do local_exec="$local_exec $(qarg "$a")"; done
  if [ "$action" = resume ] && [ "$launcher_explicit" = 0 ]; then
    line="$line$(resolve_recipe "$sid" "$local_exec")"
  else
    line="$line$local_exec"
  fi
  printf '%s\n' "$line"
  exit 0
fi

# 机器级 env（代理等）——旧 `eval "$CC_ENV"` 的搬家，语义不变。
[ -n "$CCM_ENV" ] && eval "$CCM_ENV"
# cc-bus 身份：codex 沙箱够不着 tmux socket，须把会话名经 env 透进去（见 agent_needs_bus_id）。
# **必须无条件覆盖，不能写成 `${CC_BUS_ID:-…}`**（B02 审计重要-3，有可复现反例）：
# `:-` 是"缺省"，pane 环境里已有 `CC_BUS_ID` 就会沿用——而 tmux server 的全局环境继承自
# 起它的那个客户端，父 agent 的 `CC_BUS_ID` 会漏进来。cc-spawn 收编前用的是 send-keys 的
# `CC_BUS_ID=<name> ` env 前缀，那是**永远覆盖**。语义差别的后果不只是 `FROM` 写错：
# `cc-whoami:10` 把 `$CC_BUS_ID` 排在最高优先级，子 agent 的 Stop 钩子会去读**父 agent 的
# inbox**——身份冒用 + 抢信。会话名是这个会话身份的唯一事实来源，继承来的值一律不作数。
_sname="$(derive_bus_id "$agent")"   # ← 与 `--print` 共用同一处派生（见 derive_bus_id 头注）
[ -n "$_sname" ] && export CC_BUS_ID="$_sname"
unset _sname
# 会话级 env。--base 显式清残留（就地复用已存在 shell 时必需，见 issue #75）。
[ -n "$config_dir" ] && export CLAUDE_CONFIG_DIR="$config_dir"
[ "$use_base" = 1 ] && unset CLAUDE_CONFIG_DIR
[ -n "$model" ] && export ANTHROPIC_MODEL="$model"
# 嵌套会话标记：tmux server env 可能带毒（issue #24），起前一律清。
[ -n "$nested" ] && unset $nested
[ -n "$cwd" ] && { cd "$cwd" || die "无法进入目录: $cwd"; }

# ===== L5 身份 =====
# 通道A：已知 sid（cc-monitor 传的）→ 在容器内立刻打标**意图**（@ccm_sid_expect，非 @ccm_sid）。
# F04：这是声明"即将/正在尝试跑这个 sid"，不是"确认跑起来了"——resume 可能瞬间失败（会话已不存
# 在/网络抖动），若直接写 @ccm_sid 会让这个从未真正运行过的声明永久冒充"事实"（旧 D6 审计的坑）。
# 只有下面通道B（poller 独立读会话文件后才写）才算数，破坏性动作只认 @ccm_sid。
if [ -n "$ccm_sid" ] && [ -n "${TMUX:-}" ]; then
  tmux set-option @ccm_sid_expect "$ccm_sid" >/dev/null 2>&1 || true
fi
# 通道B：未知 sid（new，且随 /branch 漂移）→ 后台 poller 回填。exec 后 PID 不变，故用 $$。
if agent_has_identity "$agent"; then
  ccm_pid=$$
  sessions_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/sessions"
  if [ -n "${TMUX:-}" ]; then
    tmux set-option set-titles on >/dev/null 2>&1 || true
    # ★ 窗口标题**由 tmux 自己合成**，不再等于 pane 标题（`#T`）。
    #
    # 为什么改：monitor 靠扫 Windows 窗口标题里的 `ccm-rbind-<sid>` 来绑窗口，
    # 而 **claude 也在往 pane 标题写自己的状态**（转圈图标 + 当前在干什么）。
    # 用 `#T` 时两者抢同一个位置，claude 一忙就把 marker 冲掉；下面那个循环
    # 每 20 秒才补一次 ⇒ **点 ↗ 时的 4 秒现扫窗口去撞 20 秒一次的脉冲，约 1/5 命中**。
    # 真机实测（2026-07-31）：四个空闲会话 marker 都在、唯独忙碌那个被冲成
    # 「⠐ 理解…」，点 ↗ 必弹「未绑定窗口」。
    #
    # 换成从 `@ccm_sid` 直接合成之后，marker **常驻**：claude 写的是 pane 标题，
    # 而窗口标题走的是这条 format，两条路不再交叉。首次绑定不再看运气。
    #（`bind.rs` 那句「4s 若仍偶发不足，据真机再抬」是在症状层调参——抬窗口只能提高
    #  命中率，抬到 20s 才保证，而那样点一次要等 20 秒。根因在这里。）
    #
    # `#{?@ccm_sid,…,#T}`：sid 还没回填时回退 `#T`，不产出一个空的 `ccm-rbind-`。
    tmux set-option set-titles-string '#{?@ccm_sid,ccm-rbind-#{@ccm_sid},#T}' >/dev/null 2>&1 || true
  fi
  (
    prev="" n=0
    while kill -0 "$ccm_pid" 2>/dev/null; do
      s="$(grep -o '"sessionId":"[^"]*"' "$sessions_dir/$ccm_pid.json" 2>/dev/null | head -1 | cut -d'"' -f4)"
      n=$((n+1))
      # sid 变了立即刷；每 20 秒重打一次自愈（外层标题可能被 PS1 转义/切窗覆写）。
      if [ -n "$s" ] && { [ "$s" != "$prev" ] || [ $((n % 20)) -eq 0 ]; }; then
        printf '\033]0;ccm-rbind-%s\007' "$s"
        [ -n "${TMUX:-}" ] && tmux set-option @ccm_sid "$s" >/dev/null 2>&1
        prev="$s"
      fi
      sleep 1
    done
  ) &
fi

# C4：resume 的 argv 向 daemon 要（拿不到就走本地那条）。
# ⚠ 与 `resolve_recipe` 逐行同构 —— A′ 组差分负责它们不许分家。
if [ "$action" = resume ] && [ "$launcher_explicit" = 0 ]; then
  _ccm_c="$(resolve_from_daemon "$sid")"
  # 故意不加引号：daemon 给的是一条**命令串**，要按词拆成 argv（C4 的「拿 argv」）。
  # shellcheck disable=SC2086
  [ -n "$_ccm_c" ] && exec $_ccm_c
fi
exec "${argv[@]}"

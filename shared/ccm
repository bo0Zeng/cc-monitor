agent_needs_bus_id()     { case "$1" in codex) return 0 ;; *) return 1 ;; esac; }

# ===== cc-bus 身份注入：一段逻辑、两种表示（U9a）=====
#
# **病**：这段派生原先只长在真 exec 那条路上，`--print` 一个字都没说。而 `--print` 的定位是
# **平价预言机**（「打印将要执行的命令」，`e2e/ccm-print-parity.sh` 拿它当唯一能离线验证
# 渲染器意图的手段）——于是 codex + 已在 tmux 内那一格，预言机漏报了一个真的会被 export 的
# 变量，且**没有任何判据会因此变红**。
#
# **为什么不能让 `--print` 直接把值打出来**：那会当场破掉本文件另一条更老的纪律
#（见下方 `--tmux` 撞名那段的头注：「`--print` 必须是**纯的**…不能依赖实时 tmux 状态」）。
# 值只有运行时才知道 ⇒ **打印的是配方，不是值**，求值推迟到那条串真正被执行的时候。
# 这样 `--print` 对宿主 `TMUX` 仍然逐字节稳定，44 条黄金串不需要为实现让路。
#
# ⚠ 于是这段逻辑有**两种表示**：函数（exec 路用）与文本（print 路用）。它们**无法真正
#   共用一处** —— 那条串跑在别人的 shell 里，看不见本文件的函数。保证二者一致的是
#   差分判据 `e2e/ccm-contract-parity.sh` A 组（同一组 flag，print 串跑出来的环境
#   必须逐字等于真跑出来的环境），**不是人的记性**。
#
# 判空不能省：`[ -n "$v" ] && export` —— tmux 查不到时若照样 export 一个空串，
# `cc-whoami:10` 会拿到一个「最高优先级的空身份」，比不设更坏。
derive_bus_id() {
  agent_needs_bus_id "$1" && [ -n "${TMUX:-}" ] || { printf ''; return 0; }
  tmux display-message -p '#S' 2>/dev/null
  return 0   # tmux 缺失时 rc=127 会透出去；本文件今天没有 set -e，但别把这个留给以后
}
# 上面那个函数的文本表示（只在 `--print` 里用）。是否输出它由 `agent_needs_bus_id` 决定 ——
# 那是纯的（只看 flag），`TMUX` 判断留在串里、执行时才求值。
BUS_ID_RECIPE='if [ -n "${TMUX:-}" ]; then _ccm_bus="$(tmux display-message -p "#S" 2>/dev/null)"; [ -n "$_ccm_bus" ] && export CC_BUS_ID="$_ccm_bus"; unset _ccm_bus; fi;'

# ===== F06b（C4）：resume 的 argv 向 daemon 要 —— 同样是「一段逻辑、两种表示」=====
#
# C4：ccm 只上报上下文 → **拿 argv** → 设 env → `exec`。daemon 侧 `--resolve` 早已做好
# （`remote-daemon-proto/src/control/resolve_query.rs`：stdin `ResumeSpec`{`sessionId` 必填}
# → stdout `CommandPlan`{`command` 是**唯一可信的一项**}）。缺的一直是 ccm 这一侧的调用。
#
# ⚠ **照上面 `derive_bus_id`/`BUS_ID_RECIPE` 的先例写**，一个字都不新发明：
#   函数给 exec 路用、文本给 print 路用，**是否输出配方**由**纯的**条件决定
#   （那里是 `agent_needs_bus_id`，这里是 `action=resume` 且没显式 `--launcher`），
#   而**运行时才知道的那部分**（那里是 `$TMUX`，这里是 `$CCM_DAEMON_BIN` 在不在）
#   **留在串里、执行时才求值**。⇒ `--print` 仍然是纯的。
#
# ⚠ **显式 `--launcher` 优先于 daemon 的建议**〔自 08-04，理由进 DECISIONS §2〕：
#   `--launcher` 是调用方当场写下的覆盖，daemon 给的是它对这个 sid 的**建议**。
#   让远端建议压掉本地显式覆盖，等于让 `--launcher` 在 resume 上静默失效 —— 而
#   「写了个修饰、看起来生效了、其实被吃掉」正是本文件反复消灭的病（见 `attach` 那段头注）。
#
# ⚠ **拿不到就走本地那条，不报错**（定框 §5：诚实降级）。daemon 没装 / 没起 / 答非所问，
#   `ccm resume` 都必须照今天的样子跑起来 —— 这条失败是**静默**的，钉它的是
#   `e2e/ccm-contract-parity.sh` A′ 组的两条**绝对断言**（逐字钉住本地行为）。
# ★★ `P4e`〔实@08-12 立件，08-13 落地〕：**调用方找得到 daemon —— 不许只靠调用方注入 env**。
#
# ## 病
#
# 这套接线从 F06b 起就在，但 `CCM_DAEMON_BIN` 的**唯一生产注入点**是
# `local_backend.rs`（cc-monitor 起子进程时注进去）⇒ `ccm → daemon` 这条路
# **只在 cc-monitor 拉起的 shell 里活着**。而用户要的「以后集成的 skill 靠 daemon 兼容」，
# 那些 skill 跑在**普通 shell** 里 —— 恰恰是这条路失灵的场合，而失灵是**静默**的。
#
# ## 为什么是一段**配方字符串**而不是两份实现
#
# 查找规则要在两处成立：本函数（真跑）与 `resolve_recipe`（`--print` 吐的那行）。
# 照 `BUS_ID_RECIPE` 的先例本该写两份「逐行同构、改一边必须改另一边」——
# 这次更进一步：**只写一份字符串**，真跑那侧 `eval` 它。
# ⇒ 「同构」不再靠人的记性，而是**同一个字面量**。
#
# ## 顺序与逃生口
#
# `$CCM_DAEMON_BIN`（调用方显式覆盖，最高）→ `~/.cc-monitor/bin/cc-monitor-remote`
#（`sftp::ensure_daemon_deployed` 的落点）→ PATH 上的 `cc-monitor-remote`。
# `CCM_NO_DAEMON=1` **整条关掉**（照 `CCM_NO_PRETRUST` 的既有先例）——
# 判据与套件靠它把「这台机器装没装 daemon」这个变量从测量里拿掉。
#
# ⚠ **`--print` 仍然是纯的**：吐的是**配方**（一段常量字符串），不是查找**结果** ——
#   与 `BUS_ID_RECIPE` 同一条纪律（U9a 2026-08-02 复核过它没有例外）。
# ★★ **问 daemon 要加超时**〔08-13 实测〕：daemon 挂住时 `ccm resume` **永远转圈**
#（实测 12s 掐断才停）。`P4e` 之前这条路只在 cc-monitor 注入 env 时才活；
# 之后 ccm **自己会找到** daemon ⇒ 这条从「偶发」变成「日常」。
#
# ★ Rust 侧**为同一件事早就立过超时**，`ccm_probe.rs` 逐字：
#「没有上限的话，用户点一次「恢复」就是**永远转圈、且不再有任何本机会话拉得起来**」。
# ⇒ shell 侧补上同一条纪律，别让两侧对同一个风险有两种态度。
#
# ⚠ `timeout` 不是每台机都有（ccm 会被部署到任意远端）⇒ **有就用、没有就退回裸调**：
#   退回时的行为与今天逐字相同（不引入新失败面），代价写在这儿：那种机器上仍可能转圈。
DAEMON_BIN_RECIPE='_ccm_db=""; if [ "${CCM_NO_DAEMON:-}" != 1 ]; then for _ccm_x in "${CCM_DAEMON_BIN:-}" "$HOME/.cc-monitor/bin/cc-monitor-remote" "$(command -v cc-monitor-remote 2>/dev/null)"; do if [ -n "$_ccm_x" ] && [ -x "$_ccm_x" ]; then _ccm_db="$_ccm_x"; break; fi; done; unset _ccm_x; fi;'

resolve_from_daemon() {   # $1=sid → stdout: daemon 给的 command 串（拿不到就空）
  eval "$DAEMON_BIN_RECIPE"
  [ -n "$_ccm_db" ] || { printf ''; return 0; }
  # `K-P2` `D1`：`sessionId` 也走 `json_str`，**不再用模板** —— 理由见 `json_str` 头注。
  # ⚠ 对 `[A-Za-z0-9_-]` 的 sid，产出与旧模板**逐字节相同**（黄金串因此一个字不动）；
  #   换掉的是「模板只对那个字符集成立」这件事本身。
  local _sj; _sj="$(json_str "$1")" || return 0
  # 见上方 `DAEMON_BIN_RECIPE` 头注那段「问 daemon 要加超时」：有 `timeout` 就套上，没有就裸调。
  _to="$(command -v timeout >/dev/null 2>&1 && printf 'timeout 3 ' || true)"
  # shellcheck disable=SC2086  # $_to 要么空、要么是 `timeout 3`，**有意不 quote**
  printf '{"sessionId":%s}' "$_sj" | $_to "$_ccm_db" --resolve 2>/dev/null \
    | grep -o '"command":"[^"]*"' | head -1 | cut -d'"' -f4
  return 0
}
# 上面那个函数的文本表示（只在 `--print` 里用）—— 与函数体逐行同构，改一边必须改另一边。
# 保证二者一致的是 `e2e/ccm-contract-parity.sh` **A′ 组**（print↔exec 的 argv 差分），
# 不是人的记性。⚠ 那一组是 F06b-1b 专为本次接线先立的网：立网之前，接一半都会安静地绿。
# 用法：`resolve_recipe <sid> <本地兜底的 exec 串> [已 quote 的透传参数串]` → stdout 一行 shell。
# ⚠ 第 3 个参数是 F10 补的：daemon 给的串里不可能带用户的 `--` 透传（协议无此字段），
#   而 `exec $_ccm_c` 是整条换掉 argv ⇒ 不补就丢参数。**与 exec 路逐行同构**。
resolve_recipe() {
  # `K-P2` `D1`：与 exec 路**同一个编码器**（`json_str`），不再各写一份模板 ——
  # 「两处各写一遍迟早漂」正是 `DAEMON_BIN_RECIPE` 头注立的那条纪律，这里照办。
  local enc; enc="$(json_str "$1")" || return 1
  local sid_json="{\"sessionId\":$enc}"
  # `P4e`：查找规则**只有一份**（`DAEMON_BIN_RECIPE`）—— 这里原样吐出它，真跑那侧 eval 它。
  printf '%s' "_ccm_c=\"\"; $DAEMON_BIN_RECIPE if [ -n \"\$_ccm_db\" ]; then"
  printf '%s' " _ccm_c=\"\$(printf '%s' $(sq "$sid_json") | \$(command -v timeout >/dev/null 2>&1 && printf 'timeout 3 ') \"\$_ccm_db\" --resolve 2>/dev/null"
  printf '%s' " | grep -o '\"command\":\"[^\"]*\"' | head -1 | cut -d'\"' -f4)\"; fi;"
  # F10：与 exec 路逐行同构 —— 透传参数由调用方作为第 3 个参数传进来（空则不加）。
  printf '%s' " if [ -n \"\$_ccm_c\" ]; then set -f; exec \$_ccm_c$3; else $2; fi"
}

# ===== 后端不可达：唯一失败面（BEGIN backend-unreachable）=====
#
# ## 它为什么存在〔`K-P2` `F` 拍 09-04；用@09-04 逐字「**ccm不要管找不到, 统一走后端**」〕
#
# 在这之前，建会话走不通后端就**退回本机 tmux 直起**，并往 stderr 说一句「已降级」。
# 用户 09-04 把那条路裁掉了：`ccm` **不铺、不起、不找退路** ——
# 后端是唯一真相源；装它 / 起它归桌面端与安装那一族（`K-P3` / `K-R8`），不归 `ccm`。
#
# ⇒ 「后端不可达」从此**只有一种失败面**：一句人话 ＋ 一个退出码。
#
# ## 为什么是**一处**字面量、**一个**退出码
#
# 本仓治过一整族「同一件事两份实现」。**失败面尤其容易长成两份**：
# 建会话那条与账号解析那条各写一句「找不到 daemon」，措辞迟早对不上；
# 而调用方（`cc-spawn` / cc-monitor）是**按退出码**判失败的 ⇒ 两个码就是两套契约。
# ⇒ 文案与退出码各只有**一处**住址（下面这两行）；谁要报「后端不可达」都调这一个函数。
# 钉它的是 `ccm_cli_contract::the_backend_unreachable_failure_face_has_exactly_one_home`。
#
# ## 为什么不复用 `die`
#
# `die` 的码是 **2**，而 2 已经承载着「用法错 / 参数错 / 环境不满足」一整类
#（在 tmux 里用无名 `--tmux`、`--account` 打错名字、没装 tmux …）。
# 调用方要分得开「**你敲错了**」与「**这台机器上没有后端**」——后者是可修的部署缺口，前者不是。
# ⇒ 单独一个码。今天在用的码：`0` · `2`（`die`）· `3`（撞名，`C14`）⇒ 取 `4`。
#
# ⚠ **如实登记两格（本拍没买到的）**：
#   ① 它**不列出「我找过哪里」**。`DAEMON_BIN_RECIPE` 的三个候选位在 `--help` 里有一份，
#      而把查找结果渲进文案要多一趟 `-n`/`-x` 探测并把三行清单拼进来
#      ⇒ 那与「唯一文案」这条要求在形状上冲突（清单是**渲染**出来的，不是一句字面量）。
#      本拍取「唯一文案」，清单那一格登记在件文件 `§4`。
#   ② 「装了但名字对不上」（宿主铺的是 `cc-monitor-local-<build_id>`，本文件找的是
#      `cc-monitor-remote` —— 件文件 `§6-1㈢` 现打）在这一句里**仍与「装都没装」同形**。
#      那一格要改的是查找规则**或**宿主的落名，**两侧只许改一侧**（`§6-5㈡` 第 7 行，PM 挑边）。
CCM_RC_NO_BACKEND=4
backend_unreachable() {   # $1=是哪一格（一句人话，接在同一句后面）—— **绝不返回**
  printf 'ccm: 后端不可达，起不来 —— %s。本地那条退路已经不在了（用@09-04：ccm 不要管找不到，统一走后端）；装/起本机后端在 cc-monitor 里做，不在 ccm 里。\n' \
     "$1" >&2
  exit "$CCM_RC_NO_BACKEND"
}
# ===== 后端不可达：唯一失败面（END backend-unreachable）=====

# 撞名那句**响亮失败**的唯一一处字面量〔`K-P2` `F` 拍 09-04〕。
# 消费者两处：`--print` 吐的那条配方（把它 `sq` 进串里）与 exec 路上后端说 `created:false`
# 那一格。**两处各写一句就是两份措辞**，而 `an_explicit_tmux_name_collision_fails_loudly`
# 钉的是「响亮」这个性质（带名字 ＋ 非零码），它钉不住「只有一份」。
# ⚠ 值里那个 `\n` 是**两个字符**（`printf` 的转义），不是真换行 —— `sq` 进配方串之后
#   与旧版逐字节相同，`--print` 的输出一个字节都没动。
NAME_TAKEN_FMT='ccm: tmux 会话名 %s 已被占用 —— 拒绝静默接回别人的会话（C14：spawn 就是起）\n'

# ===== 建会话走后端（BEGIN launch-wire）=====
#
# ## 它买的那句话〔`K-P2` `D` 阶段第三拍，09-03〕
#
# 在这之前，`--tmux` 那一块的会话是 **ccm 自己起的**（下面那条 `tmux new-session`）。
# 本函数让它**先走后端那条一次性子命令 `--launch`**（`mode=create-or-attach`），
# 拿不到后端才退回本地那条 —— **查找规则（`DAEMON_BIN_RECIPE`）、超时纪律、降级出声**
# 三样全部与 `resolve_from_daemon` / `acct_table_load` 同形，**不发明第二套**。
#
# ## 为什么值得搬
#
# `control/launch.rs` 头注逐字：那一侧用 `Command::new("tmux").args([...])` **argv 直传、
# 不过 shell** ⇒ 引号 / 转义 / 注入这一整类问题**在那条路上不存在**（不是「被挡住了」）。
# 本地这条是把一整条 shell 串交给 `bash -c` 再交给 tmux，那一类问题一直得靠 `sq` 一层层挡。
#
# ## 🔴 控制字符这一格：**本拍挑的是「ccm 这侧先挡」**〔PM `§19 裁六` 要求二选一〕
#
# daemon 的 `check_field` **按设计拒收含控制字符的字段**，理由写在它自己那行注释上：
# 「控制字符会让 send-keys 的语义变掉（`\n` = 多敲一次回车）」。
# ⇒ **不去放宽它**：① 那条拒收本身是对的；② 放宽它会同时改掉**已有两个生产调用方**的行为
#   （`daemon_launch.rs` 的 `send-into` · `daemon_send_keys.rs` 的裸键），
#   而本拍是接线拍，不该顺手改别人那两条路的收件口径。
# ⇒ 改成 **ccm 这侧发之前就判**：有控制字符就不发，退回本地那条，并**出声说明命中的是这一格**。
# ⚠ **如实登记**：退回去的那条**也有**同一个 send-keys 语义问题（载荷里的换行照样多敲一次
#   回车）—— 那是今天就在的老账，**本拍没修它**，只是没让新路把它变成一个 `invalid_args`。
#
# ## 撞名**不走**降级那条口
#
# daemon 回 `created:false` = 会话已存在（它自己的幂等短路）。**那不是降级** ⇒ 本函数回 2、
# 一个字不说，交给下面本地那条去 `new-session` 撞名、走 `P3sc` 那条**响亮失败**（`exit 3`）
# ⇒ 那句文案与那个退出码**仍然只有一处字面**（`an_explicit_tmux_name_collision_fails_loudly` 钉着它）。
#
# ## 超时为什么不是 `resolve` 那个 3 秒
#
# `--resolve` 只读文件；`--launch` 真起进程（`new-session` ＋ 几条 `set-option` ＋ `send-keys`）。
# ⇒ 给 10 秒。⚠ **代价如实写在这儿**：掐断发生在「会话已经建出来、回帧还没拿到」那一瞬时，
#   ccm 会退回本地那条、然后撞上自己刚建出来的名字 ⇒ **`exit 3` 报「已被占用」**。
#   那是**响亮的错**（不是静默接回别人的会话），但它报的原因与事实不符。没有实测，登记为空缺。
launch_via_daemon() {
  # $1=会话名 $2=载荷 $3=cwd $4=ccm_sid（可空） $5=agent $6=<W>x<H>（可空）
  # rc：0 = 后端已经把会话建好并键入载荷 · 2 = 后端说这个名字已经在（由调用方响亮失败）
  #     **没有 rc=1**〔`K-P2` `F` 拍 09-04〕：后端不可达那一格从「出声 + 退回本地」
  #     换成了 `backend_unreachable`（唯一失败面，`exit $CCM_RC_NO_BACKEND`）⇒ 它不返回。
  local why="" req="" out to n p a c s
  eval "$DAEMON_BIN_RECIPE"
  if [ -z "$_ccm_db" ]; then
    if [ "${CCM_NO_DAEMON:-}" = 1 ]; then why="CCM_NO_DAEMON=1（明示整条关掉 daemon）"
    else why="这台机器上找不到 daemon（cc-monitor-remote）"; fi
  elif [[ "$1$2$3$4$5$6" == *[[:cntrl:]]* ]]; then
    why="要发的字段里有控制字符 —— daemon 的 check_field 按设计拒收（换行会让 send-keys 多敲一次回车）"
  elif ! n="$(json_str "$1")" || ! p="$(json_str "$2")" || ! a="$(json_str "$5")" \
       || ! c="$(json_str "$3")" || ! s="$(json_str "$4")"; then
    # ⚠ **五个字段一起编、一个编不出就整条不发**：编不出的那个若被「静默丢掉」，
    #   daemon 会建出一个**少了 cwd** 的会话 —— 那是「看起来生效了、只是换成了错的」。
    why="这几个字段编不成 JSON（当前 locale 认不出的字节）"
  else
    # **值位一律走 `json_str`**，一处模板都不留 —— 理由见它的头注。
    req="{\"mode\":\"create-or-attach\",\"name\":$n,\"payload\":$p,\"agent\":$a"
    [ -n "$3" ] && req="$req,\"cwd\":$c"
    [ -n "$4" ] && req="$req,\"ccm_sid\":$s"
    # `--tmux-size` 上游已校验「只含数字与单个 x」⇒ 这里拆开即可；两个都给或都不给。
    [ -n "$6" ] && req="$req,\"width\":$(json_str "${6%x*}"),\"height\":$(json_str "${6#*x}")"
    req="$req}"
    # 与 `resolve_from_daemon` 同一条纪律：有 `timeout` 就套上、没有就裸调。
    to="$(command -v timeout >/dev/null 2>&1 && printf 'timeout 10 ' || true)"
    # shellcheck disable=SC2086  # $to 要么空、要么是 `timeout 10`，**有意不 quote**
    if ! out="$(printf '%s' "$req" | $to "$_ccm_db" --launch 2>/dev/null)"; then
      why="daemon（$_ccm_db）答不出 --launch"
    else
      case "$out" in
        *'"created":true'*)  unset _ccm_db; return 0 ;;
        *'"created":false'*) unset _ccm_db; return 2 ;;
        *) why="daemon（$_ccm_db）回的不是 launch 的结局帧" ;;
      esac
    fi
  fi
  unset _ccm_db
  # ★★ 〔`K-P2` `F` 拍 09-04〕**这里原来是「降级出声」＋ `return 1`（退回本机 tmux 直起）。**
  #    用@09-04 把那条退路裁掉了 ⇒ 它变成**唯一失败面**：不返回，直接 `exit`。
  #    ⚠ `why` 那几格**一个字都没改**（找不到 / 明示关掉 / 控制字符 / 编不成 JSON /
  #      答不出 `--launch` / 回的不是结局帧）—— 变的只是「说完之后怎么办」。
  #      〔`K-C1` `§0b` 那条「降级必须出声」在这条路上**不再适用**：没有降级可言了。
  #      登记面从「退路 + 出声」换成「无退路 + 唯一失败面」，改的那张表是
  #      `ccm_cli_contract::BACKEND_BACKED_PATHS`。〕
  backend_unreachable "$why"
}
# ===== 建会话走后端（END launch-wire）=====

# ===== 默认值 =====
action=new
sid=""
attach_name=""
use_tmux=0
tmux_name=""
tmux_base=""
bus_register=0
bus_note=""
account=""
use_base=0
cwd_spec=auto
agent=claude
model=""
launcher=""
ccm_sid=""
do_print=0
detach=0
tmux_size=""
passthru=()

# ===== 参数解析 =====
# 动作可以是位置参数（new/resume/attach），其余一律 flag。`--` 之后全部透传给 agent。
if [ $# -gt 0 ]; then
  case "$1" in
    new)    action=new; shift ;;
    # 下一个 token 以 `-` 开头 → 用户漏了参数（`ccm resume --tmux` 会静默把 --tmux 当 sid）
    resume) action=resume; shift
            { [ $# -gt 0 ] && case "$1" in -*) false ;; *) true ;; esac; } || die "resume 需要 <sid>"
            sid="$1"; shift ;;
    attach) action=attach; shift
            { [ $# -gt 0 ] && case "$1" in -*) false ;; *) true ;; esac; } || die "attach 需要 <会话名>"
            attach_name="$1"; shift ;;
  esac
fi

while [ $# -gt 0 ]; do
  case "$1" in
    --) shift; passthru+=("$@"); break ;;
    # `--resume <sid>` 与 `resume <sid>` 等价 —— cc-monitor 今天就是这么拼的，
    # 于是 F02 一落地、前端零改动就已经正确（MASTERPLAN §0 推论④）。
    --resume)      shift; need_val "--resume" "${1:-}"; action=resume; sid="$1" ;;
    --resume=*)    action=resume; sid="${1#*=}" ;;
    --tmux)        use_tmux=1 ;;
    --tmux=*)      use_tmux=1; tmux_name="${1#*=}" ;;
    # `--tmux-base=<基名>`：第三种取名模式（`C15`〔用@08-13「cc-bus收进ccm」〕）。
    # 见下方 `derive_tmux_name` 上面那段「撞名策略按调用方分成三条」。
    --tmux-base)   shift; need_val "--tmux-base" "${1:-}"; use_tmux=1; tmux_base="$1" ;;
    --tmux-base=*) use_tmux=1; tmux_base="${1#*=}" ;;
    # `--bus-register` / `--bus-note`：把新会话登记上 cc-bus（`C15`〔用@08-13「cc-bus收进ccm」〕）。
    # 见下方 `bus_register_seq` 的头注 —— **格式归 cc-bus，ccm 只负责告诉它**。
    --bus-register) bus_register=1 ;;
    --bus-note)    shift; need_val "--bus-note" "${1:-}"; bus_note="$1" ;;
    --bus-note=*)  bus_note="${1#*=}" ;;
    --account)     shift; need_val "--account" "${1:-}"; account="$1" ;;
    --account=*)   account="${1#*=}" ;;
    --base)        use_base=1 ;;
    --cwd)         shift; need_val "--cwd" "${1:-}"; cwd_spec="$1" ;;
    --cwd=*)       cwd_spec="${1#*=}" ;;
    --agent)       shift; need_val "--agent" "${1:-}"; agent="$1" ;;
    --agent=*)     agent="${1#*=}" ;;
    --model)       shift; need_val "--model" "${1:-}"; model="$1" ;;
    --model=*)     model="${1#*=}" ;;
    --launcher)    shift; need_val "--launcher" "${1:-}"; launcher="$1" ;;
    --launcher=*)  launcher="${1#*=}" ;;
    --ccm-sid)     shift; need_val "--ccm-sid" "${1:-}"; ccm_sid="$1" ;;
    --ccm-sid=*)   ccm_sid="${1#*=}" ;;
    --detach)      detach=1 ;;
    --tmux-size)   shift; need_val "--tmux-size" "${1:-}"; tmux_size="$1" ;;
    --tmux-size=*) tmux_size="${1#*=}" ;;
    --print)       do_print=1 ;;
    --ccm-probe)
      printf 'name=ccm\nversion=%s\nself=%s\ncapabilities=new,resume,attach,tmux,account,model,cwd,agent,launcher,ccm-sid,print,detach,tmux-size,tmux-base,bus-register,daemon-discover,account-via-daemon\nagents=claude,codex\n' \
        "$CCM_VERSION" "$CCM_SELF"
      exit 0 ;;
    --version)     printf 'ccm %s\n' "$CCM_VERSION"; exit 0 ;;
    -h|--help)     sed -n '/^# 用法：/,/^# \*\*为什么/p' "$CCM_SELF" | sed '$d' | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*)            die "未知选项: $1（用 --help 看用法）" ;;
    *)             die "多余的位置参数: $1（动作只能是 new/resume/attach 且必须在最前）" ;;
  esac
  shift
done

case "$agent" in claude|codex) : ;; *) die "未知 agent: $agent（支持 claude|codex）" ;; esac
[ -n "$account" ] && [ "$use_base" = 1 ] && die "--account 与 --base 互斥"

# `--detach` / `--tmux-size` 只在容器路径有意义。**不静默忽略**——静默忽略正是本工作区
# 反复消灭的那类病（写了个修饰、看起来生效了、实际被吃掉）。
[ "$detach" = 1 ] && [ "$use_tmux" != 1 ] && die "--detach 需要配合 --tmux（非容器路径没有会话可 detach）"
[ -n "$tmux_size" ] && [ "$use_tmux" != 1 ] && die "--tmux-size 需要配合 --tmux"
# 两种取名模式互斥：一个说「就要这个名」，一个说「以这个为底、撞了就退让」，同时给等于没说清要哪个。
[ -n "$tmux_name" ] && [ -n "$tmux_base" ] && die "--tmux=<名> 与 --tmux-base=<基名> 互斥（前者不避让、后者避让，同时给等于没说清要哪个）"
# `--bus-register` 只在 `--detach` 那条路上有意义：不 detach 的话本进程随后 `exec` 进 attach，
# 登记要么来不及做、要么把用户的终端占住。**不静默忽略**（静默忽略正是本工作区在治的病）。
[ "$bus_register" = 1 ] && [ "$detach" != 1 ] && die "--bus-register 需要配合 --detach（不 detach 那条随后 exec 进 attach，登记做不成）"
[ -n "$bus_note" ] && [ "$bus_register" != 1 ] && die "--bus-note 需要配合 --bus-register（不登记的话这行备注没有去处）"
# 尺寸会被拼进 `tmux new-session -x W -y H`，**必须**只允许纯数字，否则就是一条注入面。
if [ -n "$tmux_size" ]; then
  # 不用 extglob（本脚本没开 shopt，且要保持可移植）：逐条排除法等价于「<数字>x<数字>」
  # ——只含数字与 x、不以 x 开头/结尾、有且仅有一个 x。
  case "$tmux_size" in
    *[!0-9x]* | x* | *x | *x*x* | '')
      die "非法 --tmux-size: '$tmux_size'（要 <宽>x<高>，如 220x50，且均为正整数）" ;;
  esac
fi
if [ "$action" = resume ] && [ -z "$(agent_resume_flag "$agent")" ]; then
  die "agent=$agent 不支持 resume（无 resume flag）"
fi

# ===== L2 环境：cwd =====
# `auto` 逐字复刻旧 `_cc_resolve_target`：在 $HOME 用工作区；在 git 仓用其父目录；否则当前目录。
resolve_cwd() {
  if [ "$cwd_spec" != auto ]; then printf '%s' "$cwd_spec"; return; fi
  # **auto 只对 `new` 生效**。resume/attach 的目标目录由 sid/会话决定、调用方已经定位好
  # （cc-monitor 发的是 `cd '<会话cwd>' && ccm --resume <sid>`）；再 auto 解析一次会把
  # 工作目录换成 git 仓的**父目录** → Claude 按 `projects/<enc(cwd)>/<sid>.jsonl` 找不到会话。
  # 实测踩过：在任何 git 仓里 `ccm --resume <sid>` 都会跑偏。
  if [ "$action" != new ]; then printf '%s' "$PWD"; return; fi
  local r
  if [ "$PWD" = "$HOME" ]; then
    r="$CCM_WORKSPACE"
  else
    local g
    g="$(git rev-parse --show-toplevel 2>/dev/null)"
    if [ -n "$g" ]; then r="$(dirname "$g")"; else r="$PWD"; fi
  fi
  # 旧 `_cc_resolve_target` 结尾有 `mkdir -p "$REPLY"` —— 保住它：在 $HOME 首次敲 `cc` 时
  # 工作区可能还不存在，没有这句会直接报"无法进入目录"。**只在 auto 路径建**（显式
  # `--cwd <dir>` 不代建：cc-monitor 传的是已存在的会话目录，代建会掩盖"目录被删/移走"）。
  [ "$do_print" = 1 ] || mkdir -p "$r" 2>/dev/null || true
  printf '%s' "$r"
}
cwd="$(resolve_cwd)"

# ===== L1 容器：会话名派生 =====
# 与前端 `deriveTmuxName` 同规则（basename → 非 [A-Za-z0-9_-] 换 `-` → 折叠 → 截 32 → 剥首尾 `-`）。
# 同规则 = 终端 `cct` 与 app「开新 Claude」在同一目录造出**同一个名字** → 幂等接回同一会话。
derive_tmux_name() {
  local b s
  b="$(printf '%s' "$1" | sed 's:/*$::')"   # 去掉全部尾斜杠（对齐 TS 的 /\/+$/）
  b="${b##*/}"
  s="$(printf '%s' "$b" | sed 's/[^A-Za-z0-9_-]/-/g; s/--*/-/g' | cut -c1-32 | sed 's/^-*//; s/-*$//')"
  # S4b-3b（用户 2026-07-31）：`cc-` 前缀反转成 `-cc` 后缀。与前端 `deriveTmuxName`
  # 逐字同规则（跨语言双写点，`e2e/ccm-cli.test.sh` 真值对拍钉住）。
  if [ -n "$s" ]; then printf '%s-cc' "$s"; else printf 'session-cc'; fi
}

# ===== 名字的形状校验（**唯一一份**）=====
# 原先只长在「显式 `--tmux=<名>`」那条分支里。`C15` 加了 `--tmux-base` 之后，基名同样会
# 原样变成会话名（不撞时逐字相同）⇒ 校验必须是**两条路共用的一份**，
# 不然「显式名禁 `*`」而「基名放行 `*`」，等于给同一道门开了个后门。
# 与前端 `isValidNewTmuxName` 同一套判据（`src/remote-launch.ts`）。
validate_tmux_name() {
  case "$1" in
    ""|-*)        die "非法 tmux 会话名（空或以 - 开头）: '$1'" ;;
    # ★ F15 在下面那行加了 `=`：**别创建一个主路杀不掉的名字。**
    #   kill 的主路从 F04b 起走 daemon（`remote-daemon-proto/src/control/kill.rs`），它的形状门
    #   逐字拒 `:` 与 `=`（「它们是 tmux 目标语法」），且**按设计不回落**（回落到 shell 路 =
    #   把一次形状拒绝洗成另一条路的成功）。而这里原本只禁 `. : * ?`，加上 `--tmux=*` 的取值是
    #   `${1#*=}`（剥到第一个 `=`）⇒ `ccm --tmux=proj=x` 能建出 `proj=x`，通道 B 还会给它写真
    #   `@ccm_sid` ⇒ Gate 2 通过、正常出现在 monitor 列表里，而「结束会话」永远 `invalid_args`
      #   ⇒ **那个会话在 UI 上杀不掉**（F04b 之前那条 SSH 串杀得掉它）。实测过：改之前
    #   `ccm new --tmux=proj=x --print` 产的就是 `new-session -d -s 'proj=x'`。
    # ⚠ 上面那句「与前端 `isValidNewTmuxName` 同一套判据」—— **F04b 之后曾经是假的**
    #   （F04b 只给 TS 那份加了 `=`，跨轨钉也只读了 TS 那一份）。加上这个字符之后它重新成立，
    #   并由 Rust 侧那条**遍历式**的创建路径登记表钉住（见 `daemon_kill.rs`）。
    *[*?.:=]*)     die "非法 tmux 会话名（含 glob 或 tmux 目标语法 * ? . : =）: '$1'" ;;
    *[[:cntrl:]]*) die "非法 tmux 会话名（含控制字符）: '$1'" ;;
  esac
}

# ===== 撞名避让（**唯一一份**）=====
# `$1` = 基名 → 回一个当下没被占用的名字（撞了退到 `-2/-3/...`）。
# **只在真建会话时查**：`--print` 必须是**纯的**（F03 要拿它做渲染等价断言），不能依赖实时
# tmux 状态。`--print` 展示基名；真跑时撞名会退让到 `-N`。
# ⚠ U9a 2026-08-02 **确认这条纪律仍然有效、没有例外**：`CC_BUS_ID` 那次是靠**打印配方而不是
#   打印值**（`BUS_ID_RECIPE`）来同时满足「说全」与「保持纯」的。避让为什么不能照办：配方要判的是
#   「这个名字被占没被占」，那**必须**在真跑时查，而查到的结果会改变**名字本身** ——
#   名字是黄金串的主体，不是可以推迟求值的一段 env。
#   ⇒ 撞名避让归 `ccm-acceptance` 场景 5/5bis（真 tmux）管，见 `doc/INVARIANTS.md` §33a。
avoid_name_collision() {
  local n="$1" k=2
  if [ "$do_print" != 1 ] && tmux has-session -t "=$n:" 2>/dev/null; then
    while tmux has-session -t "=$1-$k:" 2>/dev/null; do
      k=$((k+1))
    done
    n="$1-$k"
  fi
  printf '%s' "$n"
}

# 撞名策略**按调用方分成三条**（2026-07-31 定两条；`C15` 08-13 加第三条）：
#
#   `--tmux=<名>`（显式名）→ **不避让**。调用方（cc-monitor）自己算好了要哪个
#     会话（如灰会话 fresh resume 的 `cc-<sid8>-2`），CLI 再改一次就错了。
#     ⚠ 这条 08-12 起也**不再幂等接回**：`P3sc` 改成撞名就 `exit 3` 响亮失败（`C14`：spawn 就是起）。
#   `--tmux`（无名）    → **无条件新建**，撞名就退到 `-2/-3`。
#   `--tmux-base=<基名>` → **调用方给底、ccm 避让**（`C15`〔用@08-13「cc-bus收进ccm」〕）。
#     为什么需要第三条：cc-spawn 的名字规则是 `<basename>_cc`，与 ccm 的 `cc-<basename>`
#     **不同**（cc-bus 的 id 就是这个名，`cc-whoami resolve` 与之对齐）⇒ 它用不了无名那条的派生。
#     而它又必须避让（`P4b-Y2`：不复用 ≠ 不避让）⇒ 显式名那条的「撞了就失败」也不合用。
#     ★ 关键在于：避让的实现从此**只有一份**，且住在**建会话的人**那里 ——
#     调用方自己 `tmux has-session` 探一遍再把名字传进来，是把同一个事实算两遍
#     （而且那两遍之间有窗口期：探完到真建之间别人可以插进来）。
#
# 原先两者共用「不避让 + 幂等接回」，理由是「同目录再开一次会产孤儿（实测踩过）」。
# **那个理由只对显式名成立。** 复核（2026-07-31）：`src/launch-render-cli.ts:95` 显示
# cc-monitor 起会话时**永远**传 `--tmux=<名>`；无名的 `--tmux` 只出现在两处 ——
# 给用户复制的诊断文案，和别名块 `cct() { ccm --tmux "$@"; }`，也就是**用户在终端里敲的
# 那一下**。这条路径上**没有任何调用方对名字有期望**，所以不存在「谁被搞糊涂了」。
#
# 用户报的病：在某目录已经有会话的情况下，**新开一个终端**进同一目录敲 `cct`，会被
# attach 进那个正在被别处用着的会话（两个终端镜像同一个窗口、按键互相打架）。
# 「我既然新开一个终端在这个路径 cc 了，我肯定是要新建窗口而非 attach」—— 这是对的：
# 终端里那一下**从来就不是**「接回我 detach 的那个」，而是「再来一个」。

# ===== L2 环境：账号 =====
#
# ★★ `K-C1`〔用@08-24「**ccm要换成调用后端**」的便宜那半〕：
#    **账号解析先问 daemon（`--list-accounts`）；自己读 manifest 只剩「退路」这一个身份。**
#
# 承接 `backend-split` `C4`（ccm 是执行臂，不是宿主）。病：「manifest 长什么样」这条语义
# 本仓有**两份**实现，而 shell 那份更浅（不认 `version` schema 闸、不认「`configDir` 键缺席
# = 账号 0」、没有 `is_safe_config_dir` 谓词）⇒ 同一份 manifest 两侧能给出不同答案，
# 症状是**跑在错的号上**（见下方 R08/R11 头注那一族）。更具体的一格：cc-monitor 列给用户看的
# 账号表**已经**来自 daemon，而它交给 ccm 的是 `--account <名>` ⇒ UI 里挑得到的号 ccm 可能报「不可用」。
# ⇒ 名字→目录 / 名字清单 / 默认号 这三个问题**一趟 `--list-accounts` 全答完**
#   （旧版是三个函数各读一遍文件 ⇒ 落默认号那条路实际读两遍）。
#
# ## `§0b` 的裁定：**诚实降级，但比 `resume` 那条严一格 —— 降级要出声**
#
# 于是三条通道三种哲学，**这是有意的**：身份可以牺牲（`CCM_NO_DAEMON=1` 是个安全的放弃态）·
# `resume` 的 argv 只是建议（本地那条同样正确，降级静默）· **账号错了就是错了**
#（既不能失败、也不能不响）。三条不跟身份的理由，一句一条：
#  1. 「放弃账号」不是安全状态（会静默落到基座那个通常已没凭据的 config dir）⇒ 逃生口**只能**是
#     读文件 ⇒ 退路无论如何都得留着 ⇒ 改成「没 daemon 就起不来」只换来「谁按开关」，
#     代价却是 `zcc`/`bcc`（用户每天在敲）在没部署 daemon 的机器上直接起不来；
#  2. 它会破掉一条已被判据钉住的纪律：`e2e/ccm-cli.test.sh` 逐字钉着「预言机不许因为这台机器
#     没装 daemon 就哑掉」，而 `config_dir` 是**值**、逐字进黄金串 ⇒ 没法像 `BUS_ID_RECIPE` /
#     `DAEMON_BIN_RECIPE` 那样把求值推迟到执行时；
#  3. 而照抄 `resume` 的**静默**降级也不行 —— 换号出偏差的后果是「跑在错的号上」，
#     身份那条头注逐字记着这一族：「不再是少一个锦上添花，而是**没人知道为什么**」。
# **五条排除项、代价怎么算的、逐条实测读数**：住件文件
# `.claude/planned-build/backend-consolidation/features/K-C1-ccm账号解析走daemon.md` 的 `§0b` /
# `§0-Bx-2` —— **这里刻意不抄一遍**（论证与读数外移留住址，本文件的头注体量已经在被判据盯着：
# `polling_registry::tests::the_identity_poller_is_gone_for_good` 有一条「剥注释后不足 1/4 就算剥法坏了」
# 的自检，08-24 我加头注时**真的把它打红过**）。
#
# ## 两条如实边界（`KC6c` / `KC6b`，件文件 `§4` 是全文）
#
#  - `KC6c`：**「后端是账号的唯一真相源」今天只做到「优先」，不是「唯一」** ——
#    读文件那条还在本文件里，daemon 缺位/答不出/问不对时会走它。它只是不再是默认路径，
#    且**每次走它都会说一句** ⇒ 两个真相源并存这件事是**可观测**的，不是暗的。
#  - `KC6b`：**多出来的那一次往返没有上限判据。** 读数以 **D 阶段审计的复量**为准
#    （`audits/K-C1-D1.md` `§3.1`–`§3.5`；`$EPOCHREALTIME` 掐 30 次 ×3 轮，探针先自证）：
#    `--account z` **23.4→145.9ms** · 落默认号 **28.1→145.6ms**（**仍只 1 次往返**，旧版 2 次 `jq`）·
#    `--base` 两侧 15.2/15.3ms（那条路不问 daemon）。端到端 **+122.5ms**（145.9 − 23.4）。
#    ★ **其中 120.0ms 是 `timeout` 这个包装进程，不是 daemon**（145.9 − 25.9：同一条 PATH、
#    只少一个 `timeout` 符号链接）。**摘掉包装这次改造只贵 2.9ms**（25.9 − **23.0**），
#    落默认号那条甚至 **−1.0ms**。⚠ **这三个数不构成分解、不许相加**〔D2 `B4` 订正〕：
#    `120.0+2.9=122.9≠122.5` —— **两侧基线不是同一条**：`122.5` 的旧侧是 **23.4**（旧实现在**有**
#    `timeout` 的全量 PATH 上），`2.9` 的旧侧是 **23.0**（同一条**无** `timeout` 的 PATH，件文件
#    `§0-Bx-2` 第 2′ 行；第二轮头注漏了这个 23.0，那句「其中」于是读起来像分解 = **两个口径混着相减**）。
#    同基线的分解是 `120.0+2.5=122.5`；**2.9 是「改造本身」的诚实读数**（两侧同 PATH）⇒ 两个都留。
#    ★ **daemon 那次往返 2.2ms，比它取代的 `jq`（4.2ms）便宜 2.0ms** —— 旧头注写「贵 1.26ms」
#    是拿**套了 `env` 的**读数减裸跑读数，口径不同。★ 那 120ms 是「uutils coreutils 0.8.0 在本机
#    占了 `timeout` 这个正名」这一件事：GNU 那份本机**在**（`gnutimeout` 9.7），同一件事 **2.10ms**
#    ⇒ **「照样套 `timeout`」这个决定本身不贵**（理由见 `DAEMON_BIN_RECIPE` 头注：daemon 可能是
#    PATH 上捡到的第三方二进制，不封顶就是 `zcc` 永远转圈）—— 别让两侧对同一个风险有两种态度。
#    ⚠ 容器路径（`zcct`）外层内层各解析一次 ⇒ 两笔；外层那笔是「`--account nope` 在建会话之前
#    就 die」的校验，不能省。**逐行读数与分解住件文件 `§0-Bx-2`。**
#
# ## `--accts-dir` 是目录、`CCM_ACCTS_MANIFEST` 是文件 —— 对不上时**不许猜**
#
# `--list-accounts` 只收目录，文件名由 daemon 自己拼（`acct-core::MANIFEST_NAME`）⇒
# `CCM_ACCTS_MANIFEST` 指到**别的文件名**时 daemon 答的是**另一个文件**。那不是它坏了，
# 是这个问题它答不了 ⇒ 走文件那条并**说一句**（悄悄读另一个文件最坏）。

# 一个账号对象（一块 JSON 切片）→ 表的一行。**daemon 输出与 manifest 共用这一份解析**
#（daemon 那侧紧凑、manifest 可能带空格 ⇒ 模式一律容忍空白，一份够用）。
# ⚠ **不许假设键的顺序**：daemon 侧走 `serde_json::json!{}`（BTreeMap）⇒ 键按字母序，
#   实测 `configDir` 排在 `name` **之前**；而旧版那条 grep 兜底恰恰要求 `name` 在前
#   （`"name"…[^}]*"configDir"`）⇒ 键序一换它就**静默**解析不到。这里逐键单独取。
# ⚠ 如实边界（`KC6d`）：纯文本取键，值里有 `\"` 转义会取偏（`configDir` 被 daemon 的
#   `is_safe_config_dir` 挡掉了引号与反斜杠，`name` **没有**那道谓词）。**旧版同样如此，没变弱。**
#   有 `jq` 时两个 feeder 各走自己那条 `jq` 分支，这份**只在没有 `jq` 时**被用到
#   （daemon 那条与文件那条**都**会落到它 —— 别当成「只有文件退路才用」，见 `KCM6`）。
# ★★ **纯 bash，零外部进程**〔08-24〕：第一版用 `sed`/`grep`/`awk`，被瘦 PATH 那节逮红。本文件经
#    `sftp.rs` 部署到**任意远端** ⇒ 热路径多一条硬依赖 = 那台机器上换号整条不通。
# ★★ **钉它的是谁、射程多大**〔08-25 换第三把尺子。射程只写在测试里等于没写：改这里的人读这里〕。
#    尺子 = `e2e/ccm-cli.test.sh` 的 `KNF()`（半 a `command_not_found_handle` ＋ 半 c `DEBUG` 陷阱/`set -T`）。
#    **射程（分母）= 本函数 · `manifest_to_table` · `daemon_out_to_table` 三者的调用栈内**；栈外不归它管
#    （整趟 `--print` 本就有外部进程：08-25 实测 `sq` 里 2 次 `sed`），栈外由 `★ KC6d/整趟` 两条单向棘轮钉。
#    **逮得到（12 形，R7 逐形重打）**：裸名字 · 绝对路径（存在与 ENOENT）· 非 bash 子 shell · 恰在瘦
#    PATH 上的 · `$V`/`${V}` · `eval` 里的 · 找得到但跑失败的 · 进程替换 · 后台 `&` · **数组元素**
#    （`exec "${argv[@]}"` 正是这一形）· **`${V:-默认}`**（生产段 22 处，口径见那边）；**重定向与
#    locale 都不吃**；后两形 R7 才堵上，此前真依赖而全套全绿。
#    **逮不到（5 形；分母 17 是边界不是穷举）**：孙命令
#    （只记到 `sh`）· `$(...)` 拼的 · 位置参数 · `${V:=…}` · `${V:?…}`（后两形尺子**主动排掉**：会写被测
#    变量 / 自带 exit）。逐形读数与形状闸来历见那边头注，**别在这里造第二份**。
acct_row_from_slice() {   # $1=一块含单个账号对象的 JSON 文本 → stdout: <name>\t<configDir>\t<0|1>（取不到则不输出）
  local l="$1" n="" c="" d=0
  [[ "$l" == *'"name"'* ]] || return 0
  # `[[ =~ ]]` 的 `[[:space:]]` 含换行 ⇒ pretty-print 的 manifest 也吃得下，不必先压成一行。
  [[ "$l" =~ \"name\"[[:space:]]*:[[:space:]]*\"([^\"]*)\" ]] && n="${BASH_REMATCH[1]}"
  [ -n "$n" ] || return 0
  [[ "$l" =~ \"configDir\"[[:space:]]*:[[:space:]]*\"([^\"]*)\" ]] && c="${BASH_REMATCH[1]}"
  [[ "$l" =~ \"isDefault\"[[:space:]]*:[[:space:]]*true ]] && d=1
  printf '%s\t%s\t%s\n' "$n" "$c" "$d"
}

# daemon 的 `--list-accounts` 输出（首行 meta + 每账号一行）→ 表。
# ⚠ **只取 name / configDir / isDefault 三个键**：那个面与仓外 aterm 共用（`K10` 半一），
#   少读一个键就少一条跨仓依赖 ⇒ 刻意不消费 `exists`/`loggedIn`/`authKind`/`authReady`
#   （目录在不在照旧本文件自己 `-d` 判）。连带好处：那边加字段，本文件一个字都不用改。
daemon_out_to_table() {   # $1 = daemon 的整段输出
  if command -v jq >/dev/null 2>&1; then
    printf '%s\n' "$1" \
      | jq -r 'select(has("name")) | [.name, (.configDir // ""), (if .isDefault then "1" else "0" end)] | @tsv' 2>/dev/null
  else
    local l
    # `|| [ -n "$l" ]`：最后一行可能没有结尾换行（daemon 是 `println!`，今天有；别赌）。
    while IFS= read -r l || [ -n "$l" ]; do acct_row_from_slice "$l"; done <<<"$1"
  fi
}

# 退路：直接读 manifest 文件。**只在 daemon 缺位 / 答不出 / 问不对时走。**
manifest_to_table() {
  [ -f "$CCM_ACCTS_MANIFEST" ] || return 0
  if command -v jq >/dev/null 2>&1; then
    jq -r '.accounts[]? | select(.name) | [.name, (.configDir // ""), (if .isDefault then "1" else "0" end)] | @tsv' \
       "$CCM_ACCTS_MANIFEST" 2>/dev/null
  else
    # 无 jq：按 `{` 切块喂给共用解析器（`read -d '{'` 是 bash 内建 ⇒ 不需要 `tr`）。
    # 顺带修掉旧兜底两条脆弱假设：①「每账号一行的紧凑格式」（pretty-print 就失灵）；② 键序（见上）。
    # ★ `|| [ -n "$chunk" ]` **不能省**〔08-24 实测，第一版就栽在这儿〕：末块后面没有 `{`
    #   ⇒ 纯 `read -d '{'` 把**最后一个账号对象整块丢掉**（单账号时表直接变空，
    #   症状是「可用: (无账号库)」而 manifest 明明在）。
    #   ⚠ **订正**〔D2 `B3` 订数、D3 `B4` 订枚举；08-25 重数重切〕。**分母：`KCM6` 判据今天 4 条**
    #   （`grep -c '^ck ".*KCM6' e2e/ccm-cli.test.sh`，量于 08-25），顺序：①daemon 在位 ②无 daemon·**首块**
    #   z ③无 daemon·**末块** f ④pretty-print+键序反转。删这条守卫（`MU-E1`，锚点 1/1；判定行
    #   = 全套条数，R7 08-25 重切时 126、别当常量）⇒
    #   **恰好 2 红 = ③④**；**不红的是 ①②**（① 走 `daemon_out_to_table` 与本行无关；② 查首块 `z`，
    #   末块丢了照样解析得出来）。旧注的「第三条」是 R4 前只有 3 条时的序数，且漏了 ②。⚠ R4 也**不是**
    #   「把靶子从 `z` 改成 `f`」：diff 是**保留**旧那条（改名「首块 z」）＋**另加**一条查 `f` 的。
    local chunk
    while IFS= read -r -d '{' chunk || [ -n "$chunk" ]; do
      acct_row_from_slice "$chunk"
    done < "$CCM_ACCTS_MANIFEST"
  fi
}

# 账号表：一行一个账号，TAB 分隔 `<name>\t<configDir>\t<isDefault 0|1>`。
# ★★ **必须在主流程里 load 一次，绝不在 `$(...)` 里 load**：子 shell 里填的缓存出了那层就没了
#    ⇒ 「一趟往返」会变成每问一次一趟（默认号那条路要问两次：默认号 + 它的目录）。
_ccm_acct_tab=""
_ccm_acct_src=""      # daemon | file —— 只作诊断，不参与任何判定
_ccm_acct_loaded=0
acct_table_load() {
  [ "$_ccm_acct_loaded" = 1 ] && return 0
  _ccm_acct_loaded=1
  local why="" am_dir am_name to out
  am_dir="${CCM_ACCTS_MANIFEST%/*}"; am_name="${CCM_ACCTS_MANIFEST##*/}"
  # 查找规则**只有一份**（`DAEMON_BIN_RECIPE`，与 resume / 身份那两条共用）。
  eval "$DAEMON_BIN_RECIPE"
  if [ -z "$_ccm_db" ]; then
    if [ "${CCM_NO_DAEMON:-}" = 1 ]; then why="CCM_NO_DAEMON=1（明示整条关掉 daemon）"
    else why="这台机器上找不到 daemon（cc-monitor-remote）"; fi
  elif [ "$am_name" != "$_CCM_MANIFEST_NAME" ] || [ -z "$am_dir" ] || [ "$am_dir" = "$CCM_ACCTS_MANIFEST" ]; then
    # 见上方「`--accts-dir` 是目录」那段：这个问题 daemon 答不了，不是它坏了。
    why="CCM_ACCTS_MANIFEST 不是 <目录>/$_CCM_MANIFEST_NAME 形态，daemon 的 --accts-dir 表达不了它"
  else
    # 有 `timeout` 就套上、没有就裸调 —— 与 `resolve_from_daemon` 同一条纪律、同一个写法。
    to="$(command -v timeout >/dev/null 2>&1 && printf 'timeout 3 ' || true)"
    # shellcheck disable=SC2086  # $to 要么空、要么是 `timeout 3`，**有意不 quote**
    out="$($to "$_ccm_db" --list-accounts --accts-dir "$am_dir" 2>/dev/null)"
    # 「答上了」的标记 = 那行 meta 在。缺它就分不清「一个账号都没有」与「这二进制答不了」
    # （PATH 上捡到的同名第三方 / 太旧 / 崩了 / 被 timeout 掐了 —— 全长这样）。
    case "$out" in
      *'"kind":"accounts-meta"'*)
        _ccm_acct_tab="$(daemon_out_to_table "$out")"
        _ccm_acct_src=daemon
        unset _ccm_db
        return 0 ;;
      *) why="daemon（$_ccm_db）答不出 --list-accounts" ;;
    esac
  fi
  unset _ccm_db
  _ccm_acct_src=file
  _ccm_acct_tab="$(manifest_to_table)"
  # **降级出声**（`§0b` 裁定）。⚠ 只在**真读了一份 manifest** 时说：压根没账号库的机器上
  # ccm 就是个基座启动器，不该被它吵（判据：「无账号库 → 退化为基座（不报错）」）。
  [ -f "$CCM_ACCTS_MANIFEST" ] && printf 'ccm: 账号解析已降级为**直接读 manifest**（%s）—— %s。后端本该是账号的唯一真相源；两份不一致时你拿到的是文件那一份（daemon 有 schema 版本闸与 configDir 安全谓词，文件这条没有）。\n' \
     "$CCM_ACCTS_MANIFEST" "$why" >&2
  return 0
}

# 名字 → configDir。解析不到 → 回空串（由**顶层**判空后中止；显式选号绝不静默降级）。
# **只回显值、绝不 die** —— 本函数在 `$(...)` 里被调用，`die`(exit 2) 只杀子 shell、主流程照跑
# ⇒ 用户打错账号名会**静默落到继承来的账号上**（rc=0）。实测踩过，比「换号不生效」更坏。
# ⚠ 目录存在性照旧本文件自己 `-d` 判（不消费 daemon 的 `exists`）。
account_config_dir() {
  local want="$1" n c d
  while IFS=$'\t' read -r n c d; do
    [ "$n" = "$want" ] || continue
    [ -n "$c" ] && [ -d "$c" ] && printf '%s' "$c"
    return
  done <<<"$_ccm_acct_tab"
  printf ''
}

# 账号名列表（给错误信息用——报"不可用"必须同时告诉用户有哪些可用）。
# ⚠ 无尾空格：旧版两条分支在这点上**本来就不一致**（`jq … join(" ")` 无、`tr '\n' ' '` 有），
#   而钉它的判据只在装了 jq 的机器上跑过。统一成无。
list_account_names() {
  local out="" n c d
  while IFS=$'\t' read -r n c d; do
    [ -n "$n" ] || continue
    out="$out${out:+ }$n"
  done <<<"$_ccm_acct_tab"
  [ -n "$out" ] && printf '%s' "$out" || printf '(无账号库)'
}

# 默认账号（`isDefault: true`）。多个取第一个（同旧版 `head -1`）。
default_account_name() {
  local n c d
  while IFS=$'\t' read -r n c d; do
    [ "$d" = 1 ] && { printf '%s' "$n"; return; }
  done <<<"$_ccm_acct_tab"
  printf ''
}

# 账号解析。三态：
#   显式 --account X  → 必须解析成功，否则**中止**（显式选号绝不静默降级到别的号）
#   显式 --base       → 不注入（issue #75 逃生口：装账号功能前的老会话住基座）
#   都不传            → 落 manifest 的 isDefault（复刻旧 `_cc_acct_last` 的粘滞体验）。
#     **这条必须有**：cc-acct-iso 把凭据搬进各账号目录后，基座 `~/.claude/.credentials.json`
#     通常已不存在 —— 不落默认号的话，最常敲的 `cc`/`cct` 会掉进一个没登录的 config dir。
#
# ★ `K-C1`：`acct_table_load` **在主流程里、且只在真要解析时**调 —— 两条都承重：
#   · 在主流程（不在 `$(...)` 里）⇒ 一次进程往返答完三个问题（见它的头注）；
#   · 只在真要解析时 ⇒ `--base` 与「已继承 CLAUDE_CONFIG_DIR」这两条路**一次 daemon 都不问**
#     （它们本来就不需要账号表；问了就是白付一次往返，还会把 `--print` 变吵）。
config_dir=""
if [ -n "$account" ]; then
  acct_table_load
  config_dir="$(account_config_dir "$account")"
  [ -n "$config_dir" ] || die "账号 '$account' 不可用（不在 $CCM_ACCTS_MANIFEST，或其目录不存在）。可用: $(list_account_names)"
elif [ "$use_base" != 1 ] && [ -z "${CLAUDE_CONFIG_DIR:-}" ]; then
  # **只在调用方没有已选定账号时才落默认号**（真机复现过的 bug：cc-monitor 把
  # `resumeCommandRemote` 配成 ccm 时，是「外层已 export 好账号 X 的 CLAUDE_CONFIG_DIR，
  # 再 exec ccm --resume <sid>（不带任何账号 flag）」——这条路径下，若无脑落默认号，会把
  # cc-monitor 精心选中的账号 X **静默覆盖**成 manifest 的 isDefault，等于账号选择完全失效。
  # 加 `-z "${CLAUDE_CONFIG_DIR:-}"` 这道闸：已有继承来的账号 → 尊重它、不覆盖；
  # 真正的"空白终端裸敲 cc/cct"（无继承）才落默认号——两个场景用同一条 if 天然区分。
  acct_table_load
  _def="$(default_account_name)"
  if [ -n "$_def" ]; then
    config_dir="$(account_config_dir "$_def")"
    [ -n "$config_dir" ] || die "默认账号 '$_def' 目录不存在（manifest 说它是 isDefault）。用 --base 起基座，或 --account <名> 指定。"
    account="$_def"
  fi
fi

# ===== L3/L4：启动器与参数 =====
# 显式 `--launcher` 要优先于 daemon 的建议（见 resolve_from_daemon 头注）——
# 必须在填默认值**之前**记下来，填完就分不清「用户写的」与「默认的」了。
launcher_explicit=0; [ -n "$launcher" ] && launcher_explicit=1
[ -n "$launcher" ] || launcher="$(agent_default_launcher "$agent")"
nested="$(agent_nested_env "$agent")"

argv=("$launcher")
if [ "$action" = resume ]; then
  rf="$(agent_resume_flag "$agent")"
  argv+=("$rf" "$sid")
fi
[ ${#passthru[@]} -gt 0 ] && argv+=("${passthru[@]}")

# ===== attach：不起 agent，直接接回 =====
if [ "$action" = attach ]; then
  # B02 审计重要-4：`attach` 分支在这里就 exec 掉了，早于下面的容器逻辑，所以
  # `ccm attach foo --tmux --detach` 会**静默吞掉** `--detach` 照样 attach。
  # 静默忽略正是本工作区反复消灭的病（写了个修饰、看起来生效了、其实被吃掉）。
  [ "$detach" = 1 ] && die "attach 动作与 --detach 矛盾（attach 的语义就是接进去）"
  [ -n "$tmux_size" ] && die "attach 动作不支持 --tmux-size（接回既有会话，尺寸归它自己）"
  cmd="tmux attach -t $(sq "=$attach_name:")"
  if [ "$do_print" = 1 ]; then printf '%s\n' "$cmd"; exit 0; fi
  exec tmux attach -t "=$attach_name:"
fi

# ===== --tmux：把「同一条 ccm 命令、去掉 --tmux」送进容器内部 =====
# 关键：**外层一个 env 都不设**。env 由容器内部那次 ccm 调用自己设 —— 这样它落在最终 exec 的
# 那个 shell 里，穿得过 tmux 的进程边界（旧 cct 正是死在这一步）。
# **已经在 tmux 里 → 就地起**（旧 `cct` 有这条分支：`if [ -n "$TMUX" ]; then … return; fi`）。
# 不然会另建一个 detached 会话、agent 跑在用户看不见的地方，而 `tmux attach` 报
# "sessions should be nested with care" rc=1 → 用户原地不动、什么也没拿到（实测）。
# cc-monitor / cc-bus 用户基本常驻 tmux，这条必须有。
# ⚠ `--tmux-base` 也算**给了名**（`C15` 08-13）：给基名的调用方（cc-spawn）明确要的是容器 ——
#   它随后要读 `ccm-session=` 拿回名字去登记总线。把它归进「无名」会让它在 tmux 内**就地起**，
#   于是既没有会话名可报、`--detach` 也落空 —— 正是下面那段头注在防的语义反转。
if [ "$use_tmux" = 1 ] && [ -n "${TMUX:-}" ] && [ -z "$tmux_name" ] && [ -z "$tmux_base" ]; then
  # B02 审计重要-4：这条分支把 `use_tmux` 清零 → 不再走容器路径 → `--detach` /
  # `--tmux-size` 双双落空。对 `--detach` 尤其危险：调用方要的是"建完就返回"，
  # 拿到的却是**阻塞式 exec**（就地把当前 shell 换成 agent），语义完全相反。
  # 显式 die：要么别在 tmux 里用无名 --tmux，要么给个显式会话名走真容器路径。
  if [ "$detach" = 1 ] || [ -n "$tmux_size" ]; then
    die "已在 tmux 内且未给会话名 → 会就地起而非建容器，--detach/--tmux-size 无法生效。请用 --tmux=<显式名>"
  fi
  use_tmux=0
fi

if [ "$use_tmux" = 1 ]; then
  command -v tmux >/dev/null 2>&1 || die "未安装 tmux"
  if [ -n "$tmux_base" ]; then
    # ★ `--tmux-base=<基名>`（`C15`〔用@08-13「cc-bus收进ccm」〕）：**调用方给底、ccm 避让**。
    # 形状校验与显式名**同一份**（`validate_tmux_name`）—— 基名会原样变成会话名（不撞时），
    # 只校验显式名那条路等于给避让路开了个后门。
    validate_tmux_name "$tmux_base"
    tmux_name="$(avoid_name_collision "$tmux_base")"
  elif [ -n "$tmux_name" ]; then
    # 显式 `--tmux=<名>` 是一条**创建**路径 → 过 INVARIANTS §31a 的第二道防线：
    # 禁 glob `*`/`?`（`kill-session -t 'a*a'` 实测会命中并杀掉 `alpha`）、禁 tmux 保留字
    # `.`/`:`（session:window.pane 分隔符）、禁前导 `-`（会被当成选项）、禁控制字符与空串。
    validate_tmux_name "$tmux_name"
    # 显式名到此为止 —— **不做派生、不做避让**。调用方（cc-monitor）传显式名正是因为它
    # 自己算好了要哪个会话（如灰会话 fresh resume 的 `cc-<sid8>-2`），CLI 再改一次就错了。
  else
    tmux_name="$(avoid_name_collision "$(derive_tmux_name "$cwd")")"
    # **无条件避让**：名字被占就退到 `-2/-3/...`，不问它是不是同一个目录。
    #
    # 这一条同时覆盖了原先那个更窄的判据（同名但异目录：派生规则会把 basename 全非 ASCII
    # 的目录一律塌成 `cc-session`，`~/文档` 与 `~/下载/测试` 同名，不避让会**接回前者里那个
    # claude**）—— 无条件避让是它的超集，故那段单独的 cwd 比对已删。
    #
    # （`--print` 纯度与避让的时机纪律见 `avoid_name_collision` 头注 —— 那段随实现上提了。）
  fi

  # F11（unify-launch）：预信任 $cwd，免 claude/codex 起来卡在信任确认框数小时（detached
  # 会话没人盯着按 Enter）。逻辑原样搬自 cc-bus 的 cc-spawn（已生产验证过，照抄不重新设计），
  # 测试钩子改名 CCM_CLAUDEJSON/CCM_CODEXTOML（对齐 CCSPAWN_* 的既有命名模式）。
  # **`--print` 跳过**——预信任是写文件的副作用，`--print` 必须纯（同上方 tmux 状态查询的既有纪律）。
  # **维护提示**：这段逻辑与 cc-spawn 里的同名实现目前仍是重复实现，但 **B01 之后两者已同仓**
  # （`shared/cc-bus/scripts/cc-spawn`，不再是"分属不同仓库、没有共享源可抽"）。**B02 的任务
  # 正是消除这处重复**：cc-spawn 改为经 `ccm` 起会话，届时这段就是唯一实现、本提示可删。
  # 在 B02 落地之前，改动这里仍需手动对拍 `shared/cc-bus/scripts/cc-spawn` 的同名逻辑
  # （如 TOML 转义字符集、jq 校验），差别在于**现在同仓可写测试检测漂移了**。**例外**：`CCM_NO_PRETRUST`
  # 逃生口是 `ccm` 独有的、cc-spawn 没有对应机制——这处差异是有意的（受众判断不同，见下方
  # opt-out 处的说明），对拍 cc-spawn 时不要把这条误判成"漏同步"。
  pretrusted=0
  # Phase D 审计（重要项修复）：ccm --tmux 是 cc-monitor 主 UI 的默认统一实现（受众比 cc-spawn
  # 这类窄众协作工具宽得多），照搬一个无退出口的行为不合适——加 CCM_NO_PRETRUST=1 逃生口
  # （已写进 --help 文本）。
  if [ "$do_print" != 1 ] && [ "${CCM_NO_PRETRUST:-}" != 1 ]; then
    # Phase D 审计（阻塞项修复）：cc-spawn 的 $absdir 恒经 `cd && pwd` 规范化，本脚本的 $cwd
    # 在 `--cwd <相对路径>` 时**不**保证是绝对路径（`resolve_cwd` 对非 auto 值原样透传）——
    # 若直接拿 $cwd 当 JSON/TOML key，会写出字面量 "."/"../foo" 这种野 key：① 对真实的
    # Claude/Codex 信任表毫无意义（它们用真绝对路径查），预信任完全零效果；② 还会往用户
    # 真实的 ~/.claude.json/~/.codex/config.toml 里永久塞一条垃圾条目，且 `jq -e .` 校验照样
    # 通过、不报任何错——已实测复现。修法：预信任专用一份规范化路径 $cwd_abs，解析失败
    # （目录已消失等极端情况）就放弃预信任而非拿一个可能错误的相对路径瞎写。
    cwd_abs="$(cd "$cwd" 2>/dev/null && pwd)" || cwd_abs=""
    if [ -n "$cwd_abs" ]; then
      if [ "$agent" = claude ]; then
        cj="${CCM_CLAUDEJSON:-$HOME/.claude.json}"
        if [ -f "$cj" ] && command -v jq >/dev/null 2>&1; then
          if jq -e --arg d "$cwd_abs" '.projects[$d].hasTrustDialogAccepted == true' "$cj" >/dev/null 2>&1; then
            pretrusted=1
          else
            cp -p "$cj" "$cj.bak-ccm.$$" 2>/dev/null || true
            tmpj="$cj.tmp.ccm.$$"
            if jq --arg d "$cwd_abs" '(.projects[$d].hasTrustDialogAccepted) = true' "$cj" > "$tmpj" 2>/dev/null \
               && jq -e . "$tmpj" >/dev/null 2>&1; then
              mv "$tmpj" "$cj"; pretrusted=1; rm -f "$cj.bak-ccm.$$"
            else
              rm -f "$tmpj"; echo "ccm: 预信任写入失败（claude 起来可能弹信任框，已备兜底）" >&2
            fi
          fi
        fi
      elif [ "$agent" = codex ]; then
        ct="${CCM_CODEXTOML:-$HOME/.codex/config.toml}"
        mkdir -p "$(dirname "$ct")" 2>/dev/null || true
        [ -f "$ct" ] || : > "$ct"
        # 路径含控制字符会破坏 TOML → 跳过预信任（同 cc-spawn；正常路径含空格/unicode/"/\ 无碍）。
        if [[ "$cwd_abs" == *[[:cntrl:]]* ]]; then
          echo "ccm: codex 预信任跳过——目录路径含控制字符（会破坏 config.toml）" >&2
        else
          cesc=${cwd_abs//\\/\\\\}; cesc=${cesc//\"/\\\"}
          ( flock 9
            if ! grep -qF "[projects.\"$cesc\"]" "$ct" 2>/dev/null; then
              # ★★ **备份不成就别动它**〔08-13 实测补〕：这条是**追加写**（不是 claude 那条的
              #    「临时文件 + 校验 + 原子 rename」），而下面的失败恢复**依赖这份备份存在** ——
              #    `cp` 失败被 `|| true` 吞掉之后，`[ -f "$ct.bak…" ]` 那条就静默跳过，
              #    于是用户的 `config.toml` **被写了一半、又没人补回去**。
              #    ⇒ 备份失败 = 放弃这次预信任（它本来就是 best-effort），并**说一句**。
              #    ⚠ 与 claude 那条的差别是**写法**不同，不是我厚此薄彼：
              #      原子替换那条即使不备份也伤不到原文件，这条不行。
              if ! cp -p "$ct" "$ct.bak-ccm.$$" 2>/dev/null; then
                echo "ccm: codex 预信任跳过——备份 $ct 失败（磁盘满/只读？），不敢在没有退路时追加写" >&2
              elif printf '\n[projects."%s"]\ntrust_level = "trusted"\n' "$cesc" >> "$ct" 2>/dev/null; then
                rm -f "$ct.bak-ccm.$$"
              else
                [ -f "$ct.bak-ccm.$$" ] && mv -f "$ct.bak-ccm.$$" "$ct"
                echo "ccm: codex 预信任写入失败（codex 起来可能弹信任框）" >&2
              fi
            fi
          ) 9>>"$ct.lock"
          grep -qF "[projects.\"$cesc\"]" "$ct" 2>/dev/null && pretrusted=1
        fi
      fi
    fi
  fi

  # 内层命令 = 自己 + 全部修饰（去掉 --tmux，cwd 固化为已解析值，避免容器内重新 resolve）
  inner=("$CCM_SELF")
  [ "$action" = resume ] && inner+=(resume "$sid")
  inner+=(--cwd "$cwd" --agent "$agent")
  [ -n "$account" ] && inner+=(--account "$account")
  [ "$use_base" = 1 ] && inner+=(--base)
  [ -n "$model" ] && inner+=(--model "$model")
  [ -n "$launcher" ] && inner+=(--launcher "$launcher")
  [ -n "$ccm_sid" ] && inner+=(--ccm-sid "$ccm_sid")
  # `--detach` / `--tmux-size` **不**转发：它们是外层容器自身的属性（要不要 attach、
  # 新建窗口多大），内层没有 --tmux，转发过去只会撞上「--detach 需要配合 --tmux」。
  [ ${#passthru[@]} -gt 0 ] && inner+=(-- "${passthru[@]}")

  payload=""
  for a in "${inner[@]}"; do payload="$payload${payload:+ }$(sq "$a")"; done

  # R08（2026-07-28 实测复现并修复）：**继承来的账号必须在这里被显式化**，否则会在容器边界丢掉。
  #
  # 账号解析（见上方 `config_dir=` 那段）有一条刻意的沉默分支：既没传 --account/--base、
  # 但 CLAUDE_CONFIG_DIR 已有继承值时，`account` 与 `config_dir` **都留空**——因为
  # "尊重继承值"在非容器路径下等于"什么都不做"（`exec` 保留进程环境，天然正确，这正是 R11 的修法）。
  #
  # 但容器路径不成立：send-keys 打进的是 **tmux server fork 出来的新 shell**，
  # 其环境来自 tmux server 全局环境，而 `update-environment` 默认列表**不含** CLAUDE_CONFIG_DIR
  # （MASTERPLAN §2.1 实测的那份列表）——继承值在 L1 边界被整个吃掉。内层 ccm 于是看到
  # "空的 CLAUDE_CONFIG_DIR + 没有账号 flag" → 落 manifest 默认号，把调用方选中的号静默换掉。
  # 症状与 R11 同型且同样隐蔽：**看起来生效了，只是换成了错的号。**
  #
  # 修法：把继承值写进载荷**内侧**（export 在 tmux 边界的里面，故穿得过去）。
  # 为什么不反查 manifest 换成 `--account <名>`：① 继承值可能指向 manifest 外的目录
  # （用户自己维护 CLAUDE_CONFIG_DIR 的边缘配置，见 R13），反查不到就没法表达；
  # ② 逐字节转发继承值语义最保真，不引入 名→目录 的二次解析。
  # 内层 ccm 收到后会命中它自己的 `-z "$CLAUDE_CONFIG_DIR"` 闸 → 尊重、不覆盖（复用 R11 的机制）。
  #
  # 三条不受影响：`--account` / 默认号回退（两者 `account` 非空 → 上面已发 --account）
  # 与 `--base`（已发 --base）；本分支只在"三者皆无、仅有继承值"时触发。
  if [ -z "$account" ] && [ "$use_base" != 1 ] && [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
    payload="export CLAUDE_CONFIG_DIR=$(sq "$CLAUDE_CONFIG_DIR"); $payload"
  fi

  # K-H2b：中转 base URL 与上面 R08 同坑同修法（外侧那句 export 会在 tmux 边界被吃掉，
  # 症状是「中转接上了、走 tmux 的会话却全是官方直连」）。ccm 仍不是注入点，只是别吃掉它。
  # 判据住 `payload.rs::the_ccm_container_path_forwards_the_relay_base_url_…`。
  if [ -n "${ANTHROPIC_BASE_URL:-}" ]; then
    payload="export ANTHROPIC_BASE_URL=$(sq "$ANTHROPIC_BASE_URL"); $payload"
  fi

  # K-P5c：起会话方铸的**身份 token** 与上面 R08 / K-H2b 同坑同修法（第三次了：外侧那句
  # export 在 tmux 边界被整个吃掉）。症状是「起会话方以为把身份交下去了，而 agent 进程的
  # 环境里根本没有它」。ccm 仍**不是注入点**——铸法只有一份，住 Rust 侧的
  # `payload::route_key_for_session`；这里只是**别吃掉它**。
  # 判据住 `payload.rs::the_ccm_container_path_forwards_the_launch_identity_…`。
  # ⚠ 与上面两条不同的是：**这一条今天真有生产人群**（身份前缀是无条件拼的，而 `Base` 账号
  # 渲得出 ccm 容器）——上面那条 base URL 的今天走不到（具名账号进不了 ccm，见那条判据头注）。
  if [ -n "${CCM_LAUNCH_ID:-}" ]; then
    payload="export CCM_LAUNCH_ID=$(sq "$CCM_LAUNCH_ID"); $payload"
  fi

  t="$(sq "=$tmux_name:")"
  # `--tmux-size`：detached 会话默认 80x24，太窄会把 agent 输出折行（cc-spawn 一直用 220x50）。
  # 只对**新建**生效——幂等接回既有会话时 new-session 失败短路，尺寸自然不动，这是对的：
  # 已有会话的尺寸归它自己（可能有人正 attach 着），不该被后来的调用方改掉。
  # 已在上方校验过只含数字与单个 x，故此处直接拆开拼入无注入面。
  size_opt=""
  [ -n "$tmux_size" ] && size_opt=" -x ${tmux_size%x*} -y ${tmux_size#*x}"
  # ★★ 〔`P3sc` 08-13，`C15` 解除账本红线后〕**显式名撞了就响亮失败，不再静默接回**。
  #
  # 原来这里是「幂等建闸」：会话已存在 → new-session 失败**被吞**、`&&` 短路跳过后续
  # → 只 attach（不重复起）。那在「同一个名字反复调」的用法下是对的，
  # 但它与 `C14`〔用@08-12〕逐字「**所有起会话就是起会话……spawn 就是起, 就是 creat**」冲突，
  # 而且留着一个与 `#76` **后果逐字相同**的竞态：
  # 调用方（cc-monitor / cc-spawn）铸完名到真跑之间若有人抢占了这个名字 ⇒
  # **静默接进别人的会话，而载荷一个字都没送**（`&&` 短路把 send-keys 跳过了）——
  # 用户以为开了新的，实际进了别人的。
  #
  # ⇒ 撞名 ⇒ **退出码 3 + 说清是哪个名字**，绝不 attach。
  # ⚠ 这**不影响**缺省名那一支：它在上游已经无条件避让（`P3s §0c` 实测），走不到这里。
  # ⚠ 也不影响 `ccm attach <名>`：那是**另一条命令**，`P3s` 起会话与 attach 分家之后，
  #   「我要接回已有会话」有它自己的入口，不必再靠这条静默兜。
  #
  # ★★ 〔`K-P2` `D` 阶段第三拍 09-03〕**建会话先走后端那条一次性口**（见 `launch_via_daemon`）。
  # ★★ 〔`K-P2` `F` 拍 09-04；用@09-04 逐字「**ccm不要管找不到, 统一走后端**」〕
  #    **本机 tmux 直起那条退路，从 exec 路上删掉了。** exec 路只剩一条：后端。
  #    后端不可达 ⇒ `launch_via_daemon` 走 `backend_unreachable`（唯一失败面，`exit 4`），
  #    **不再退回本地、也不再有「降级」这回事**。
  #
  # 🔴 **`--print` 仍吐本机那条编排的配方 —— 这一格是「未裁」，不是「留了退路」。**
  #    两者分得开的判据是**行为**，不是字面：exec 路上 `tmux new-session` **一次都跑不到**
  #    （下面这个 `if` 的两支是互斥的，而 `--print` 那支**只打印、不执行**）。
  #    钉住这件事的是 `ccm_cli_contract::the_local_launch_recipe_is_reachable_only_from_print`。
  #    ⚠ **为什么不同拍把配方也换掉**：`e2e/ccm-print-parity.sh` 那 **12** 条里 **11** 条
  #      逐字断言 `--tmux --print` 吐的是 `-s '<名>'` / `-c '<cwd>'` /
  #      `@ccm_sid_expect '<sid>'` / `send-keys` 送进去的内层载荷（现打，量于 `d305ffa`）
  #      ⇒ 换掉配方要**同拍重写那一套**，而 `e2e/` 不在本件写区。
  #      件文件 `§6-5 上报③`（「`--print` 删掉本地那条之后吐什么 —— 牵动 80 条 e2e」）
  #      已登记这一格归 PM/用户裁，本拍**不自批**。
  #
  # ⚠ **删掉的那个状态变量叫 `_ccm_launched=`** —— 它是「这一趟没走成后端」的运行时事实
  #   （`= 1` 才跳过本地那块）。退路一删它就没有存在的理由了。
  #   **这一句不是纪念碑，是判据的靶子**：`ccm_cli_contract` 的 `BACKEND_BACKED_PATHS`
  #   给 `--launch` 登记的 `gone` 就是这个串，而那条判据要求它
  #   「在**注释里**找得到、在**生产段**里找不到」——
  #   ⇒ 把这个名字从注释里删掉，判据当场红；而不写这一句的话，`gone` 那个锚点
  #   可以被改成任何一个「反正不在生产段里」的串，那一半就退化成空真。
  if [ "$do_print" = 1 ]; then
    seq="{ tmux new-session -d -s $(sq "$tmux_name") -c $(sq "$cwd")$size_opt 2>/dev/null"
    seq="$seq || { printf $(sq "$NAME_TAKEN_FMT") $(sq "$tmux_name") >&2; exit 3; }; }"
    seq="$seq && (tmux set-option -t $t @ccm_agent $(sq "$agent") 2>/dev/null || true)"
    # F04：通道A（意图）写 @ccm_sid_expect，不写 @ccm_sid——只有通道B（独立读会话文件后确认）
    # 才写 @ccm_sid，破坏性动作（kill 等）只认 @ccm_sid，不被"声明了但从未真正跑起来"
    # 的会话骗过（见 doc/INVARIANTS.md 对应条目 / MASTERPLAN R10）。
    # ⚠ `U-NP④`（08-14）：通道B 的执行者已是 **daemon**（`control/identity_tag.rs`），不是 ccm。
    [ -n "$ccm_sid" ] && seq="$seq && (tmux set-option -t $t @ccm_sid_expect $(sq "$ccm_sid") 2>/dev/null || true)"
    seq="$seq && tmux send-keys -t $t $(sq "$payload") Enter"
  else
    # ⚠ 直接判命令的退出码（`if ! cmd; then`），不走 `$?`。
    #   rc=0 ⇒ 后端把会话建好并键入了载荷（`created:true` ⇒ 它同时保证 `typed:true`）。
    #   rc≠0 ⇒ **只可能是 rc=2**（后端说 `created:false` = 这个名字已经在）：
    #          「后端不可达」那一格在 `launch_via_daemon` 里就 `exit` 掉了，到不了这里。
    #   ⇒ 撞名走 `C14` 那条**响亮失败**：带上是哪个名字 ＋ `exit 3`，绝不静默接回别人的会话。
    if ! launch_via_daemon "$tmux_name" "$payload" "$cwd" "$ccm_sid" "$agent" "$tmux_size"; then
      # shellcheck disable=SC2059  # 格式串**有意**取自 `NAME_TAKEN_FMT`（唯一一处字面量）
      # ⚠ `printf` 与 `exit 3` **写在同一行**：判据逐行核「每个报出口都带非零码」，
      #   拆成两行会让它读成「这个出口不响亮」。〔本轮自查逮到，铁律 15〕
      printf "$NAME_TAKEN_FMT" "$tmux_name" >&2; exit 3
    fi
    # 会话与载荷都已经由后端做完。剩下的三件仍是**本机**的事：
    # 预信任兜底轮询 · attach（平面③，daemon 开不了你面前的窗）· 总线登记（要 pane id）。
    # ⇒ 它们照旧挂在下面。
    seq=":"
  fi
  # Phase D 审计（阻塞项修复）：预信任只搬了"写入"，没搬 cc-spawn 真正的安全网——写入没成功
  # 时（jq/文件缺失/写失败，任何原因）轮询抓 pane 文本找信任框、自动按 Enter（同 cc-spawn
  # cc-spawn:122-133）。detached 会话没人盯着，且本地 tmux 会话在 cc-monitor 前端完全不可见
  # （capture-pane 预览只对远端 origin 开放）——没有这层兜底，信任框会静默卡死且没人发现。
  # 只对 claude 做（同 cc-spawn：codex 已由 config.toml 预信任生效，不弹这个交互框）；
  # `&&` 挂在 send-keys 之后，幂等接回既有会话时（new-session 失败短路）不会误触发轮询。
  # CCM_NO_PRETRUST=1 也关掉这条自动按 Enter 兜底——选择不自动管理信任的用户不该被这条
  # 换了个机制（每次自动按而非持久化写入）的路径悄悄绕过。
  # **`|| true` 不能省**（B02 审计阻塞-1，实测复现）：`for` 循环的退出码 = 最后一条命令的
  # 退出码，而**信任框没出现**（绝大多数正常情况）时最后一条是失败的 `grep -q`，循环 rc=1。
  # 在 `--detach` 出现之前，这个 rc 被尾部的 `; tmux attach` 冲掉了，没人看得见；`--detach`
  # 把 attach 摘掉之后它就直接成了 `exec bash -c "$seq"` 的退出码 —— 于是「预信任没生效」
  # （`~/.claude.json` 不存在 / 没装 jq / 该文件是坏 JSON）这条**良性**路径上，ccm 恒返回 1，
  # 调用方（cc-spawn）判定失败并跳过 `cc-register` 与台账，留下一个**真的在跑、却不在总线上
  # 的孤儿会话**，同时报出与事实相反的"建会话失败"。兜底本身是 best-effort，它的成败
  # 不该表达为整条链的成败。
  if [ "$agent" = claude ] && [ "$pretrusted" != 1 ] && [ "${CCM_NO_PRETRUST:-}" != 1 ]; then
    seq="$seq && { (for _i in 1 2 3 4 5 6; do sleep 0.5; tmux capture-pane -t $t -p 2>/dev/null | grep -q 'Yes, I trust this folder' && { tmux send-keys -t $t Enter; break; }; done) || true; }"
  fi
  # `--detach`：只建会话就返回，不 attach。
  # **为什么这是拆开而非新增**：`--tmux` 至此一直同时承担两件正交的事——「起一个容器」与
  # 「把当前终端 attach 进去」。cc-monitor 的 UI 两件都要（它开一个终端窗口给用户看），
  # 于是二者被焊在了一起；而 cc-spawn 只要前者：它建完还得拿 pane id 去 `cc-register`
  # 登记总线、写 `spawned.tsv` 台账、打印用法提示——attach 会当场夺走控制流，这些都做不成。
  # 焊在一起就是 MASTERPLAN §0 说的那个病（「一个动作 + 若干正交修饰」被写死成一套实现），
  # `--detach` 把「要不要 attach」还原成一个独立修饰。**默认仍 attach，既有调用方零感知。**
  [ "$detach" = 1 ] || seq="$seq; tmux attach -t $t"

  # ★★ `C15`〔用@08-13「cc-bus收进ccm」〕第二、三件：**总线登记 + 台账**。
  #
  # ## 收进来 ≠ 让 ccm 复刻 cc-bus 的格式
  #
  # `agents.tsv` / `spawned.tsv` 的列、分隔符、锁文件命名是 **cc-bus 的私事**（`cc-list` 等在读）。
  # `ccm` 再写一遍 = 同一个格式两份实现，改一处漏一处 —— 正是本仓一路在收的那一族。
  # ⇒ 这里只做两件事：**找到 cc-bus 的脚本**，**把事实告诉它**。格式仍归 cc-bus。
  #
  # ## 找法与「找不到」的处置
  #
  # `CC_BUS_SCRIPTS`（测试/部署钩子）> `<ccm 所在目录>/cc-bus/scripts`（仓内是
  # `shared/ccm` 与 `shared/cc-bus/`；部署后是 `~/.claude/skills/ccm` 与
  # `~/.claude/skills/cc-bus/` —— **两种形态下同一条相对路径都成立**）> PATH 上的 `cc-register`。
  # **找不到就静默 no-op**：没装 cc-bus 的人不该被一个总线脚本挡住起会话。
  # ⚠ 但「你要了登记却没登上」不能一声不吭 —— 那会产出一个**在跑、却不在总线上的孤儿**
  #   （B02 审计阻塞-2 的同款形状：假成功比失败更坏）。⇒ 往 stderr 说一句，rc 不变。
  if [ "$bus_register" = 1 ]; then
    # ⚠ 用 `readlink -f` 解自身：部署形态下 `~/.local/bin/ccm` 是**软链**，
    #   直接 dirname 会落到 `~/.local/bin/cc-bus/scripts`（不存在），而真身在
    #   `~/.claude/skills/`。cc-spawn 找 ccm 时踩过同一个坑，那边也是 `readlink -f`。
    _ccm_real="$(readlink -f "$CCM_SELF" 2>/dev/null || printf '%s' "$CCM_SELF")"
    bus_scripts=""
    if [ -n "${CC_BUS_SCRIPTS:-}" ]; then
      # 显式指了就用它 —— 但**不许静默地指到空处**：指错了要当场说，不然登记默默不发生。
      [ -x "$CC_BUS_SCRIPTS/cc-register" ] && bus_scripts="$CC_BUS_SCRIPTS"
    elif [ -x "${_ccm_real%/*}/cc-bus/scripts/cc-register" ]; then bus_scripts="${_ccm_real%/*}/cc-bus/scripts"
    elif command -v cc-register >/dev/null 2>&1; then bus_scripts="$(dirname "$(command -v cc-register)")"
    fi
    if [ -z "$bus_scripts" ]; then
      printf 'ccm: --bus-register 要了登记，但找不到 cc-bus 的脚本（CC_BUS_SCRIPTS / %s/cc-bus/scripts / PATH）——**没有登记**\n' "${_ccm_real%/*}" >&2
    else
      # 登记要 pane id（`cc-register` 认 `TMUX_PANE`）。**必须在会话建出来之后取** ⇒ 拼进 seq。
      # 整段 best-effort（`|| true`）：登记失败不该把「会话建好了」表达成失败
      #（与上面预信任兜底那条 `|| true` 同一个理由，见其头注）。
      seq="$seq; { _p=\$(tmux list-panes -t $t -F '#{pane_id}' 2>/dev/null | head -1)"
      # ⚠ **只吞 stdout，放开 stderr**〔08-13 实测改〕：
      #   这两个脚本成功时**只往 stdout 说话**（`cc-register` 打一行「已登记」，
      #   `cc-spawned-record` 一个字不打）⇒ 吞 stdout 不丢诊断、也不吵。
      #   而 `2>&1` 会把**失败原因**一起吞掉：整段是 best-effort（`|| true`），
      #   于是「磁盘满 / 目录只读 / 台账文件只读」全都变成**悄悄没有台账**。
      #   ★ 实测过三种失败面，`cc-spawned-record` 自己 rc=1 且有话说 —— 别在这一层把它闷死。
      seq="$seq; [ -n \"\$_p\" ] && TMUX_PANE=\"\$_p\" $(sq "$bus_scripts/cc-register") $(sq "$tmux_name") >/dev/null"
      # ★ 台账脚本**单独查一次**〔08-13〕：定位用的是 `cc-register`，而这两个脚本
      #   **不是同时进来的** —— `cc-spawned-record` 是 `C15` 才加的。用户盘上那份 cc-bus
      #   只要比它旧（`exec-bit-guard` 早就在警告仓内与 `~/.claude/skills/cc-bus` **已漂移**），
      #   就会是「登记照常、**台账悄悄没了**」：整段是 best-effort，失败一个字都不会说。
      #   ⇒ 缺了就说一句，然后**照旧继续**（台账没了不该挡住起会话）。
      if [ -x "$bus_scripts/cc-spawned-record" ]; then
        seq="$seq; $(sq "$bus_scripts/cc-spawned-record") $(sq "$tmux_name") $(sq "$cwd") $(sq "$bus_note") >/dev/null; } || true"
      else
        seq="$seq; } || true"
        printf 'ccm: %s 不在（或不可执行）—— 会话会**登记上总线但不进 spawn 台账**。cc-bus 该同步了。\n' "$bus_scripts/cc-spawned-record" >&2
      fi
    fi
  fi

  if [ "$do_print" = 1 ]; then printf '%s\n' "$seq"; exit 0; fi
  # ★★ 〔`P4b①` 08-13，`C15` 的前置〕**把最终会话名报出来**。
  #
  # 为什么非有不可：`C15` 要把 cc-bus 那三件（命名避让 / 总线登记 / 台账）收进 `ccm`，
  # 而**第一件搬走的瞬间，调用方就不知道会话叫什么了** —— cc-spawn 今天是自己算出
  # `$name` 再拿它去 `cc-register`、写 `spawned.tsv`、打提示。
  # ⇒ 名字必须由**建它的人**说出来，否则「谁建的谁知道」这个事实会被拆成两处各算一遍
  #  （而那正是本仓一路在收的「同一个事实两份实现」）。
  #
  # 形状：`ccm-session=<名>` 一行到 **stdout**，机器可解析（`sed -n 's/^ccm-session=//p'`）。
  # ⚠ 只在 `--detach` 时打：不 detach 的那条路紧接着 `exec` 进 attach，
  #   stdout 归被 attach 的程序，往里插一行会污染用户屏幕。
  # ⚠ 排在 `exec` **之前** —— exec 之后这个进程就不存在了，再打就没机会了。
  [ "$detach" = 1 ] && printf 'ccm-session=%s\n' "$tmux_name"
  exec bash -c "$seq"
fi

# ===== 非容器路径：在**本进程**里设好环境，然后 exec =====
# 到这里就是最终 shell。`exec` 之后不再多一层 shell —— 理由见头注第 2 条
#（⚠ 那条在 `U-NP④` 换过：不再是「PID 对不上」）。

# --print：吐出等价的一行 shell（供 cc-monitor 等价断言 / 调试）。
if [ "$do_print" = 1 ]; then
  line=""
  [ -n "$CCM_ENV" ] && line="$line$CCM_ENV; "
  # 顺序与下面真 exec 那条路逐条对齐（CCM_ENV → CC_BUS_ID → 会话级 env → cd → exec）。
  # **输出的是配方不是值** —— 见 `BUS_ID_RECIPE` 头注：这样 `--print` 仍然不查实时 tmux 状态。
  agent_needs_bus_id "$agent" && line="$line$BUS_ID_RECIPE "
  [ -n "$config_dir" ] && line="${line}export CLAUDE_CONFIG_DIR=$(sq "$config_dir"); "
  [ "$use_base" = 1 ] && line="${line}unset CLAUDE_CONFIG_DIR; "
  [ -n "$model" ] && line="${line}export ANTHROPIC_MODEL=$(sq "$model"); "
  [ -n "$nested" ] && line="${line}unset $nested; "
  [ -n "$cwd" ] && line="${line}cd $(sq "$cwd") && "
  # 本地那条（今天的行为）先拼好 —— 它同时是配方里的兜底分支。
  local_exec="exec"
  for a in "${argv[@]}"; do local_exec="$local_exec $(qarg "$a")"; done
  if [ "$action" = resume ] && [ "$launcher_explicit" = 0 ]; then
    # F10：透传参数单独 quote 成一串，喂给配方（空则为空串，配方逐字与从前相同）。
    pt=""
    if [ ${#passthru[@]} -gt 0 ]; then
      for a in "${passthru[@]}"; do pt="$pt $(qarg "$a")"; done
    fi
    line="$line$(resolve_recipe "$sid" "$local_exec" "$pt")"
  else
    line="$line$local_exec"
  fi
  printf '%s\n' "$line"
  exit 0
fi

# 机器级 env（代理等）——旧 `eval "$CC_ENV"` 的搬家，语义不变。
[ -n "$CCM_ENV" ] && eval "$CCM_ENV"
# cc-bus 身份：codex 沙箱够不着 tmux socket，须把会话名经 env 透进去（见 agent_needs_bus_id）。
# **必须无条件覆盖，不能写成 `${CC_BUS_ID:-…}`**（B02 审计重要-3，有可复现反例）：
# `:-` 是"缺省"，pane 环境里已有 `CC_BUS_ID` 就会沿用——而 tmux server 的全局环境继承自
# 起它的那个客户端，父 agent 的 `CC_BUS_ID` 会漏进来。cc-spawn 收编前用的是 send-keys 的
# `CC_BUS_ID=<name> ` env 前缀，那是**永远覆盖**。语义差别的后果不只是 `FROM` 写错：
# `cc-whoami:10` 把 `$CC_BUS_ID` 排在最高优先级，子 agent 的 Stop 钩子会去读**父 agent 的
# inbox**——身份冒用 + 抢信。会话名是这个会话身份的唯一事实来源，继承来的值一律不作数。
_sname="$(derive_bus_id "$agent")"   # ← 与 `--print` 共用同一处派生（见 derive_bus_id 头注）
[ -n "$_sname" ] && export CC_BUS_ID="$_sname"
unset _sname
# 会话级 env。--base 显式清残留（就地复用已存在 shell 时必需，见 issue #75）。
[ -n "$config_dir" ] && export CLAUDE_CONFIG_DIR="$config_dir"
[ "$use_base" = 1 ] && unset CLAUDE_CONFIG_DIR
[ -n "$model" ] && export ANTHROPIC_MODEL="$model"
# 嵌套会话标记：tmux server env 可能带毒（issue #24），起前一律清。
[ -n "$nested" ] && unset $nested
[ -n "$cwd" ] && { cd "$cwd" || die "无法进入目录: $cwd"; }

# ===== L5 身份 =====
#
# ★★ `U-NP④`（08-14）：**通道 B 整条搬去 daemon，ccm 这边一条轮询都不留。**
#
# 这里原先有一段**每会话一条、与会话同寿、每秒醒一次**的后台循环：读
# `<config_dir>/sessions/$$.json` 拿 `sessionId`，写 `@ccm_sid` + 打窗口标题。
# 它是全仓唯一那种形态的轮询，且跑在**远端**机器上（开五个会话就是五条）。
# 用户裁定逐字：「**可以动ccm. 不要轮询**」＋「**ccm做到必须走daemon**」。
#
# ## 新的分工（两通道**没有**被合并掉）
#
#   · 通道 A（**意图**，下面这一格）：ccm 自己写 `@ccm_sid_expect` —— 「打算跑这个 sid」。
#     resume 可能瞬间失败（会话已不存在/网络抖动），所以它**不算事实**。
#   · 通道 B（**事实**）：`@ccm_sid` 由 **daemon** 写（`control/identity_tag.rs`）。
#     它在 inotify `<claude_dir>/sessions/` 上看到 `<PID>.json` 时 pid 与 sid 同时在手，
#     再用 `/proc/<pid>/environ` 的 `TMUX_PANE` 定位到该打哪个 tmux 会话。
#     `/clear`、`/branch` 原地换 sid ⇒ pidfile 被重写 ⇒ inotify modify ⇒ 它跟着重打。
#   · 破坏性动作（kill 等）**仍然只认 `@ccm_sid`**，一个字没放宽。
#     事实的写者反而更硬了：从「那个会话自己」变成**独立第三方**，且 daemon 打标前
#     已经过了 pidfile 的 `procStart` 冒名检查。
#
# ## 为什么不是别的路（这两条已被排除，别重新发明）
#
#   · ❌ ccm 自己上 `inotifywait`：破「纯 POSIX shell、零第三方」，而本文件经
#     `sftp.rs` 的 `include_str!` 部署到**任意远端**，装没装只有运行时才知道
#     ⇒ 还得留一条轮询退路，那就等于没删。
#   · ❌ 「拿到 sid 就退出循环」：**安全回归** —— `/clear` 与 `/branch` 会**原地换 sid**，
#     陈旧的 `@ccm_sid` 会让 kill **杀错会话**。
#
# ## 窗口标题（`ccm-rbind-<sid>`）谁来兜
#
# 不需要人兜，见下面 `set-titles-string` 那段：标题由 **tmux 自己从 `@ccm_sid` 合成**，
# 与 claude 抢着写的 pane 标题彻底分开 ⇒ marker 常驻。08-14 私有 socket + 真 pty client
# 实测：**外部**进程执行 `set-option @ccm_sid <sid>` 之后，tmux 立刻往 client 推
# `ESC ]0;ccm-rbind-<sid> BEL` —— 打标者是不是这个会话自己无关紧要。
# 旧循环里那句「每 20 秒重打一次自愈」在这条 format 落地之后已是余物，随它一起删。
#
# ⚠ **如实登记的代价**：不在 tmux 里跑（裸 `ccm`，没有 `--tmux`）时，旧循环是靠
# `printf '\033]0;ccm-rbind-%s\007'` 直接写终端标题的 —— 那条路**没了**，
# 因为 `@ccm_sid` 是 tmux 会话级 option，没有 tmux 就没有地方放身份。下面会为此说一句话。

# 通道A：已知 sid（cc-monitor 传的）→ 立刻打标**意图**（@ccm_sid_expect，非 @ccm_sid）。
if [ -n "$ccm_sid" ] && [ -n "${TMUX:-}" ]; then
  tmux set-option @ccm_sid_expect "$ccm_sid" >/dev/null 2>&1 || true
fi
# 通道B：交给 daemon。ccm 这边只做两件事——**前置检查**（没有 daemon 就响亮失败）
# 与**让 tmux 自己合成窗口标题**。
if agent_has_identity "$agent"; then
  # ★★ **前置检查排在所有 tmux 调用之前**，这个顺序是判据的一部分：
  #    失败路径上一条 tmux 命令都不该起（`e2e` 里那几条正是在没有 tmux 的 PATH 下跑的）。
  #
  # 查找规则**只有一份**（`DAEMON_BIN_RECIPE`，与 `resume` 那条共用）——
  # 顺序 `$CCM_DAEMON_BIN` → `~/.cc-monitor/bin/cc-monitor-remote` → PATH。
  #
  # ⚠ **如实边界**：它证明的是「这台机器上有那个二进制」，**不是**「此刻真有一个 daemon
  #   在跑、并且正在 watch 这个 `CLAUDE_CONFIG_DIR`」。后者今天没有便宜的问法
  #   （一次性子命令是**新起一个进程**，答不了「有没有长驻的那个」）。
  #   ⇒ 本检查挡住的是最常见的那一格（根本没部署），别把它读成更强的保证。
  if [ -n "${TMUX:-}" ]; then
    eval "$DAEMON_BIN_RECIPE"
    if [ -n "$_ccm_db" ]; then
      :
    elif [ "${CCM_NO_DAEMON:-}" = 1 ]; then
      # 明示放弃身份的逃生口。**照样说一句** —— 静默降级正是本条要根除的东西。
      printf 'ccm: CCM_NO_DAEMON=1 ⇒ 本会话不会被打上 @ccm_sid（身份归 daemon）。cc-monitor 里它绑不上窗口、点 ↗ 会说未绑定。\n' >&2
    else
      die "找不到 daemon（cc-monitor-remote），而身份（@ccm_sid）自 U-NP④ 起**只**由它打。
     没有它：会话照样能起，但 cc-monitor 认不出这个 tmux 会话 —— 列表里绑不上、
     点 ↗ 弹「未绑定窗口」、结束会话按不动，**而且没有任何地方会告诉你为什么**。
     查找顺序：\$CCM_DAEMON_BIN → ~/.cc-monitor/bin/cc-monitor-remote → PATH 上的 cc-monitor-remote。
     怎么办（三选一）：① 在 cc-monitor 里对这台机器跑一次部署（会把 daemon 装到第二个位置）；
     ② 有二进制就 export CCM_DAEMON_BIN=<它的路径>；③ 明确不要身份：CCM_NO_DAEMON=1 ccm …"
    fi
    unset _ccm_db
  else
    # 不在 tmux 里 ⇒ **没有任何地方可以放身份**（`@ccm_sid` 是 tmux 会话级 option）。
    # 这不是「没装 daemon」，装了也一样 ⇒ 不拦，但也不闷声（旧版这里有窗口标题，已随轮询删）。
    printf 'ccm: 不在 tmux 里 ⇒ 本会话没有 @ccm_sid、也不写 ccm-rbind 窗口标题（身份归 daemon，而 daemon 只能打在 tmux 会话上）。要身份就加 --tmux。\n' >&2
  fi
  if [ -n "${TMUX:-}" ]; then
    tmux set-option set-titles on >/dev/null 2>&1 || true
    # ★ 窗口标题**由 tmux 自己合成**，不再等于 pane 标题（`#T`）。
    #
    # 为什么改：monitor 靠扫 Windows 窗口标题里的 `ccm-rbind-<sid>` 来绑窗口，
    # 而 **claude 也在往 pane 标题写自己的状态**（转圈图标 + 当前在干什么）。
    # 用 `#T` 时两者抢同一个位置，claude 一忙就把 marker 冲掉；当年那条循环
    # 每 20 秒才补一次 ⇒ **点 ↗ 时的 4 秒现扫窗口去撞 20 秒一次的脉冲，约 1/5 命中**。
    # 真机实测（2026-07-31）：四个空闲会话 marker 都在、唯独忙碌那个被冲成
    # 「⠐ 理解…」，点 ↗ 必弹「未绑定窗口」。
    #
    # 换成从 `@ccm_sid` 直接合成之后，marker **常驻**：claude 写的是 pane 标题，
    # 而窗口标题走的是这条 format，两条路不再交叉。首次绑定不再看运气。
    #（`bind.rs` 那句「4s 若仍偶发不足，据真机再抬」是在症状层调参——抬窗口只能提高
    #  命中率，抬到 20s 才保证，而那样点一次要等 20 秒。根因在这里。）
    #
    # ★ `U-NP④` 复核：**正是这条 format 让「谁来打标」与「标题对不对」解耦** ——
    #   标题由 tmux 按 `@ccm_sid` 现算，daemon 在外面写一次值，tmux 就会把新标题推给
    #   attach 着的 client（08-14 真 pty 实测）。所以那条「每 20 秒重打」的自愈随轮询一起删，
    #   不留残肢。
    #
    # `#{?@ccm_sid,…,#T}`：sid 还没回填时回退 `#T`，不产出一个空的 `ccm-rbind-`。
    tmux set-option set-titles-string '#{?@ccm_sid,ccm-rbind-#{@ccm_sid},#T}' >/dev/null 2>&1 || true
  fi
fi

# C4：resume 的 argv 向 daemon 要（拿不到就走本地那条）。
# ⚠ 与 `resolve_recipe` 逐行同构 —— A′ 组差分负责它们不许分家。
if [ "$action" = resume ] && [ "$launcher_explicit" = 0 ]; then
  _ccm_c="$(resolve_from_daemon "$sid")"
  # 故意不加引号：daemon 给的是一条**命令串**，要按词拆成 argv（C4 的「拿 argv」）。
  # ⚠⚠ audit-0805 F10 / 报告 I-11：**`--` 之后的透传参数必须补回去**。
  #    daemon 的 `--resolve` 只收 `{"sessionId":...}`（协议里根本没有 passthru 这个字段），
  #    所以它给的串里**不可能**带用户那些参数；而这里 `exec $_ccm_c` 是**整条换掉 argv**
  #    ⇒ `ccm resume <sid> -- --xxx` 在**装了 daemon 时丢参数、没装时不丢**。
  #    实测（fake daemon）：传进去的 flag 直接消失。
  # ★★ **`set -f` 不能省**〔08-13 实测〕：`exec $_ccm_c` 的不 quote 展开要的是**分词**，
  #    但它同时会做**路径名展开** —— 实测 daemon 回 `echo GLOB *`、cwd 里有 `aaa`/`bbb`
  #    ⇒ 真的跑成了 `echo GLOB aaa bbb`。也就是说 **daemon 给的命令会被当前目录的文件名改写**。
  #    `set -f` 只关 glob，分词照旧 ⇒ 拿到的正是我们要的那一半。
  #
  # ★ 而**注入面是干净的**，这条要钉住别被「优化」掉：`exec` 只分词、**不解释元字符** ——
  #   实测 daemon 回 `echo hi; touch <标记>`，跑出来是 `echo` 带三个字面参数，
  #   标记文件**没有生成**。⇒ **绝不许把这里改成 `eval`**（那会让 `;` 真的变成分隔符，
  #   而 daemon 可能是 PATH 上捡到的第三方二进制，见 `DAEMON_BIN_RECIPE` 的查找次序）。
  # shellcheck disable=SC2086
  if [ -n "$_ccm_c" ]; then
    set -f
    if [ ${#passthru[@]} -gt 0 ]; then exec $_ccm_c "${passthru[@]}"; else exec $_ccm_c; fi
  fi
fi
exec "${argv[@]}"

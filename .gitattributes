# 统一行尾：仓库与工作树都用 LF，消除 Windows 上每次 commit 的
# "LF will be replaced by CRLF the next time Git touches it" 警告。
# 源码（rs / ts / js / css / html / json / md / toml / yml…）全部 text=auto + eol=lf。
* text=auto eol=lf

# Windows 批处理脚本若存在，必须 CRLF（否则部分 cmd.exe 解析异常）。PowerShell .ps1 用 LF 没问题。
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制资源：不做行尾转换、不当文本 diff。
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.icns  binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.exe   binary
*.msi   binary
*.dll   binary

# C01（rust-ts-boundary）：ts-rs 生成物，diff 默认折叠。源是 src-tauri/src/**.rs 的
# #[cfg_attr(test, derive(ts_rs::TS))]，重新生成走 `npm run gen:types`。
#
# **不要在这里写「改了会被守卫抓到」——那是假保证**（Phase D 审计 B2 实测：手改生成物、
# 甚至插一个 Rust 侧根本不存在的字段，5 条守卫 + tsc **全绿**）。
# 手改**目前只靠人工纪律**；真正的检查是 C05 的「重新生成 + git diff --exit-code」，尚未落地。
src/generated/** linguist-generated=true

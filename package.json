{
  "name": "cc-monitor",
  "private": true,
  "version": "3.0.0",
  "description": "cc-monitor — Claude Code CLI 的只读输出渲染窗口（Tauri 2 + TypeScript，Windows）",
  "license": "MIT",
  "author": "cc-monitor contributors",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:diff": "node src/cards/diff.test.ts",
    "test:branching": "node src/branching.test.ts",
    "test:api-error": "node src/cards/api-error.test.ts",
    "test:bash": "node src/cards/bash.test.ts",
    "test:remote-health": "node src/remote-health.test.ts",
    "test:remote-launch": "node src/remote-launch.test.ts",
    "test:format": "node src/format.test.ts",
    "test:history-cache": "node src/views/history-cache.test.ts",
    "test:history-prefs": "node src/views/history-prefs.test.ts",
    "test:history-actions": "node src/views/history-actions.test.ts",
    "test:usage-pivot": "node src/views/usage-pivot.test.ts",
    "test:pricing": "node src/views/pricing.test.ts",
    "test:dom": "vitest run",
    "test": "npm run test:branching && npm run test:diff && npm run test:api-error && npm run test:bash && npm run test:remote-health && npm run test:remote-launch && npm run test:format && npm run test:history-cache && npm run test:history-prefs && npm run test:history-actions && npm run test:usage-pivot && npm run test:pricing && npm run test:dom"
  },
  "dependencies": {
    "@chenglou/pretext": "0.0.8",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "dompurify": "^3.4.5",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.47",
    "marked": "^18.0.3",
    "marked-katex-extension": "^5.1.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "jsdom": "^29.1.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.9"
  }
}

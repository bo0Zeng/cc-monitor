{
  "name": "cc-monitor",
  "private": true,
  "version": "3.3.0",
  "description": "cc-monitor — Claude Code CLI 的只读输出渲染窗口（Tauri 2 + TypeScript，Windows）",
  "license": "MIT",
  "author": "cc-monitor contributors",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:diff": "tsx src/cards/diff.test.ts",
    "test:branching": "tsx src/branching.test.ts",
    "test:api-error": "tsx src/cards/api-error.test.ts",
    "test:bash": "tsx src/cards/bash.test.ts",
    "test:remote-health": "tsx src/remote-health.test.ts",
    "test:remote-launch": "tsx src/remote-launch.test.ts",
    "test:format": "tsx src/format.test.ts",
    "test:history-cache": "tsx src/views/history-cache.test.ts",
    "test:history-prefs": "tsx src/views/history-prefs.test.ts",
    "test:history-actions": "tsx src/views/history-actions.test.ts",
    "test:usage-pivot": "tsx src/views/usage-pivot.test.ts",
    "test:pricing": "tsx src/views/pricing.test.ts",
    "test:session-backend": "tsx src/session-backend.test.ts",
    "test:panorama-session-files": "tsx src/panorama/session-files.test.ts",
    "test:dom": "vitest run",
    "lint": "eslint src",
    "lint:css": "stylelint \"src/**/*.css\"",
    "coverage": "vitest run --coverage",
    "test": "npm run test:branching && npm run test:diff && npm run test:api-error && npm run test:bash && npm run test:remote-health && npm run test:remote-launch && npm run test:format && npm run test:history-cache && npm run test:history-prefs && npm run test:history-actions && npm run test:usage-pivot && npm run test:pricing && npm run test:session-backend && npm run test:panorama-session-files && npm run test:dom"
  },
  "dependencies": {
    "@chenglou/pretext": "0.0.8",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "dompurify": "^3.4.5",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.47",
    "marked": "^18.0.3",
    "marked-katex-extension": "^5.1.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2",
    "@vitest/coverage-v8": "^4.1.10",
    "@wdio/cli": "^9",
    "@wdio/local-runner": "^9",
    "@wdio/mocha-framework": "^9",
    "@wdio/spec-reporter": "^9",
    "webdriverio": "^9",
    "eslint": "^9.39.5",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.3",
    "vitest": "^4.1.9"
  }
}

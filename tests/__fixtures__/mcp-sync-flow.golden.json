{
  "说明": [
    "〔MIG-3a〕MCP 推 / 拉三问的跨语言金样：后端对临时目录现算 == reply；界面 `src/mcp-sync-reads.ts` 读同一份。",
    "只采结构（占位 server 名 / 占位命令）。`<SRC>` / `<DST>` 由测试换成临时目录下的真路径。"
  ],
  "sourceText": "{\"mcpServers\":{\"a\":{\"command\":\"a\"},\"b\":{\"command\":\"b2\"}}}",
  "targetText": "{\"mcpServers\":{\"b\":{\"command\":\"b1\"},\"c\":{\"command\":\"c\"}}}",
  "sourceReply": { "path": "<SRC>/.mcp.json", "text": "{\"mcpServers\":{\"a\":{\"command\":\"a\"},\"b\":{\"command\":\"b2\"}}}" },
  "previewReply": {
    "sourcePath": "<SRC>/.mcp.json",
    "targetPath": "<DST>/.mcp.json",
    "sourceText": "{\"mcpServers\":{\"a\":{\"command\":\"a\"},\"b\":{\"command\":\"b2\"}}}",
    "targetText": "{\"mcpServers\":{\"b\":{\"command\":\"b1\"},\"c\":{\"command\":\"c\"}}}",
    "rows": [
      { "name": "a", "state": "new", "suspects": [{ "kind": "command-missing", "field": "command", "value": "a", "there": "unknown" }], "source": { "command": "a" }, "target": null },
      { "name": "b", "state": "differs", "suspects": [{ "kind": "command-missing", "field": "command", "value": "b2", "there": "unknown" }], "source": { "command": "b2" }, "target": { "command": "b1" } },
      { "name": "c", "state": "only-there", "suspects": [], "source": null, "target": { "command": "c" } }
    ]
  },
  "take": ["a", "b"],
  "overwrite": ["b"],
  "applyReply": { "path": "<DST>/.mcp.json", "written": true, "names": ["a", "b"] },
  "codes": {
    "mcp-sync-source": ["bad_args", "bad_path", "missing", "refused"],
    "mcp-sync-preview": ["bad_args", "bad_file", "bad_path", "refused"],
    "mcp-sync-apply": ["bad_args", "bad_file", "bad_path", "needs_consent", "refused", "stale"]
  }
}

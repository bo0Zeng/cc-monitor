  "terminal-input": {
    "requests": [
      {
        "terminal": "tmux-1",
        "text": "/usage",
        "enter": true,
        "seen_screen": "0000000000000000",
        "client": "mobile"
      },
      {
        "sid": "sid-a",
        "key": "esc"
      }
    ],
    "replies": [
      {
        "result": "delivered"
      },
      {
        "result": "refused",
        "why": "screen-changed",
        "screen": "0000000000000000"
      },
      {
        "result": "unsure"
